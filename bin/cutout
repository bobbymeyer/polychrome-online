#!/usr/bin/env bash
# The background remover (Cutout, config/cutout.yml, README "Background
# removal"): rembg's HTTP server, the standalone tool that runs the removal
# models (ISNet, BiRefNet, BRIA RMBG, U²-Net) behind one API.
#
#   bin/cutout            install if need be, fetch the model, serve on port 7000, warm it up
#   bin/cutout install    the Python environment (tmp/cutout) and the model, nothing more
#   bin/cutout check      send a picture through whatever answers at CUTOUT_URL and report
#
# In Docker when there is one (the danielgatis/rembg image), else in a Python
# environment of its own under tmp/. Then point the app at it:
# CUTOUT_URL=http://127.0.0.1:7000 (from the app's container,
# http://host.docker.internal:7000), or the address on the Settings page;
# bin/dev starts it by itself when CUTOUT_URL names this machine.
#
#   CUTOUT_PORT    7000
#   CUTOUT_MODEL   isnet-anime (config/cutout.yml's default): fetched before the
#                  server starts, so the first picture isn't a download. ISNet
#                  models are ~170 MB and run in ~2 GB of RAM in a few seconds on a
#                  CPU; birefnet-general is ~1 GB and wants a GPU, or 16 GB+ of RAM
#                  and a minute a picture without one.
#   CUTOUT_MODELS  where models are kept (~/.rembg); U2NET_HOME still wins if set
#   CUTOUT_GPU     1 to install the CUDA build of onnxruntime (default: when nvidia-smi is found)
#   PYTHON         the interpreter to make the environment from (python3)
set -euo pipefail
cd "$(dirname "$0")/.."
PORT="${CUTOUT_PORT:-7000}"
MODEL="${CUTOUT_MODEL:-isnet-anime}"
MODELS="${CUTOUT_MODELS:-${U2NET_HOME:-$HOME/.rembg}}"
URL="${CUTOUT_URL:-http://127.0.0.1:$PORT}"
VENV="tmp/cutout"
REMBG_VERSION="2.0.85"
command="${1:-serve}"

say() { printf '== %s ==\n' "$*"; }

have_docker() { command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; }

want_gpu() {
  case "${CUTOUT_GPU:-}" in
    1|true|yes) return 0 ;;
    0|false|no) return 1 ;;
  esac
  command -v nvidia-smi >/dev/null 2>&1
}

install_venv() {
  PY="${PYTHON:-python3}"
  if [ ! -x "$VENV/bin/rembg" ]; then
    say "Installing rembg $REMBG_VERSION into $VENV (once)"
    "$PY" -m venv "$VENV"
    "$VENV/bin/pip" install --quiet --no-compile --upgrade pip
    if want_gpu; then
      "$VENV/bin/pip" install --quiet --no-compile "rembg[cli]==$REMBG_VERSION" onnxruntime-gpu
    else
      "$VENV/bin/pip" install --quiet --no-compile "rembg[cli]==$REMBG_VERSION" onnxruntime
    fi
  fi
  say "rembg $("$VENV/bin/rembg" --version | awk '{print $NF}') in $VENV"
}

fetch_model() {
  if [ -s "$MODELS/models/$MODEL/$MODEL.onnx" ] || [ -s "$MODELS/$MODEL.onnx" ]; then
    say "Model $MODEL is here ($MODELS)"
  else
    say "Fetching the model $MODEL into $MODELS"
    if have_docker; then
      docker run --rm -v "$MODELS:/root/.rembg" -v "$MODELS:/root/.u2net" danielgatis/rembg d "$MODEL"
    else
      U2NET_HOME="$MODELS" "$VENV/bin/rembg" d "$MODEL"
    fi
  fi
}

# A picture to send through: a figure on a green ground with white inside it,
# as the pipeline renders them, or a 1×1 PNG when there is no Python to draw one.
probe_image() {
  local out="$1"
  if [ -x "$VENV/bin/python" ]; then
    "$VENV/bin/python" - "$out" <<'PY'
import sys
from PIL import Image, ImageDraw
im = Image.new("RGB", (320, 480), (40, 200, 60))
d = ImageDraw.Draw(im)
d.rectangle([100, 150, 220, 450], fill=(190, 40, 50))
d.rectangle([130, 220, 190, 300], fill=(255, 255, 255))
d.ellipse([120, 70, 200, 150], fill=(240, 200, 170))
im.save(sys.argv[1])
PY
  else
    printf '\x89PNG\r\n\x1a\n\x00\x00\x00\x0dIHDR\x00\x00\x00\x01\x00\x00\x00\x01\x08\x06\x00\x00\x00\x1f\x15\xc4\x89\x00\x00\x00\x0dIDAT\x78\x9c\x63\x60\x60\x60\xf8\x0f\x00\x01\x04\x01\x00\x5b\x7b\xa8\x33\x00\x00\x00\x00IEND\xae\x42\x60\x82' > "$out"
  fi
}

check() {
  local dir in out code started
  dir="$(mktemp -d)"; in="$dir/in.png"; out="$dir/out.png"
  probe_image "$in"
  say "Sending a picture to $URL/api/remove with the model $MODEL"
  started=$(date +%s)
  code=$(curl -sS -o "$out" -w '%{http_code}' --max-time 600 -F "file=@$in;type=image/png" -F "model=$MODEL" "$URL/api/remove" || true)
  if [ "$code" != "200" ]; then
    echo "The background remover answered $code: $(head -c 200 "$out" 2>/dev/null)"; rm -rf "$dir"; exit 1
  fi
  if head -c 4 "$out" | grep -q PNG && [ "$(head -c 26 "$out" | tail -c 1 | od -An -tu1 | tr -d ' ')" = "6" ]; then
    echo "OK: a PNG with transparency came back in $(( $(date +%s) - started ))s ($(wc -c < "$out") bytes). Point the app at it: CUTOUT_URL=$URL CUTOUT_MODEL=$MODEL"
  else
    echo "It answered, but not with a transparent PNG: check the model name ($MODEL) and the service's logs."; rm -rf "$dir"; exit 1
  fi
  rm -rf "$dir"
}

wait_for() {
  local tries=0
  until curl -sf -o /dev/null "http://127.0.0.1:$PORT/api"; do
    tries=$((tries + 1)); [ "$tries" -gt 120 ] && { echo "The server didn't come up on port $PORT"; exit 1; }
    sleep 1
  done
}

serve() {
  if have_docker; then
    say "rembg in Docker, on port $PORT (danielgatis/rembg), models in $MODELS"
    fetch_model
    docker run --rm -p "$PORT:7000" -v "$MODELS:/root/.rembg" -v "$MODELS:/root/.u2net" danielgatis/rembg s --host 0.0.0.0 --port 7000 &
  else
    install_venv
    fetch_model
    say "rembg on port $PORT, models in $MODELS"
    U2NET_HOME="$MODELS" "$VENV/bin/rembg" s --host 0.0.0.0 --port "$PORT" --no-ui &
  fi
  server=$!
  trap 'kill "$server" 2>/dev/null; wait "$server" 2>/dev/null; exit 0' INT TERM
  wait_for
  # Load the model now, not on the first picture someone is waiting for.
  URL="http://127.0.0.1:$PORT" check || true
  say "Ready. CUTOUT_URL=http://127.0.0.1:$PORT (or http://host.docker.internal:$PORT from the app's container), CUTOUT_MODEL=$MODEL"
  wait "$server"
}

case "$command" in
  serve) serve ;;
  install) if have_docker; then docker pull danielgatis/rembg; else install_venv; fi; fetch_model ;;
  check) check ;;
  *) echo "usage: bin/cutout [serve|install|check]"; exit 2 ;;
esac
