<header class="book-page__header">
  <%= entry_portrait(entry) %>
  <div>
    <p class="eyebrow">Grimoire · <%= term(entry.kind) %></p>
    <h1><%= entry.name %></h1>
    <dl class="facts">
      <% if entry.field? %>
        <dt><%= gloss(:skill, "Skill") %></dt><dd><%= @world.skill_name(entry.field_skill) %>, usually <%= entry.field_difficulty %></dd>
        <dt>On a success</dt><dd><%= FieldUse.describe(entry) %></dd>
        <dt>Uses</dt><dd>Once per rest, outside battle</dd>
      <% else %>
      <dt>Target</dt><dd><%= term(entry.target) %></dd>
      <dt>Cost</dt><dd><%= [ ("#{entry.mp_cost} MP" if entry.mp_cost.positive?), ("#{entry.hp_cost}% of max HP" if entry.hp_cost.positive?) ].compact.join(" and ").presence || "Free" %></dd>
      <% if entry.charge.positive? %><dt>Charge</dt><dd><%= pluralize(entry.charge, "turn") %> to go off</dd><% end %>
      <% if entry.gesture.present? %><dt>Gesture</dt><dd><%= term(entry.gesture) %></dd><% end %>
      <% end %>
    </dl>
  </div>
</header>

<% if entry.description.present? %>
  <div class="prose"><%= simple_format(entry.description) %></div>
<% end %>

<% unless entry.field? %>
<section class="window">
  <h2>Effects</h2>
  <ol class="effects">
    <% entry.effects.each do |effect| %>
      <li><%= describe_effect(effect) %></li>
    <% end %>
  </ol>
</section>
<% end %>

<section class="window">
  <h2>Cross-references</h2>
  <% levels = entry.job_levels.includes(:job).order(:level) %>
  <% monsters = entry.monsters_using %>
  <% if levels.empty? && monsters.empty? %>
    <p class="empty">Nothing in this world uses <%= entry.name %> yet.</p>
  <% end %>
  <% if levels.any? %>
    <h3>Taught by</h3>
    <ul class="refs">
      <% levels.each do |level| %>
        <li><%= link_to level.job.name, world_compendium_job_path(@world, level.job) %> at job level <%= level.level %>, mastered at <%= level.mastered_at %></li>
      <% end %>
    </ul>
  <% end %>
  <% if monsters.any? %>
    <h3>Used by</h3>
    <ul class="refs">
      <% monsters.each do |monster| %>
        <li><%= link_to monster.name, world_bestiary_monster_path(@world, monster) %></li>
      <% end %>
    </ul>
  <% end %>
</section>
