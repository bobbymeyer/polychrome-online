<%= form_with model: entry, url: entry.persisted? ? entry_path(entry) : entries_path, class: "book-form" do |f| %>
  <%= render "book_entries/errors", entry: entry %>
  <%= render "book_entries/identity_fields", f: f %>
  <div class="field-row">
    <div class="field">
      <%= f.label :kind %>
      <%= f.select :kind, Ability::KINDS.map { |k| [term(k), k] } %>
      <p class="hint">Magic is blocked by Silence. Field is for outside battle: an archetype's field ability, below.</p>
    </div>
    <div class="field">
      <%= f.label :target %>
      <%= f.select :target, Battle::TARGETINGS.map { |t| [term(t), t] }, include_blank: true %>
    </div>
    <div class="field">
      <%= f.label :mp_cost, "MP cost" %>
      <%= f.number_field :mp_cost, min: 0 %>
    </div>
    <div class="field">
      <%= f.label :hp_cost, "HP cost (% of max)" %>
      <%= f.number_field :hp_cost, min: 0, max: Battle::MAX_HP_COST %>
      <p class="hint">Paid in the user's own HP. Nobody can spend their last.</p>
    </div>
    <div class="field">
      <%= f.label :charge, "Charge (turns)" %>
      <%= f.number_field :charge, min: 0, max: Battle::MAX_CHARGE %>
      <p class="hint">Turns it takes to go off. The user can't act meanwhile.</p>
    </div>
    <div class="field">
      <%= f.label :interrupt, "Interrupted by (% of HP)" %>
      <%= f.number_field :interrupt, min: 0, max: 100 %>
      <p class="hint">For a move with a charge: this much damage while it winds up breaks it, and stuns the user for a turn. 0: it can't be.</p>
    </div>
    <div class="field">
      <%= f.label :reload_turns, "Reload (turns)" %>
      <%= f.number_field :reload_turns, min: 0, max: Battle::MAX_RELOAD %>
      <p class="hint">Turns the user is spent for after it: a big shot.</p>
    </div>
    <div class="field field--check">
      <%= f.check_box :reach %>
      <%= f.label :reach, "Reach" %>
      <p class="hint">It finds foes off the field (leaping, hiding): a Ranger's shot.</p>
    </div>
    <div class="field field--check">
      <%= f.check_box :again %>
      <%= f.label :again, "Again" %>
      <p class="hint">The user goes again at once when it's done, once a round.</p>
    </div>
    <div class="field">
      <%= f.label :gesture %>
      <%= f.select :gesture, Ability::GESTURES.map { |g| [term(g), g] }, include_blank: "None" %>
    </div>
  </div>
  <fieldset class="panel">
    <legend>Outside battle (kind Field)</legend>
    <p class="hint">A check with a skill, asked for at the table and approved by the GM, once per rest. On a success, the outcome happens. Field abilities have no battle effects.</p>
    <div class="field-row">
      <div class="field"><%= f.label :field_skill, "Skill" %><%= f.select :field_skill, Array(@world.skills).map { |s| [ s["name"], s["slug"] ] }, include_blank: true %></div>
      <div class="field"><%= f.label :field_outcome, "On a success" %><%= f.select :field_outcome, FieldUse::OUTCOMES.map { |k, v| [ "#{k.humanize}: #{v}", k ] }, include_blank: true %></div>
      <div class="field"><%= f.label :field_difficulty, "Usual difficulty" %><%= f.select :field_difficulty, Stats::Check::DIFFICULTIES.keys.map { |d| [ d.capitalize, d ] } %></div>
      <div class="field">
        <%= f.label :field_power, "Power" %><%= f.number_field :field_power, min: 0 %>
        <p class="hint">Find: the most an item can be worth. Restore: the % of HP and MP back.</p>
      </div>
    </div>
  </fieldset>
  <%= render "book_entries/effect_rows", f: f %>
  <%= render "book_entries/art_fields", f: f %>
  <div class="actions">
    <%= f.submit class: "button" %>
    <%= link_to "Cancel", entry.persisted? ? entry_path(entry) : entries_path, class: "button button--quiet" %>
  </div>
<% end %>
