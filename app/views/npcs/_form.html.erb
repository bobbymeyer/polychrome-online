<%= form_with model: npc, url: npc.persisted? ? npc_path(npc) : campaign_npcs_path(@campaign), class: "book-form", multipart: true do |f| %>
  <%= render "book_entries/errors", entry: npc %>
  <div class="field-row">
    <div class="field"><%= f.label :name %><%= f.text_field :name, required: true %></div>
    <div class="field"><%= f.label :title %><%= f.text_field :title, placeholder: "Innkeeper, Captain of the Guard…" %></div>
    <div class="field"><%= f.label :colour, "Colour (until they have a portrait)" %><%= f.select :colour, colour_options(f.object.colour) %></div>
  </div>
  <div class="field">
    <%= f.label :monster_id, "Fights as" %>
    <%= f.select :monster_id, @campaign.world.monsters.order(:level, :name).map { |m| [ "#{m.name} (Lv #{m.level})", m.id ] }, include_blank: "Doesn't fight" %>
    <p class="hint">
      A recurring antagonist: they can join a battle under their own name and face, as a boss. If you send them off the field in battle,
      they get away and come back <%= Npc::GROWTH %>% stronger each time<%= " (#{npc.strength_percent}% now, after #{pluralize(npc.escapes, 'escape')})" if npc.escapes.positive? %>.
      Knocked out, they're finished<%= npc.defeated? ? ", as they are now" : "" %>.
    </p>
  </div>
  <% places = @campaign.locations.includes(:map_node).filter_map { |l| [ l.name, l.id ] }.sort %>
  <% if places.any? %>
    <div class="field">
      <%= f.label :location_id, "Where they are" %>
      <%= f.select :location_id, places, include_blank: "Nowhere in particular" %>
      <p class="hint">A town's people are listed there. An antagonist who gets away moves on from where they are, overnight.</p>
    </div>
  <% end %>
  <div class="field"><%= f.label :description, "Notes (GM only)" %><%= f.text_area :description, rows: 3 %></div>
  <%= render "portraits/fields", owner: npc %>
  <div class="actions">
    <%= f.submit class: "button" %>
    <%= link_to "Cancel", campaign_path(@campaign), class: "button button--quiet" %>
  </div>
<% end %>
