<% s = entry.settings %>
<header class="book-page__header">
  <%= entry_portrait(entry) %>
  <div>
    <p class="eyebrow">Gazetteer · <%= term(entry.kind) %></p>
    <h1><%= entry.name %></h1>
    <dl class="facts">
      <% if entry.town? %>
        <dt>Townsfolk</dt><dd><%= s["npcs"].join("–") %></dd>
        <dt>Buildings</dt><dd><%= s["buildings"].join("–") %></dd>
        <dt>Shop stock</dt><dd><%= s["stock"].join("–") %> items</dd>
      <% else %>
        <dt>Rooms</dt><dd><%= s["rooms"].join("–") %>, <%= pluralize(s["loops"], "loop") %></dd>
        <dt>Encounters</dt>
        <dd><%= entry.encounter_table ? link_to(entry.encounter_table.name, world_encounters_encounter_table_path(@world, entry.encounter_table)) : "None" %></dd>
        <% if s["boss"] %>
          <dt>Boss</dt><dd><%= s["boss"].map { |slug, n| "#{n} × #{@world.monsters.find_by(slug: slug)&.name || slug}" }.to_sentence %></dd>
        <% end %>
      <% end %>
    </dl>
  </div>
</header>

<% if entry.description.present? %><div class="prose"><%= simple_format(entry.description) %></div><% end %>

<section class="window">
  <h2>Chances</h2>
  <% if entry.town? %>
    <ul class="refs refs--inline">
      <% s["services"].each do |service, chance| %><li><%= service.humanize %>: <%= chance %>%</li><% end %>
    </ul>
  <% else %>
    <% total = s["decisions"].values.sum.nonzero? || 1 %>
    <ul class="refs refs--inline">
      <% s["decisions"].each do |decision, weight| %><li><%= decision.humanize %>: <%= (100.0 * weight / total).round %>%</li><% end %>
      <li>Boss: the deepest room</li>
    </ul>
  <% end %>
  <h3>Draws from</h3>
  <ul class="refs refs--inline">
    <% entry.generator_tables.order(:kind, :name).each do |table| %>
      <li><%= link_to table.name, world_generation_generator_table_path(@world, table) %> <span class="muted">(<%= table.kind.humanize.downcase %>)</span></li>
    <% end %>
  </ul>
</section>

<% missing = (entry.town? ? GeneratorTable::TOWN_KINDS : GeneratorTable::DUNGEON_KINDS) - entry.table_entries.keys %>
<% if missing.any? %>
  <p class="flash flash--alert" role="status">
    No <%= missing.map { |k| k.humanize.downcase }.to_sentence %> <%= missing.one? ? "table" : "tables" %> to draw from, so
    those come out as placeholders ("Stranger 1", "Nameless <%= entry.town? ? "Town" : "Depths" %>").
    <%= link_to "Add a generator table", new_world_generation_generator_table_path(@world) %>, or
    <%= link_to "tick one on this template", edit_world_gazetteer_location_template_path(@world, entry) %>.
  </p>
<% end %>

<% seed = (params[:seed] || 1).to_i %>
<% example = entry.town? ?
     Generators::Town.generate(seed: seed, template: s, tables: entry.table_entries) :
     Generators::Dungeon.generate(seed: seed, template: s, encounters: entry.encounter_table&.entries || [], tables: entry.table_entries) %>
<section class="window">
  <div class="book-header">
    <h2>Example: <%= example["name"] %></h2>
    <%= link_to "Another example", entry_path(entry) + "?seed=#{seed + 1}", class: "button button--quiet" %>
  </div>
  <% if entry.town? %>
    <%= render "locations/skyline", view: example %>
    <% item_names = @world.items.where(slug: example["stock"]).to_h { |i| [ i.slug, i.name ] } %>
    <div class="example-columns">
      <div>
        <h3>Services</h3>
        <ul class="refs"><% example["services"].each do |sv| %><li><%= sv["name"] %> <span class="muted"><%= sv["kind"] %></span></li><% end %></ul>
        <h3>For sale</h3>
        <p><%= example["stock"].any? ? example["stock"].map { |slug| item_names[slug] || slug }.to_sentence : "Nothing: no shop this time." %></p>
      </div>
      <div>
        <h3>People</h3>
        <ul class="refs">
          <% example["npcs"].each do |npc| %>
            <li><strong><%= npc["name"] %></strong> <span class="muted"><%= npc["title"] %></span><% if npc["hook"] %><br><%= npc["hook"] %><% end %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% else %>
    <%= render "locations/floorplan", view: example %>
    <p class="hint"><%= pluralize(example["rooms"].size, "room") %>, <%= pluralize(example["paths"].size, "path") %>.</p>
    <% monster_names = @world.monsters.to_h { |m| [ m.slug, m.name ] } %>
    <% item_names = @world.items.to_h { |i| [ i.slug, i.name ] } %>
    <ol class="refs example-rooms">
      <% example["rooms"].each do |room| %>
        <% d = room["decision"] %>
        <li><strong><%= room["name"] %></strong> <span class="muted"><%= d["kind"] %></span>:
          <%= case d["kind"]
              when "encounter", "boss" then d["monsters"].map { |slug, n| "#{n} × #{monster_names[slug] || slug}" }.to_sentence
              when "treasure" then d["gil"] ? "#{d['gil']} gil" : item_names[d["item"]] || d["item"]
              else d["text"]
              end %></li>
      <% end %>
    </ol>
    <%= render "locations/marker_legend" %>
  <% end %>
</section>
