<% content_for :title, "#{@world.name}: edit skills" %>
<div class="crumbs"><%= link_to @world.name, world_path(@world) %> / <%= link_to "Skills", world_skills_path(@world) %> / Edit</div>
<h1>Edit skills</h1>
<p class="prose">As many as the setting needs, and at least one. A removed skill comes off the archetypes that were good at it.</p>
<% stats = Stats::Check::STATS.map { |s| [ stat_label(s), s ] } %>
<%= form_with url: world_skills_path(@world), method: :patch, class: "book-form" do |f| %>
  <fieldset class="panel">
    <legend>Skills</legend>
    <table class="grid-form">
      <thead><tr><th>Name</th><th>Stat</th><th>What it covers</th><th>Remove</th></tr></thead>
      <tbody>
        <% skills = Array(@world.skills) %>
        <% (skills + Array.new(3) { {} }).each_with_index do |skill, i| %>
          <tr>
            <td>
              <%= hidden_field_tag "skills[#{i}][slug]", skill["slug"], id: nil if skill["slug"] %>
              <%= text_field_tag "skills[#{i}][name]", skill["name"], placeholder: ("New skill" unless skill["slug"]), "aria-label": "Skill #{i + 1} name" %>
            </td>
            <td><%= select_tag "skills[#{i}][stat]", options_for_select(stats, skill["stat"]), "aria-label": "Skill #{i + 1} stat" %></td>
            <td><%= text_field_tag "skills[#{i}][description]", skill["description"], "aria-label": "Skill #{i + 1} description" %></td>
            <td><% if skill["slug"] %><%= check_box_tag "skills[#{i}][remove]", "1", false, "aria-label": "Remove #{skill['name']}" %><% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </fieldset>
  <div class="actions">
    <%= f.submit "Save skills", class: "button" %>
    <%= link_to "Cancel", world_skills_path(@world), class: "button button--quiet" %>
  </div>
<% end %>
