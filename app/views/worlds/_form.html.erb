<%= form_with model: world, class: "book-form" do |f| %>
  <%= render "book_entries/errors", entry: world %>
  <div class="field-row">
    <div class="field"><%= f.label :name %><%= f.text_field :name, required: true %></div>
    <div class="field">
      <%= f.label :slug %>
      <% if world.persisted? %>
        <code class="slug"><%= world.slug %></code>
      <% else %>
        <%= f.text_field :slug, placeholder: "From the name" %>
      <% end %>
    </div>
  </div>
  <div class="field"><%= f.label :description %><%= f.text_area :description, rows: 4 %></div>
  <% if world.persisted? %>
    <fieldset class="panel">
      <legend>Voice</legend>
      <p class="hint">How the setting sounds. The language model writes in this voice when it drafts for you, and keeps clear of what you rule out.</p>
      <div class="field"><%= f.label :voice, "Tone and touchstones" %><%= f.text_area :voice, rows: 3, placeholder: "Wet noir with a kind heart. Dashiell Hammett by way of Studio Ghibli. Short sentences; people say less than they mean." %></div>
      <div class="field"><%= f.label :avoid, "Words and tropes to avoid" %><%= f.text_area :avoid, rows: 2, placeholder: "chosen ones, prophecies, 'ancient evil', elves" %></div>
    </fieldset>
    <fieldset class="panel words-fields">
      <legend>Words</legend>
      <p class="hint">The setting's names for the game's fixed things. The rules underneath stay the same; blank keeps the game's word.</p>
      <div class="field-row">
        <div class="field"><%= label_tag "world_terms_currency", "Money" %><%= text_field_tag "world[terms][currency]", world.terms["currency"], id: "world_terms_currency", placeholder: "gil", maxlength: 30 %></div>
        <div class="field"><%= label_tag "world_terms_hp", "HP" %><%= text_field_tag "world[terms][hp]", world.terms["hp"], id: "world_terms_hp", placeholder: "HP", maxlength: 30 %></div>
        <div class="field"><%= label_tag "world_terms_mp", "MP" %><%= text_field_tag "world[terms][mp]", world.terms["mp"], id: "world_terms_mp", placeholder: "MP", maxlength: 30 %></div>
      </div>
      <div class="field-row">
        <% World::Vocabulary::STATS.each do |stat| %>
          <div class="field"><%= label_tag "world_terms_stats_#{stat}", World::Vocabulary::DEFAULTS["stats"][stat] %><%= text_field_tag "world[terms][stats][#{stat}]", world.terms.dig("stats", stat), id: "world_terms_stats_#{stat}", placeholder: World::Vocabulary::DEFAULTS["stats"][stat], maxlength: 30 %></div>
        <% end %>
      </div>
      <fieldset class="field">
        <legend>Town services</legend>
        <div class="field-row">
          <% World::Vocabulary::SERVICES.each do |kind| %>
            <div class="field">
              <%= label_tag "world_terms_services_#{kind}", World::Vocabulary::DEFAULTS["services"][kind] %>
              <%= text_field_tag "world[terms][services][#{kind}]", world.terms.dig("services", kind), id: "world_terms_services_#{kind}", placeholder: World::Vocabulary::DEFAULTS["services"][kind], maxlength: 30 %>
              <label class="inline"><%= check_box_tag "world[terms][services_off][]", kind, world.services_off.include?(kind), id: "world_terms_off_#{kind}" %> Not in this setting</label>
            </div>
          <% end %>
        </div>
        <p class="hint">The inn rests the party, the shop sells the Armory, the guild sells a rumour, the temple raises the fallen. A service not in the setting never appears in its towns.</p>
      </fieldset>
      <details>
        <summary>Statuses</summary>
        <div class="field-row field-row--wrap">
          <% Battle::STATUSES.each do |status| %>
            <div class="field"><%= label_tag "world_terms_statuses_#{status}", status.humanize %><%= text_field_tag "world[terms][statuses][#{status}]", world.terms.dig("statuses", status), id: "world_terms_statuses_#{status}", placeholder: status.humanize, maxlength: 30 %></div>
          <% end %>
        </div>
      </details>
    </fieldset>
    <fieldset class="panel">
      <legend>Calendar</legend>
      <% almanac = world.almanac %>
      <% field = ->(key, label, value, **options) { tag.div(class: "field") { label_tag("world_calendar_#{key}", label) + text_field_tag("world[calendar][#{key}]", value, id: "world_calendar_#{key}", **options) } } %>
      <p class="hint">How campaigns here count time. Each part is made of the one before: parts of the day make a day, days a week and a month, months a season and a year, and years an era. Leave any of it blank: with none, a day is dawn, day, dusk and night, and days are counted plainly (Day 1, Day 2).</p>
      <div class="field-row">
        <%= field.("periods", "Parts of the day, in order", Array(world.calendar["periods"]).join(", "), placeholder: "Morning, After school, Evening, Late night") %>
        <%= field.("dark", "Of those, the night", Array(world.calendar["dark"]).join(", "), placeholder: "Late night") %>
      </div>
      <p class="hint">A night's sleep ends at the first part. Things to do and places' modes can be kept to any of these words, and a place's night line comes on in the night.</p>
      <%= field.("weekdays", "Days of the week", almanac.weekdays.join(", "), placeholder: "Moonsday, Tidesday, Ashday, Bellday, Restday") %>
      <div class="field-row">
        <div class="field">
          <%= label_tag "world_calendar_months", "Months, one a line: days, and the season" %>
          <%= text_area_tag "world[calendar][months]", almanac.months_text, id: "world_calendar_months", rows: 4, placeholder: "Thaw (30, Spring)\nRainfall (31, Spring)\nHighsun (30, Summer)" %>
        </div>
        <div class="field">
          <%= label_tag "world_calendar_eras", "Eras, one a line: # is the year, and when it began" %>
          <%= text_area_tag "world[calendar][eras]", almanac.eras_text, id: "world_calendar_eras", rows: 4, placeholder: "# AC (1)\nYear # of the Tide (1204)" %>
        </div>
      </div>
      <fieldset class="field">
        <legend>The story starts on</legend>
        <div class="field-row field-row--wrap">
          <%= field.("start_weekday", "Day of the week", (almanac.weekdays[almanac.start["weekday"]] if world.calendar["start"]), placeholder: almanac.weekdays.first || "Tuesday") %>
          <div class="field"><%= label_tag "world_calendar_start_day", "Day" %><%= number_field_tag "world[calendar][start_day]", (almanac.start["day"] if world.calendar["start"]), min: 1, max: 400, id: "world_calendar_start_day", placeholder: "1" %></div>
          <%= field.("start_month", "Month", (almanac.months[almanac.start["month"]]&.dig("name") if world.calendar["start"]), placeholder: almanac.months.first&.dig("name") || "April") %>
          <div class="field"><%= label_tag "world_calendar_start_year", "Year" %><%= number_field_tag "world[calendar][start_year]", almanac.start["year"], id: "world_calendar_start_year", placeholder: "2009" %></div>
        </div>
      </fieldset>
    </fieldset>
    <fieldset class="panel">
      <legend>Battle rules</legend>
      <%= hidden_field_tag "world[battle_rules][one_more]", "0", id: nil %>
      <div class="field field--check">
        <%= check_box_tag "world[battle_rules][one_more]", "1", world.rule?(:one_more), id: "world_battle_rules_one_more" %>
        <%= label_tag "world_battle_rules_one_more", "One More" %>
      </div>
      <p class="hint">A blow that finds a weakness, or lands a critical hit, knocks its target down (they lose their next turn), and whoever struck goes again at once. Enemies too.</p>
    </fieldset>
    <fieldset class="panel">
      <legend>Lines and veils</legend>
      <p class="hint">Shown to everyone who plays here, and the language model never writes them. Lines never happen in this setting; veils can happen, but off-screen.</p>
      <div class="field"><%= f.label :lines %><%= f.text_area :lines, rows: 2, placeholder: "harm to children, sexual violence" %></div>
      <div class="field"><%= f.label :veils %><%= f.text_area :veils, rows: 2, placeholder: "torture, the details of a plague" %></div>
    </fieldset>
    <fieldset class="field music-fields">
      <legend>Music</legend>
      <p class="hint">A track for each kind of scene, looped while the party is there. Every page at the table plays its scene's track; the GM can switch it from the table. A scene without a track is quiet. Audio files up to <%= World::MUSIC_MAX_BYTES / 1.megabyte %> MB, and only music you have the rights to.</p>
      <% World::MUSIC.each do |scene| %>
        <% track = world.music_track(scene) %>
        <div class="field">
          <%= f.label :"music_#{scene}", scene.capitalize %>
          <% if track&.persisted? %>
            <p class="music-fields__current">
              <audio controls preload="none" src="<%= rails_blob_path(track) %>"></audio>
              <span class="muted"><%= track.filename %></span>
              <label class="inline"><%= check_box_tag "world[remove_music][]", scene, false, id: "remove_music_#{scene}" %> Remove</label>
            </p>
          <% end %>
          <%= f.file_field :"music_#{scene}", accept: "audio/*" %>
        </div>
      <% end %>
    </fieldset>
  <% end %>
  <% unless world.persisted? %>
    <% sources = World.order(:name) %>
    <div class="field">
      <%= label_tag :copy_from, "Start from" %>
      <%= select_tag :copy_from, options_for_select(sources.map { |w| [ "#{w.name}'s books", w.slug ] }, params[:copy_from] || sources.first&.slug),
                     include_blank: "Empty books" %>
      <p class="hint">Copying gives you working monsters, jobs, abilities, items, tables and templates to edit and cut down. Your copies are your own: changing them never touches the original.</p>
    </div>
    <div class="field field--check">
      <%= check_box_tag :rules_only, "1", params[:rules_only] == "1" %>
      <%= label_tag :rules_only, "Rules only" %>
    </div>
    <p class="hint">Rules only keeps the books and leaves the setting: no places, people, codex or fronts, and none of its voice, words, calendar, history or music. For a world of your own on the same rules.</p>
  <% end %>
  <div class="actions">
    <%= f.submit class: "button" %>
    <%= link_to "Cancel", world.persisted? ? world_path(world) : worlds_path, class: "button button--quiet" %>
  </div>
<% end %>
