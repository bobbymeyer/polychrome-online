<% content_for :title, "Home" %>
<section class="window" aria-label="Your campaigns">
  <div class="book-header">
    <h2>Your campaigns</h2>
    <%= link_to "New campaign", new_world_campaign_path(@worlds.first), class: "button" if @worlds.one? && can_make_games? %>
  </div>
  <% if @my_campaigns.empty? %>
    <p class="empty"><%= can_make_games? ? "None yet. Start one#{" in a world below" unless @worlds.one?} and you run it as its GM, or ask" : "None yet. Ask" %> your GM for their invite link to play in theirs.</p>
  <% else %>
    <%= render "worlds/campaign_list", campaigns: @my_campaigns %>
  <% end %>
</section>

<% if @other_campaigns.any? %>
  <section class="window" aria-label="Other campaigns">
    <h2>Everyone else's campaigns <span class="muted">(you're an admin)</span></h2>
    <%= render "worlds/campaign_list", campaigns: @other_campaigns %>
  </section>
<% end %>

<div class="book-header">
  <h2>Worlds</h2>
  <%= link_to "New world", new_world_path, class: "button" if can_make_games? %>
  <%= link_to "Import a world", new_world_import_path, class: "button button--quiet" if can_make_games? %>
</div>
<% if @worlds.empty? %>
  <p class="empty">No worlds yet. Run <code>bin/rails db:seed</code> for the base world.</p>
<% else %>
  <ul class="world-list">
    <% @worlds.each do |world| %>
      <li class="window">
        <h2><%= link_to world.name, world %></h2>
        <% if !@worlds.one? && can_make_games? %><p><%= link_to "New campaign in #{world.name}", new_world_campaign_path(world) %></p><% end %>
        <% if world.description.present? %><p><%= world.description %></p><% end %>
      </li>
    <% end %>
  </ul>
<% end %>
