<% content_for :title, @world.name %>
<div class="book-header">
  <h1><%= @world.name %></h1>
  <div class="actions">
    <%= link_to "New campaign", new_world_campaign_path(@world), class: "button" %>
    <%= link_to "Edit world", edit_world_path(@world), class: "button button--quiet" %>
  </div>
</div>
<% if @world.description.present? %>
  <div class="prose"><%= simple_format(@world.description) %></div>
<% end %>

<% campaigns = @world.campaigns.order(updated_at: :desc) %>
<% if campaigns.any? %>
  <section class="window">
    <h2>Campaigns</h2>
    <ul class="refs">
      <% campaigns.each do |campaign| %>
        <li><%= link_to campaign.name, campaign_path(campaign) %> <span class="muted">· <%= pluralize(campaign.characters.count, "character") %></span></li>
      <% end %>
    </ul>
  </section>
<% end %>

<div class="shelf">
  <% [
       ["Bestiary", :bestiary, "Monsters: stat blocks, affinities, behavior, drops.", @world.monsters],
       ["Job Compendium", :compendium, "Jobs: stat modifiers, equipment, learn tables.", @world.jobs],
       ["Grimoire", :grimoire, "Abilities, composed from the engine's primitives.", @world.abilities],
       ["Armory", :armory, "Items and equipment.", @world.items]
     ].each do |title, book, blurb, entries| %>
    <section class="window shelf__book">
      <h2><%= link_to title, polymorphic_path([@world, book, entries.klass]) %></h2>
      <p><%= blurb %></p>
      <p class="muted"><%= pluralize(entries.count, "entry") %></p>
      <ul class="refs refs--inline">
        <% entries.order(:name).limit(8).each do |entry| %>
          <li><%= link_to entry.name, polymorphic_path([@world, book, entry]) %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
