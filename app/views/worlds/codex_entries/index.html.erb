<% content_for :title, "Codex · #{@world.name}" %>
<div class="crumbs"><%= link_to @world.name, world_path(@world) %> / Codex</div>
<div class="book-header">
  <h1>Codex</h1>
  <% if can_edit_world? %><%= link_to "New page", new_world_codex_entry_path(@world), class: "button" %><% end %>
</div>
<p class="prose">What's known about <%= @world.name %>: its factions, faiths, history and customs.<%= " Pages marked GM only, and every page's GM notes, are hidden from players." if knows_the_lore? %></p>
<% if @entries.any? %>
  <% @entries.group_by { |e| e.category || "Other" }.each do |category, entries| %>
    <section class="window">
      <h2><%= category %></h2>
      <ul class="refs">
        <% entries.each do |entry| %>
          <li><%= link_to entry.title, world_codex_entry_path(@world, entry) %><%= tag.span(" · GM only", class: "muted") unless entry.public? %>
            <% if entry.body.present? %><span class="muted"> · <%= entry.body.squish.truncate(100) %></span><% end %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% else %>
  <p class="empty">Nothing written yet.</p>
<% end %>
