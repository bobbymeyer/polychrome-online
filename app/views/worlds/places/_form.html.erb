<%= form_with model: place, url: place.persisted? ? world_world_place_path(@world, place) : world_world_places_path(@world), class: "book-form" do |f| %>
  <%= render "book_entries/errors", entry: place %>
  <div class="field-row">
    <div class="field"><%= f.label :name %><%= f.text_field :name, required: true, placeholder: "Varn" %></div>
    <div class="field"><%= f.label :kind %><%= f.select :kind, MapNode::KINDS.map { |k| [ k.humanize, k ] } %></div>
    <div class="field"><%= f.label :x %><%= f.number_field :x, min: 0, max: MapNode::WIDTH %></div>
    <div class="field"><%= f.label :y %><%= f.number_field :y, min: 0, max: MapNode::HEIGHT %></div>
  </div>
  <p class="hint">
    Where it sits on a <%= MapNode::WIDTH %> × <%= MapNode::HEIGHT %> map. Towns and dungeons can be rolled from a Gazetteer template; the
    seed is kept, so it comes out the same in every campaign. Landmarks (a lighthouse, a manor) and wilds (a marsh, a sea) are places with no generator.
  </p>
  <div class="field">
    <%= f.label :location_template_id, "Rolled from" %>
    <%= f.select :location_template_id, @world.location_templates.order(:kind, :name).map { |t| [ "#{t.name} (#{t.kind})", t.id ] }, include_blank: "Nothing: it's just a place on the map" %>
    <% if place.seed %><p class="hint">Seed <%= place.seed %>.</p><% end %>
  </div>
  <div class="field field--check"><%= f.check_box :known %><%= f.label :known, "The players know it from the start" %></div>
  <div class="field"><%= f.label :description, "What players read about it" %><%= f.text_area :description, rows: 3 %></div>
  <div class="field"><%= f.label :notes, "GM notes" %><%= f.text_area :notes, rows: 3 %></div>
  <div class="field">
    <%= f.label :lead, "What people say that leads to it" %>
    <%= f.text_area :lead, rows: 2, placeholder: "Goblins have been coming down at night from a cave in the hills." %>
    <p class="hint">For a place players don't know from the start: a campaign starts this talk in the nearest town by road, and hearing it puts the place on the map.</p>
  </div>
  <div class="field">
    <%= f.label :night_line, "What it's like by night" %>
    <%= f.text_area :night_line, rows: 2, placeholder: "The shutters come down. Under the platform, the Undertow wakes." %>
    <p class="hint">For a town or dungeon that's different after dark: campaigns give it a "By night" mode that comes on at night by itself (the GM can shut services in it, or add trouble).</p>
  </div>
  <div class="field">
    <%= f.label :activities, "Things to do here" %>
    <%= f.text_area :activities, rows: 4, class: "script-field", placeholder: "Attend class (dawn/day, 2): The bell. Maths, then lunch on the roof.\nThe Undertow (night, 4)" %>
    <p class="hint">Things to do here, one per line: a name, then in brackets when (dawn, day, dusk, night; any if none) and how many parts of the day it takes (1 if none), then what the table hears. The party picks one from Where next?, and the time goes by.</p>
  </div>
  <fieldset class="panel past-fields">
    <legend>Its past</legend>
    <p class="hint">
      Who founded it and who they're at odds with; for a dungeon, what it was and how it fell (its rooms, boss and treasure follow from that).
      The world's <%= link_to "history", world_history_path(@world) %> writes this; once you change it, it's yours and the history leaves it alone.
      <% if place.past.present? && !Past.new(place.past).edited? %>Written by the history.<% end %>
    </p>
    <% was = place.past_form %>
    <%= f.fields_for :past_form do |p| %>
      <div class="field-row">
        <div class="field"><%= p.label :founder, "Founded by" %><%= p.text_field :founder, value: was["founder"], placeholder: "Aldo Vell" %></div>
        <div class="field"><%= p.label :founded, "Years ago" %><%= p.number_field :founded, value: was["founded"], min: 0 %></div>
        <div class="field"><%= p.label :family, "Their family" %><%= p.text_field :family, value: was["family"], placeholder: "Vell" %></div>
      </div>
      <div class="field-row">
        <div class="field"><%= p.label :rival, "Old rivals" %><%= p.text_field :rival, value: was["rival"], placeholder: "Marrow" %></div>
        <div class="field"><%= p.label :feud_with, "Feud still running with" %><%= p.text_field :feud_with, value: was["feud_with"] %></div>
        <div class="field"><%= p.label :feud_cause, "Over" %><%= p.text_field :feud_cause, value: was["feud_cause"], placeholder: "a horse sold lame" %></div>
      </div>
      <div class="field-row">
        <div class="field"><%= p.label :was, "Once (a dungeon)" %><%= p.select :was, Generators::History::PASTS.keys.map { |k| [ k.capitalize, k ] }, { include_blank: "Nothing in particular", selected: was["was"] } %></div>
        <div class="field"><%= p.label :fall_kind, "Until" %><%= p.select :fall_kind, WorldPlace::PAST_FALLS.map { |k| [ k.capitalize, k ] }, { include_blank: "Nothing happened", selected: was["fall_kind"] } %></div>
        <div class="field"><%= p.label :fall_ago, "Years ago" %><%= p.number_field :fall_ago, value: was["fall_ago"], min: 0 %></div>
        <div class="field"><%= p.label :holder, "Owned now by" %><%= p.text_field :holder, value: was["holder"] %></div>
      </div>
      <div class="field"><%= p.label :lost, "Who never came out (names, with commas)" %><%= p.text_field :lost, value: was["lost"] %></div>
    <% end %>
  </fieldset>
  <div class="actions">
    <%= f.submit class: "button" %>
    <%= link_to "Cancel", world_world_places_path(@world), class: "button button--quiet" %>
  </div>
<% end %>
<% if place.persisted? %>
  <%= button_to "Take it off the atlas", world_world_place_path(@world, place), method: :delete, class: "button button--danger",
                form: { data: { turbo_confirm: "Take #{place.name} off the atlas? Campaigns keep theirs." } } %>
<% end %>
