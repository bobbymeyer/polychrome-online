<% content_for :title, "Join #{@campaign.name}" %>
<% controller = params[:view] == "controller" %>
<div class="join">
  <p class="eyebrow"><%= controller ? "Local co-op" : "You're invited" %></p>
  <h1><%= @campaign.name %></h1>
  <p>
    <%= controller ? "Pick who you're playing. This phone becomes your controller; the game itself plays on the shared screen." :
                     "Pick who you're playing, or make someone new, and take your seat at the table." %>
  </p>
  <%# What you're sitting down to, before you do: the setting in a line, and what it never shows. %>
  <% world = @campaign.world %>
  <% if world.description.present? %>
    <p class="join__setting"><strong><%= world.name %>.</strong> <%= world.description %></p>
  <% end %>
  <%= render "worlds/lines_and_veils", world: world, campaign: @campaign %>

  <%# One form, one name: pick someone the GM made (each is a button), or make your own below. %>
  <%= form_with model: @character, url: join_path(@campaign.join_code), method: :post, class: "book-form join__form" do |f| %>
    <%# Enter in a field mustn't sit you down as the first character listed: the form's default button does nothing. %>
    <button type="submit" disabled hidden aria-hidden="true"></button>
    <%= hidden_field_tag :view, "controller" if controller %>
    <%= render "book_entries/errors", entry: @character %>
    <% unless current_user %>
      <div class="field">
        <%= label_tag :name, "Your name" %>
        <%= text_field_tag :name, params[:name], maxlength: 60, autocomplete: "nickname", placeholder: "So the table knows who's who" %>
      </div>
    <% end %>

    <% if @characters.any? %>
      <h2>Play someone the GM made</h2>
      <%# One character a row (pick_table_controller): the row sits you down as them. %>
      <table class="pick-table join__characters" data-controller="pick-table">
        <tbody>
        <% @characters.each do |character| %>
          <tr class="pick-row">
            <td class="pick-row__who"><%= speaker_portrait(character, "neutral", size: :small) %></td>
            <td class="pick-row__what">
              <%= button_tag character.name, type: "submit", name: "character_id", value: character.id, class: "pick-row__act join__character", formnovalidate: true %>
              <span class="pick-row__note">Lv <%= character.level %> <%= character.job.name %><%= " · yours" if current_user && character.user_id == current_user.id %><%= " · #{character.motive}" if character.motive %></span>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    <% end %>

    <details class="join__new" <%= "open" if @characters.empty? || @character.errors.any? %>>
      <summary><h2><%= @characters.any? ? "Or make your own" : "Make your character" %></h2></summary>
      <div class="field"><%= f.label :name, "Their name" %><%= f.text_field :name, required: true, maxlength: 60 %></div>
      <%= render "characters/job_picker", f: f, jobs: @campaign.available_jobs.includes(job_levels: :ability), selected: @character.job_id,
                                          party: @campaign.characters.includes(:job).order(:created_at) %>
      <div class="field">
        <%= f.label :motive, "Why they're here" %>
        <%= f.text_field :motive, maxlength: Character::MOTIVE_LENGTH, placeholder: "“My sister's debt is mine now.”" %>
        <p class="hint">One line, in their own words. It's what they shout when their back is to the wall.</p>
      </div>
      <p class="hint">They start at level <%= @campaign.newcomer_level %><%= ", with the rest of the party" if @campaign.characters.exists? %>, knowing what their archetype teaches by then, in the gear it uses. Where they're from and who they know can wait for their sheet.</p>
      <div class="sticky-submit"><%= f.submit "Join as them", class: "button play" %></div>
    </details>
  <% end %>

  <% if current_user %>
    <p class="hint">Joining as <strong><%= current_user.name %></strong>.</p>
  <% end %>
</div>
