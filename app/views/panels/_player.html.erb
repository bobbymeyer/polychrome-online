<% state = @battle.state %>
<% command = state["inputs"][unit["id"]] %>
<div data-controller="menu timing-meter" data-action="submit->timing-meter#intercept" data-menu-primary-value="true" data-menu-autofocus-value="true" data-menu-you-value="<%= unit['id'] %>">
<div class="command-panel__head">
  <h2><%= unit["name"] %></h2>
  <span class="command-panel__vitals">
    <span class="label"><%= gloss(:max_hp) %></span> <strong class="<%= 'is-low' if hp_band(unit) == 'danger' %>"><%= unit["hp"] %></strong><span class="muted">/<%= unit["stats"]["max_hp"] %></span>
    <span class="label"><%= gloss(:max_mp) %></span> <strong><%= unit["mp"] %></strong><span class="muted">/<%= unit["stats"]["max_mp"] %></span>
  </span>
  <%= render "panels/countdown" %>
</div>

<% if unit["hp"].zero? %>
  <p>You're down. Hope someone has a Raise.</p>
<% elsif !Battle::State.able_to_act(state).include?(unit["id"]) %>
  <p>You can't act this round (<%= unit["statuses"].map { |s| s["kind"].humanize }.to_sentence %>).</p>
<% elsif @choosing %>
  <% item = @choosing["kind"] == "item" %>
  <div data-choosing>
    <p class="command-panel__prompt"><strong><%= @choosing["name"] %></strong>: choose a target.</p>
    <div class="menu play">
      <% (Battle::State.target_options(state, unit, @choosing) || []).each do |target_id| %>
        <% command = item ? { kind: "item", item: @choosing["id"], target: target_id } : { kind: "ability", ability: @choosing["id"], target: target_id } %>
        <%= button_to unit_name(state, target_id), battle_actions_path(@battle), class: "menu__item",
                      data: { unit_id: target_id, help: target_help(@battle, state, target_id) }, params: { command: command } %>
      <% end %>
    </div>
    <p class="menu-help" data-menu-target="help" aria-live="polite"></p>
    <%= link_to "Back", battle_panel_path(@battle, (item ? { items: 1 } : {})), class: "link-button", data: { menu_back: true } %>
  </div>
<% elsif @item_menu %>
  <div data-choosing>
    <p class="command-panel__prompt"><strong>Items</strong>: shared by the whole party.</p>
    <div class="menu play">
      <% state.fetch("items", {}).each_value do |it| %>
        <% left = Battle::State.items_left(state, it["id"], except: unit["id"]) %>
        <% label = safe_join([ it["name"], tag.span("×#{left}", class: "menu__cost") ], " ") %>
        <% help = item_help(it, left) %>
        <% if left <= 0 %>
          <button type="button" class="menu__item" aria-disabled="true" data-help="<%= help %>" data-menu-key="<%= it['name'] %>"><%= label %></button>
        <% elsif Battle::State.target_options(state, unit, it) %>
          <%= link_to label, battle_panel_path(@battle, item: it["id"]), class: "menu__item", data: { help: help, menu_key: it["name"] } %>
        <% else %>
          <%= button_to label, battle_actions_path(@battle), class: "menu__item", data: { help: help, menu_key: it["name"] },
                        params: { command: { kind: "item", item: it["id"] } } %>
        <% end %>
      <% end %>
    </div>
    <p class="menu-help" data-menu-target="help" aria-live="polite"></p>
    <%= link_to "Back", battle_panel_path(@battle), class: "link-button", data: { menu_back: true } %>
  </div>
<% elsif command && !params[:change] %>
  <p>
    Ready: <strong><%= case command["kind"] when "ability" then ability_name(state, command["ability"]) when "item" then item_name(state, command["item"]) else command["kind"].humanize end %></strong>
    <% if command["target"] %>→ <%= unit_name(state, command["target"]) %><% end %>.
    Waiting for <%= (@battle.awaiting_input.map { |id| unit_name(state, id) }.to_sentence.presence || "the round to run") %>.
  </p>
  <%= link_to "Change command", battle_panel_path(@battle, change: 1), class: "link-button", data: { menu_back: true } %>
<% else %>
  <div class="menu play">
    <% unit["abilities"].map { |id| state["abilities"][id] }.each do |ability| %>
      <% usable = Battle::State.usable?(unit, ability) %>
      <% cost = Battle::State.ability_cost(ability) %>
      <% label = safe_join([ ability["name"], (tag.span("#{cost} MP", class: "menu__cost") if cost.positive?) ].compact, " ") %>
      <% help = ability_help(unit, ability) %>
      <% if !usable %>
        <button type="button" class="menu__item" aria-disabled="true" data-help="<%= help %>" data-menu-key="<%= ability['name'] %>"><%= label %></button>
      <% elsif Battle::State.target_options(state, unit, ability) %>
        <%= link_to label, battle_panel_path(@battle, ability: ability["id"]), class: "menu__item", data: { help: help, menu_key: ability["name"] } %>
      <% else %>
        <%= button_to label, battle_actions_path(@battle), class: "menu__item", data: { help: help, menu_key: ability["name"] },
                      params: { command: { kind: "ability", ability: ability["id"] } } %>
      <% end %>
    <% end %>
    <% if state.fetch("items", {}).any? %>
      <%= link_to battle_panel_path(@battle, items: 1), class: "menu__item", data: { help: "Use something from the party's bag.", menu_key: "Item" } do %>
        Item <span class="menu__cost">×<%= state["items"].values.sum { |i| Battle::State.items_left(state, i["id"], except: unit["id"]) } %></span>
      <% end %>
    <% end %>
    <%= button_to "Defend", battle_actions_path(@battle), class: "menu__item", data: { help: "Halve the damage you take this round." },
                  params: { command: { kind: "defend" } } %>
    <% if state["escapable"] %>
      <%= button_to "Flee", battle_actions_path(@battle), class: "menu__item", data: { help: "Try to get the whole party away. It can fail." },
                    params: { command: { kind: "flee" } } %>
    <% end %>
  </div>
  <p class="menu-help" data-menu-target="help" aria-live="polite"></p>
<% end %>
<% if unit["hp"].positive? %>
  <%# Talk, and let the fight run: your default command every round until you pick one yourself. %>
  <% on = @battle.auto?(unit["id"]) %>
  <%= button_to on ? "Auto is on: every round, your last command (or Attack)" : "Go on auto (chat, and let the fight run)",
                battle_auto_path(@battle), method: :patch, params: { unit: unit["id"], on: on ? "0" : "1" },
                class: [ "link-button", "auto-toggle", ("is-on" if on) ], form: { class: "auto-toggle-form" },
                aria: { pressed: on }, title: "Picking a command yourself takes you off auto" %>
<% end %>
<p class="keys">Arrows move · Enter choose · Esc back · 1–9 pick ·
  <button type="button" class="link-button" data-timing-meter-target="toggle" data-action="timing-meter#toggle"
          title="Stop the needle on the mark for a Perfect: the move lands a quarter harder">Timing meter</button></p>
</div>
