<% state = @battle.state %>
<% command = state["inputs"][unit["id"]] %>
<div class="command-panel__head">
  <h2><%= unit["name"] %></h2>
  <span class="muted">HP <%= unit["hp"] %>/<%= unit["stats"]["max_hp"] %> · MP <%= unit["mp"] %></span>
  <%= render "panels/countdown" %>
</div>

<% if unit["hp"].zero? %>
  <p>You're down. Hope someone has a Raise.</p>
<% elsif !Battle::State.able_to_act(state).include?(unit["id"]) %>
  <p>You can't act this round (<%= unit["statuses"].map { |s| s["kind"].humanize }.to_sentence %>).</p>
<% elsif @choosing %>
  <div data-choosing>
    <p><strong><%= @choosing["name"] %></strong>: choose a target.</p>
    <div class="menu">
      <% (Battle::State.target_options(state, unit, @choosing) || []).each do |target_id| %>
        <%= button_to unit_name(state, target_id), battle_actions_path(@battle), class: "menu__item",
                      params: { command: { kind: "ability", ability: @choosing["id"], target: target_id } } %>
      <% end %>
    </div>
    <%= link_to "◀ Back", battle_panel_path(@battle), class: "link-button" %>
  </div>
<% elsif command && !params[:change] %>
  <p>
    Ready: <strong><%= command["kind"] == "ability" ? ability_name(state, command["ability"]) : command["kind"].humanize %></strong>
    <% if command["target"] %>→ <%= unit_name(state, command["target"]) %><% end %>.
    Waiting for <%= (@battle.awaiting_input.map { |id| unit_name(state, id) }.to_sentence.presence || "the round to run") %>.
  </p>
  <%= link_to "Change command", battle_panel_path(@battle, change: 1), class: "link-button" %>
<% else %>
  <div class="menu">
    <% unit["abilities"].map { |id| state["abilities"][id] }.each do |ability| %>
      <% usable = Battle::State.usable?(unit, ability) %>
      <% cost = Battle::State.ability_cost(ability) %>
      <% label = safe_join([ ability["name"], (tag.span("#{cost} MP", class: "menu__cost") if cost.positive?) ].compact, " ") %>
      <% if !usable %>
        <button class="menu__item" disabled><%= label %></button>
      <% elsif Battle::State.target_options(state, unit, ability) %>
        <%= link_to label, battle_panel_path(@battle, ability: ability["id"]), class: "menu__item" %>
      <% else %>
        <%= button_to label, battle_actions_path(@battle), class: "menu__item",
                      params: { command: { kind: "ability", ability: ability["id"] } } %>
      <% end %>
    <% end %>
    <%= button_to "Defend", battle_actions_path(@battle), class: "menu__item", params: { command: { kind: "defend" } } %>
    <% if state["escapable"] %>
      <%= button_to "Flee", battle_actions_path(@battle), class: "menu__item", params: { command: { kind: "flee" } } %>
    <% end %>
  </div>
<% end %>
