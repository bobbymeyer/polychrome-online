<!DOCTYPE html>
<html>
  <head>
    <title><%= [content_for(:title), "Polychrome"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Polychrome">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-book="<%= current_book %>" class="<%= "has-table-views" if content_for?(:table_views) %>" style="<%= accent_style %>" <%= tag.attributes(data: { view: coop_view(@campaign || @battle&.campaign) }) %>>
    <header class="topbar" data-controller="topbar" data-action="click@window->topbar#outside keydown@window->topbar#escape">
      <%# On a phone (and the table page up to a tablet's width) the links fold behind one button: a hamburger, before the wordmark. %>
      <button type="button" class="topbar__toggle" data-action="topbar#toggle" data-topbar-target="toggle" aria-expanded="false" aria-controls="topbar_menu" aria-label="Menu" title="Menu">
        <span class="topbar__burger" aria-hidden="true"></span>
      </button>
      <%= link_to "Polychrome", root_path, class: "topbar__brand" %>
      <%# The table's three views, up to a tablet's width, at the bar's right end (campaigns/tables/show). %>
      <%= yield :table_views %>
      <div class="topbar__menu" id="topbar_menu">
      <% in_campaign = @campaign&.persisted? ? @campaign : @battle&.campaign %>
      <% if in_campaign && current_user %>
        <%# In a campaign (a battle included), the way around the game; the world's books are one link away. %>
        <% mine = in_campaign.characters.find_by(user: current_user) %>
        <nav class="topbar__books" aria-label="Campaign">
          <%= link_to in_campaign.name, campaign_path(in_campaign), class: "topbar__world" %>
          <%= link_to "Table", campaign_table_path(in_campaign) %>
          <%= link_to "My sheet", character_path(mine) if mine %>
          <%= link_to "Prep", campaign_prep_path(in_campaign) if can_gm?(in_campaign) %>
          <%= link_to "Legends", campaign_legends_path(in_campaign) %>
          <%= yield :table_menu %>
          <%= link_to "#{in_campaign.world.name}'s books", world_path(in_campaign.world), class: "muted" %>
        </nav>
      <% elsif @world&.persisted? %>
        <nav class="topbar__books" aria-label="Books">
          <%= link_to @world.name, world_path(@world), class: "topbar__world" %>
          <%= book_nav_link "Bestiary", world_bestiary_monsters_path(@world), :bestiary %>
          <%= book_nav_link "Compendium", world_compendium_jobs_path(@world), :compendium %>
          <%= book_nav_link "Grimoire", world_grimoire_abilities_path(@world), :grimoire %>
          <%= book_nav_link "Armory", world_armory_items_path(@world), :armory %>
          <%= book_nav_link "Encounters", world_encounters_encounter_tables_path(@world), :encounters %>
          <%= book_nav_link "Gazetteer", world_gazetteer_location_templates_path(@world), :gazetteer %>
          <%= book_nav_link "Generators", world_generation_generator_tables_path(@world), :generation %>
        </nav>
      <% end %>
      <%# The account is one item: your name, with everything about you and this device under it. %>
      <nav class="topbar__account" aria-label="Account">
        <% if current_user %>
          <details class="topbar__user">
            <summary><%= current_user.name %></summary>
            <div class="topbar__user-menu">
              <% if admin? %><span class="muted">Admin</span><% end %>
              <% if @campaign&.persisted? %>
                <%# Your seat at this table, and the way out of it; a seat is taken at the table's door (campaigns/tables/_take_a_seat). %>
                <% seat = table_seat(@campaign) %>
                <span class="muted">Seat</span>
                <span class="topbar__seat"><%= seat.seated? ? safe_join([ "At the table as ", tag.strong(seat.name) ]) : "Not at the table" %></span>
                <% if seat.seated? %>
                  <%= button_to "Stand up", campaign_table_seat_path(@campaign), method: :delete, class: "link-button", form: { class: "inline" } %>
                <% else %>
                  <%= link_to "Take a seat", campaign_table_path(@campaign) %>
                <% end %>
                <span class="muted">You</span>
              <% end %>
              <%= link_to "How to play", how_to_play_path %>
              <button type="button" class="link-button" data-controller="mute" data-action="mute#toggle" aria-pressed="false"
                      title="Sound on this device">Sound on</button>
              <%# A setting for this device, beside Sound: battles play twice as fast (fast_toggle_controller). %>
              <button type="button" class="link-button" data-controller="fast-toggle" data-action="fast-toggle#toggle" data-battle-fast aria-pressed="false"
                      title="Play battles twice as fast on this device">Fast animations</button>
              <%# The timing meter, too: a device setting (meter_toggle_controller), not a move. %>
              <button type="button" class="link-button" data-controller="meter-toggle" data-action="meter-toggle#toggle" data-timing-meter aria-pressed="false"
                      title="On each move in a battle, stop the needle on the mark for a Perfect: it lands a quarter harder">Timing meter</button>
              <% if admin? %><%= link_to "Accounts", users_path %> <%= link_to "Settings", settings_path %><% end %>
              <%= button_to "Sign out", session_path, method: :delete, class: "link-button topbar__sign-out", form: { class: "inline" } %>
            </div>
          </details>
        <% elsif controller_name != "sessions" %>
          <%= link_to "Sign in", new_session_path %>
        <% end %>
      </nav>
      </div>
    </header>

    <main class="page">
      <%# What just happened, where you are on the page: a notice floats over it for a moment. %>
      <% if flash.any? %>
        <div class="flashes" data-turbo-temporary>
          <% flash.each do |type, message| %>
            <div class="flash flash--<%= type %>" role="<%= type.to_s == "alert" ? "alert" : "status" %>" data-controller="flash" data-action="click->flash#dismiss"><%= message %></div>
          <% end %>
        </div>
      <% end %>
      <%= yield %>
    </main>
    <%# A YouTube or Spotify track's player (sound.js), kept across pages; empty and hidden until one plays. %>
    <div id="music_embed" class="music-embed" data-turbo-permanent hidden></div>
  </body>
</html>
