<%# One line in the table log. The same markup is rendered for the page and broadcast live, so it
    holds nothing viewer-specific. Live dialogue lines start hidden in the log: the dialogue box
    types them out first, then reveals them here (like the battle player, no spoilers). %>
<% live = local_assigns.fetch(:live, false) %>
<li id="<%= dom_id(message) %>"
    class="chat-line chat-line--<%= message.system? || message.choice? ? 'system' : message.whisper? ? 'whisper' : message.dialogue? ? 'dialogue' : 'player' %> <%= 'is-pending' if live && message.dialogue? %>"
    data-controller="chat-line<%= ' check-roll' if message.cue == 'check' %>"
    data-chat-line-live-value="<%= live %>"
    data-chat-line-id-value="<%= message.id %>"
    data-chat-line-dialogue-value="<%= message.dialogue? %>"
    data-chat-line-cue-value="<%= message.cue %>"
    <%= tag.attributes(data: { check_roll_result_value: message.data.to_json }) if message.cue == "check" %>
    data-chat-line-speaker-value="<%= message.speaker_name %>"
    data-chat-line-speaker-key-value="<%= speaker_key(message) %>"
    data-chat-line-expression-value="<%= message.expression || 'neutral' %>"
    data-chat-line-portrait-value="<%= speaker_portrait_url(message.speaker, message.expression) %>"
    data-chat-line-plate-value="<%= plate_style(message.speaker.name, message.speaker.try(:colour)) if message.speaker %>">
  <% if message.choice? %>
    <p class="chat-line__body">
      <%= message.body %>
      <% if message.settled %><strong>They chose: <%= message.settled %>.</strong><% end %>
    </p>
  <% elsif message.system? %>
    <p class="chat-line__body">
      <%= message.body %>
      <% if message.cue == "jobs" %>
        <span class="reward-cards reward-cards--jobs">
          <% Array(message.data["jobs"]).each do |job| %>
            <span class="reward-card reward-card--new-job">
              <span class="reward-card__kind">New job!</span>
              <strong class="reward-card__name"><%= job["name"] %></strong>
              <% if job["description"].present? %><span class="reward-card__detail"><%= job["description"] %></span><% end %>
            </span>
          <% end %>
        </span>
      <% end %>
      <% if message.battle %>
        <% joinable = message.battle == message.campaign.current_battle %>
        <%= link_to(joinable ? "Join the battle →" : "See the battle", battle_path(message.battle), class: ("play" if joinable), data: { turbo_frame: "_top" }) %>
      <% end %>
    </p>
  <% else %>
    <%= speaker_portrait(message.speaker, message.expression) %>
    <div>
      <p class="chat-line__head">
        <strong><%= message.speaker_name %></strong>
        <% if message.whisper? %><span class="chat-line__tag"><%= whisper_label(message) %></span><% end %>
        <% if message.gm_only? %><span class="chat-line__tag">GM only</span><% end %>
        <% if message.expression.present? && message.expression != "neutral" %><span class="muted">(<%= message.expression %>)</span><% end %>
        <%# Story time on the line; the wall clock only on hover. %>
        <time class="muted" datetime="<%= message.created_at.iso8601 %>" title="<%= "Day #{message.day} · " if message.day %><%= message.created_at.strftime("%-d %B, %H:%M") %>"><%= message.story_time || message.created_at.strftime("%H:%M") %></time>
      </p>
      <div class="chat-line__body" data-chat-line-target="body"><%= simple_format(message.body, {}, wrapper_tag: "p") %></div>
      <%= button_to "Take back", message_path(message), method: :delete, class: "link-button chat-line__retract",
                    form: { class: "chat-line__retract-form", hidden: true,
                            data: { chat_line_target: "retract", turbo_confirm: "Take this line back? It goes for everyone." } } %>
    </div>
  <% end %>
</li>
