<%# One line in the table log. The same markup is rendered for the page and broadcast live, so it
    holds nothing viewer-specific. Live dialogue lines start hidden in the log: the dialogue box
    types them out first, then reveals them here (like the battle player, no spoilers). %>
<% live = local_assigns.fetch(:live, false) %>
<li id="<%= dom_id(message) %>"
    class="chat-line chat-line--<%= message.system? ? 'system' : message.whisper? ? 'whisper' : message.dialogue? ? 'dialogue' : 'player' %> <%= 'is-pending' if live && message.dialogue? %>"
    data-controller="chat-line"
    data-chat-line-live-value="<%= live %>"
    data-chat-line-id-value="<%= message.id %>"
    data-chat-line-dialogue-value="<%= message.dialogue? %>"
    data-chat-line-speaker-value="<%= message.speaker_name %>"
    data-chat-line-speaker-key-value="<%= speaker_key(message) %>"
    data-chat-line-expression-value="<%= message.expression || 'neutral' %>"
    data-chat-line-portrait-value="<%= speaker_portrait_url(message.speaker, message.expression) %>">
  <% if message.system? %>
    <p class="chat-line__body">
      ⚔ <%= message.body %>
      <% if message.battle %>
        <%= link_to(message.battle.over? ? "See the battle" : "Join the battle →", battle_path(message.battle), data: { turbo_frame: "_top" }) %>
      <% end %>
    </p>
  <% else %>
    <%= speaker_portrait(message.speaker, message.expression) %>
    <div>
      <p class="chat-line__head">
        <strong><%= message.speaker_name %></strong>
        <% if message.whisper? %><span class="chat-line__tag"><%= whisper_label(message) %></span><% end %>
        <% if message.expression.present? && message.expression != "neutral" %><span class="muted">(<%= message.expression %>)</span><% end %>
        <time class="muted" datetime="<%= message.created_at.iso8601 %>"><%= message.created_at.strftime("%H:%M") %></time>
      </p>
      <div class="chat-line__body" data-chat-line-target="body"><%= simple_format(message.body, {}, wrapper_tag: "p") %></div>
    </div>
  <% end %>
</li>
