<% content_for :title, @campaign.name %>
<% content_for :head, music_meta(@campaign, @campaign.scene) %>
<%= render "shared/stage_stream", campaign: @campaign %>
<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>
<%= turbo_stream_from @campaign, :pages %>
<div class="crumbs"><%= link_to @world.name, world_path(@world) %> / Campaign</div>
<div class="book-header">
  <div>
    <h1><%= @campaign.name %></h1>
    <p class="muted"><%= money(@campaign.gil) %> · <%= @campaign.when_it_is %></p>
  </div>
  <div class="actions">
    <%= link_to "Open the table", campaign_table_path(@campaign), class: "button" %>
    <%= link_to "Codex", world_codex_entries_path(@world), class: "button button--quiet" if @world.codex_entries.exists? %>
    <% if can_gm?(@campaign) %>
    <%= link_to "New battle", new_campaign_battle_path(@campaign), class: "button button--quiet" %>
    <%= button_to "Make camp", campaign_rest_path(@campaign), class: "button button--quiet",
                  form: { data: { turbo_confirm: "Rest in the open? Everyone gets back full #{word('hp')} and half their #{word('mp')}; the night passes." } } %>
    <%= link_to "Edit", edit_campaign_path(@campaign), class: "button button--quiet" %>
    <% end %>
  </div>
</div>

<%= render "worlds/lines_and_veils", world: @world %>

<%= render "campaigns/first_steps", campaign: @campaign if can_gm?(@campaign) && !@campaign.messages.where(kind: "say").exists? %>

<section>
  <div class="book-header">
    <h2>Party</h2>
    <%= link_to "New character", new_campaign_character_path(@campaign), class: "button button--quiet" %>
  </div>
  <% if @characters.empty? %>
    <p class="empty">No characters yet. <%= can_gm?(@campaign) ? "Make some, or send the invite link below and players make their own." : "Make yours." %></p>
  <% else %>
    <div class="roster-cards">
      <% @characters.each do |character| %>
        <%= link_to character_path(character), class: "window character-card #{'is-ko' unless character.conscious?}" do %>
          <%= entry_portrait(character.job, size: :small) %>
          <div>
            <h3><%= character.name %></h3>
            <p class="muted">
              <% if character.user_id == current_user.id %>
                <strong>You</strong>
              <% elsif character.user %>
                Played by <%= character.user.name %>
              <% else %>
                Unclaimed: sit as them at the table to play them
              <% end %>
            </p>
            <p>Lv <%= character.level %> <%= character.job.name %> <span class="muted">(job Lv <%= character.character_job.level %>)</span></p>
            <p><%= word("hp") %> <%= character.current_hp %>/<%= character.stats["max_hp"] %> · <%= word("mp") %> <%= character.current_mp %>/<%= character.stats["max_mp"] %></p>
            <% if character.motive %><p class="motive motive--card"><%= character.motive %></p><% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>

<%= render "campaigns/invite", campaign: @campaign if can_gm?(@campaign) %>

<section>
  <div class="book-header">
    <h2>Cast</h2>
    <%= link_to "New NPC", new_campaign_npc_path(@campaign), class: "button button--quiet" if can_gm?(@campaign) %>
  </div>
  <% npcs = @campaign.npcs.includes(portraits: { image_attachment: :blob }).order(:name) %>
  <% if npcs.empty? %>
    <p class="empty">No NPCs yet. The GM speaks as them at the table.</p>
  <% else %>
    <div class="roster-cards">
      <% npcs.each do |npc| %>
        <% card = capture do %>
          <%= speaker_portrait(npc, "neutral", size: :medium) %>
          <div>
            <h3><%= npc.name %></h3>
            <% if npc.title.present? %><p class="muted"><%= npc.title %></p><% end %>
          </div>
        <% end %>
        <%= can_gm?(@campaign) ? link_to(card, edit_npc_path(npc), class: "window character-card") : tag.div(card, class: "window character-card") %>
      <% end %>
    </div>
  <% end %>
</section>

<% if can_gm?(@campaign) && (atlas = Atlas.new(@campaign)).missing? %>
  <section class="window" id="canon">
    <h2>New in <%= @world.name %></h2>
    <p>
      The setting has <%= [ (pluralize(atlas.missing_places.count, "place") + " not on this map" if atlas.missing_places.exists?),
                            (pluralize(atlas.missing_figures.count, "person", plural: "people") + " not in this cast" if atlas.missing_figures.exists?) ].compact.to_sentence %>:
      <%= (atlas.missing_places.limit(6).map(&:name) + atlas.missing_figures.limit(6).map(&:name)).to_sentence %>.
    </p>
    <%= button_to "Bring them in", campaign_canon_path(@campaign), class: "button button--quiet" %>
  </section>
<% end %>

<div class="two-up">
  <section class="window">
    <h2>Bag</h2>
    <% bag = @campaign.bag %>
    <% if bag.empty? %>
      <p class="empty">Empty.</p>
    <% else %>
      <table class="book-table book-table--plain">
        <thead><tr><th>Item</th><th>Category</th><th class="num">Qty</th></tr></thead>
        <tbody>
          <% bag.each do |row| %>
            <tr>
              <td><%= link_to row.item.name, world_armory_item_path(@world, row.item) %></td>
              <td><%= term(row.item.category) %></td>
              <td class="num"><%= row.quantity %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
    <% if can_gm?(@campaign) %>
    <details id="add_items" data-turbo-permanent data-controller="fresh-form" data-action="turbo:submit-end->fresh-form#done">
      <summary>GM: add items</summary>
      <%= form_with url: campaign_inventories_path(@campaign), scope: :inventory, class: "book-form" do |f| %>
        <div class="field-row">
          <div class="field"><%= f.label :item_id, "Item" %><%= f.select :item_id, @world.items.order(:name).map { |i| [ i.name, i.id ] } %></div>
          <div class="field"><%= f.label :quantity %><%= f.number_field :quantity, value: 1, min: 1, max: 99 %></div>
        </div>
        <%= f.submit "Add to bag", class: "button" %>
      <% end %>
    </details>
    <% end %>
  </section>

  <section class="window">
    <h2>Battles</h2>
    <% if @battles.empty? %>
      <p class="empty">None yet.</p>
    <% else %>
      <ul class="refs">
        <% @battles.each do |battle| %>
          <li>
            <%= link_to battle.name, battle_path(battle) %> <span class="muted">· <%= battle.status_label %> · <%= time_ago_in_words(battle.updated_at) %> ago</span>
            <% if !battle.over? && can_gm?(@campaign) %>
              <%= button_to "Call off", battle_call_off_path(battle), class: "link-button", form: { class: "inline", data: { turbo_confirm: "Call off #{battle.name}? Nothing that happened in it counts." } } %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
