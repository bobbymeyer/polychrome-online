<% content_for :title, @campaign.name %>
<%= render "shared/stage_stream", campaign: @campaign %>
<div class="crumbs"><%= link_to @world.name, world_path(@world) %> / Campaign</div>
<div class="book-header">
  <div>
    <h1><%= @campaign.name %></h1>
    <p class="muted"><%= number_with_delimiter(@campaign.gil) %> gil</p>
  </div>
  <div class="actions">
    <%= link_to "Open the table", campaign_table_path(@campaign), class: "button" %>
    <%= link_to "Map", campaign_map_path(@campaign), class: "button button--quiet" %>
    <% if can_gm?(@campaign) %>
    <%= link_to "New battle", new_campaign_battle_path(@campaign), class: "button button--quiet" %>
    <%= button_to "Rest at an inn", campaign_rest_path(@campaign), class: "button button--quiet",
                  form: { data: { turbo_confirm: "Restore everyone to full HP and MP?" } } %>
    <%= link_to "Edit", edit_campaign_path(@campaign), class: "button button--quiet" %>
    <% end %>
  </div>
</div>

<section>
  <div class="book-header">
    <h2>Party</h2>
    <%= link_to "New character", new_campaign_character_path(@campaign), class: "button button--quiet" %>
  </div>
  <% if @characters.empty? %>
    <p class="empty">No characters yet.</p>
  <% else %>
    <div class="roster-cards">
      <% @characters.each do |character| %>
        <%= link_to character_path(character), class: "window character-card #{'is-ko' unless character.conscious?}" do %>
          <%= entry_portrait(character.job, size: :small) %>
          <div>
            <h3><%= character.name %></h3>
            <p class="muted">
              <% if character.user_id == current_user.id %>
                <strong>You</strong>
              <% elsif character.user %>
                Played by <%= character.user.name %>
              <% else %>
                Unclaimed: sit as them at the table to play them
              <% end %>
            </p>
            <p>Lv <%= character.level %> <%= character.job.name %> <span class="muted">(job Lv <%= character.character_job.level %>)</span></p>
            <p>HP <%= character.current_hp %>/<%= character.stats["max_hp"] %> · MP <%= character.current_mp %>/<%= character.stats["max_mp"] %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>

<section>
  <div class="book-header">
    <h2>Cast</h2>
    <%= link_to "New NPC", new_campaign_npc_path(@campaign), class: "button button--quiet" if can_gm?(@campaign) %>
  </div>
  <% npcs = @campaign.npcs.order(:name) %>
  <% if npcs.empty? %>
    <p class="empty">No NPCs yet. The GM speaks as them at the table.</p>
  <% else %>
    <div class="roster-cards">
      <% npcs.each do |npc| %>
        <% card = capture do %>
          <%= speaker_portrait(npc, "neutral", size: :medium) %>
          <div>
            <h3><%= npc.name %></h3>
            <% if npc.title.present? %><p class="muted"><%= npc.title %></p><% end %>
          </div>
        <% end %>
        <%= can_gm?(@campaign) ? link_to(card, edit_npc_path(npc), class: "window character-card") : tag.div(card, class: "window character-card") %>
      <% end %>
    </div>
  <% end %>
</section>

<% if table_gm? %>
  <section class="window" id="flags">
    <div class="book-header">
      <h2>Flags</h2>
      <% changes = @campaign.locations.sum { |location| location.changes.size } %>
      <%= link_to "GM changes to locations (#{changes})", campaign_changes_path(@campaign), class: "button button--quiet" %>
    </div>
    <p class="hint">The GM's campaign state. Public flags show at the table as what the party knows; the rest are yours alone.</p>
    <% flags = @campaign.flags.order(:key) %>
    <% if flags.any? %>
      <table class="book-table book-table--plain flag-table">
        <thead><tr><th>Flag</th><th>Value</th><th>Seen by</th><th></th></tr></thead>
        <tbody>
          <% flags.each do |flag| %>
            <tr>
              <td><code><%= flag.key %></code><% if flag.note.present? %><br><span class="muted"><%= flag.note %></span><% end %></td>
              <td>
                <%= form_with model: flag, url: campaign_flag_path(@campaign, flag), class: "inline-form flag-value" do |f| %>
                  <%= f.text_field :value, id: "flag_#{flag.id}_value", "aria-label": "Value of #{flag.key}" %>
                  <%= f.submit "Save", class: "button button--quiet" %>
                <% end %>
              </td>
              <td><%= flag.public? ? "Everyone" : "GM" %></td>
              <td>
                <div class="flag-tools">
                <% if flag.counter? %>
                  <%= button_to "−1", bump_campaign_flag_path(@campaign, flag), params: { by: -1 }, class: "pin", "aria-label": "Decrease #{flag.key}" %>
                  <%= button_to "+1", bump_campaign_flag_path(@campaign, flag), params: { by: 1 }, class: "pin", "aria-label": "Increase #{flag.key}" %>
                <% end %>
                <%= button_to "Clear", campaign_flag_path(@campaign, flag), method: :delete, class: "link-button" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="empty">No flags yet.</p>
    <% end %>
    <%= form_with model: Flag.new, url: campaign_flags_path(@campaign), class: "book-form inline-form" do |f| %>
      <div class="field"><%= f.label :key, "New flag" %><%= f.text_field :key, placeholder: "met_the_king", required: true %></div>
      <div class="field"><%= f.label :value %><%= f.text_field :value, placeholder: "yes, 2, the old road…" %></div>
      <div class="field"><%= f.label :note %><%= f.text_field :note, placeholder: "optional" %></div>
      <div class="field field--check"><%= f.check_box :public %><%= f.label :public, "Players see it" %></div>
      <%= f.submit "Set flag", class: "button" %>
    <% end %>
  </section>
<% end %>

<div class="two-up">
  <section class="window">
    <h2>Bag</h2>
    <% bag = @campaign.bag %>
    <% if bag.empty? %>
      <p class="empty">Empty.</p>
    <% else %>
      <table class="book-table book-table--plain">
        <thead><tr><th>Item</th><th>Category</th><th class="num">Qty</th></tr></thead>
        <tbody>
          <% bag.each do |row| %>
            <tr>
              <td><%= link_to row.item.name, world_armory_item_path(@world, row.item) %></td>
              <td><%= term(row.item.category) %></td>
              <td class="num"><%= row.quantity %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
    <% if can_gm?(@campaign) %>
    <details>
      <summary>GM: add items</summary>
      <%= form_with url: campaign_inventories_path(@campaign), scope: :inventory, class: "book-form" do |f| %>
        <div class="field-row">
          <div class="field"><%= f.label :item_id, "Item" %><%= f.select :item_id, @world.items.order(:name).map { |i| [ i.name, i.id ] } %></div>
          <div class="field"><%= f.label :quantity %><%= f.number_field :quantity, value: 1, min: 1, max: 99 %></div>
        </div>
        <%= f.submit "Add to bag", class: "button" %>
      <% end %>
    </details>
    <% end %>
  </section>

  <section class="window">
    <h2>Battles</h2>
    <% if @battles.empty? %>
      <p class="empty">None yet.</p>
    <% else %>
      <ul class="refs">
        <% @battles.each do |battle| %>
          <li>
            <%= link_to battle.name, battle_path(battle) %> <span class="muted">· <%= battle.status_label %> · <%= time_ago_in_words(battle.updated_at) %> ago</span>
            <% if !battle.over? && can_gm?(@campaign) %>
              <%= button_to "Call off", call_off_battle_path(battle), class: "link-button", form: { class: "inline", data: { turbo_confirm: "Call off #{battle.name}? Nothing that happened in it counts." } } %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
