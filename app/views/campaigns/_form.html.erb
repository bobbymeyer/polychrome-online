<%= form_with model: campaign, url: campaign.persisted? ? campaign_path(campaign) : world_campaigns_path(@world), class: "book-form" do |f| %>
  <%= render "book_entries/errors", entry: campaign %>
  <div class="field-row">
    <div class="field"><%= f.label :name %><%= f.text_field :name, required: true %></div>
    <% if campaign.persisted? %>
      <div class="field"><%= f.label :gil, "Party gil" %><%= f.number_field :gil, min: 0 %></div>
      <% if admin? %>
        <div class="field">
          <%= f.label :gm_id, "GM" %>
          <%= f.select :gm_id, User.alphabetical.map { |u| [ u.name, u.id ] }, include_blank: "Nobody (admins run it)" %>
        </div>
      <% end %>
    <% end %>
  </div>
  <% chosen = campaign.open_jobs %>
  <fieldset class="panel">
    <legend>Jobs open from the start</legend>
    <p class="hint">The rest are yours to grant at the table, as story rewards: a crystal shatters, a master takes them on.</p>
    <label class="inline"><%= check_box_tag "campaign[every_job]", "1", chosen.nil?, id: "campaign_every_job" %> <strong>Every job</strong> (nothing to grant)</label>
    <div class="checks">
      <%= hidden_field_tag "campaign[open_jobs][]", "", id: nil %>
      <% @world.jobs.alphabetical.each do |job| %>
        <label><%= check_box_tag "campaign[open_jobs][]", job.slug, chosen.nil? || chosen.include?(job.slug), id: "campaign_open_job_#{job.slug}" %> <%= job.name %></label>
      <% end %>
    </div>
  </fieldset>
  <div class="actions">
    <%= f.submit class: "button" %>
    <%= link_to "Cancel", campaign.persisted? ? campaign_path(campaign) : world_path(@world), class: "button button--quiet" %>
  </div>
<% end %>
