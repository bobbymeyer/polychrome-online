<% content_for :title, "#{@campaign.name} · Map" %>
<% content_for :head, music_meta(@campaign, @campaign.scene) %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<div class="crumbs"><%= link_to @campaign.name, campaign_path(@campaign) %> / Map</div>
<div class="book-header">
  <h1>Map</h1>
  <%= link_to "Open the table", campaign_table_path(@campaign), class: "button button--quiet" %>
</div>

<%= turbo_stream_from @campaign, (@gm ? :gm : :players) %>
<%= render "shared/stage_stream", campaign: @campaign %>
<div class="map-layout" <% if @gm %>data-controller="map-editor" data-map-editor-new-url-value="<%= new_campaign_map_node_path(@campaign) %>"<% end %>>
  <div class="window map-window">
    <%= render "campaigns/maps/canvas", campaign: @campaign, gm: @gm %>
    <%# Inside a dungeon, its floorplan too: every room for the GM, what they've seen for players (replaced live). %>
    <%= render "campaigns/tables/floorplan", campaign: @campaign, gm: @gm %>
  </div>
  <% if @gm %>
    <%= turbo_frame_tag "map_panel", src: campaign_map_panel_path(@campaign), class: "map-panel" do %>
      <div class="window"><p class="muted">Loading…</p></div>
    <% end %>
  <% else %>
    <aside class="window map-panel">
      <h2>Where are we?</h2>
      <%= render "campaigns/tables/time", campaign: @campaign %>
      <p><%= @campaign.current_node ? "The party is at #{@campaign.current_node.name}." : "The journey hasn't started." %></p>
      <% if @campaign.current_node&.description.present? %><p class="prose"><%= @campaign.current_node.description %></p><% end %>
      <% places = @campaign.map_nodes.where(visible: true).where.not(location_id: nil).includes(:location).order(:name) %>
      <% if places.any? %>
        <h3>Places</h3>
        <ul class="refs">
          <% places.each do |node| %><li><%= link_to node.location.name, location_path(node.location) %></li><% end %>
        </ul>
      <% end %>
      <%= render "campaigns/maps/legend" %>
      <p class="hint"><%= can_gm?(@campaign) ? "Sit at the table as GM to edit the map and move the party." : safe_join([ "Say where you'd go under “Where next?” at ", link_to("the table", campaign_table_path(@campaign)), ": it goes to a vote, and the GM settles it." ]) %></p>
    </aside>
  <% end %>
</div>
