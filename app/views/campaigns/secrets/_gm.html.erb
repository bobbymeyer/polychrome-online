<%# The GM's secrets and clues (Secret): reveal them as the party gets there, write new ones. Replaced live as they change. %>
<% kept = campaign.secrets.kept.includes({ location: Location::ROLLING }, :npc, :rumour).order(:created_at, :id) %>
<% revealed = campaign.secrets.revealed.includes({ location: Location::ROLLING }, :npc).order(:revealed_at) %>
<div id="gm_secrets" class="gm-secrets">
  <% if kept.any? %>
    <ul class="secret-rows">
      <% kept.each do |secret| %>
        <li>
          <div>
            <%= secret.body %>
            <% if secret.about %><span class="muted"> · <%= secret.about %></span><% end %>
            <% if secret.rumour %><span class="muted"> · got out: it's going round as a rumour (the party knows it once they hear it)</span><% end %>
          </div>
          <div class="flag-tools">
            <%= button_to "Reveal", campaign_secret_revelation_path(campaign, secret), class: "button button--quiet" %>
            <%= button_to "Strike", campaign_secret_path(campaign, secret), method: :delete, class: "link-button",
                          form: { data: { turbo_confirm: "Strike this secret out?" } } %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty">No secrets waiting. Write down things that are true, and let the party find them however they do.</p>
  <% end %>

  <% if revealed.any? %>
    <details>
      <summary>The party knows (<%= revealed.size %>)</summary>
      <ul class="secret-rows">
        <% revealed.each do |secret| %>
          <li class="is-revealed">
            <div><%= secret.body %><span class="muted"> · <%= secret.revealed_by || "told" %>, <%= time_ago_in_words(secret.revealed_at) %> ago</span></div>
            <%= button_to "Put back", campaign_secret_revelation_path(campaign, secret), method: :delete, class: "link-button" %>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>

  <details id="new_secret" data-turbo-permanent data-controller="fresh-form" data-action="turbo:submit-end->fresh-form#done">
    <summary>New secret</summary>
    <%= form_with model: Secret.new, url: campaign_secrets_path(campaign), class: "book-form" do |f| %>
      <div class="field"><%= f.label :body, "What's true", for: "secret_body_#{campaign.id}" %><%= f.text_area :body, rows: 2, id: "secret_body_#{campaign.id}", placeholder: "The mayor pays the goblins to raid the east road.", required: true %></div>
      <div class="field-row">
        <% places = campaign.map_nodes.includes(:location).order(:name).select(&:location).map { |n| [ n.name, n.location.id ] } %>
        <div class="field"><%= f.label :location_id, "About a place", for: "secret_location_#{campaign.id}" %><%= f.select :location_id, places, { include_blank: "Anywhere" }, id: "secret_location_#{campaign.id}" %></div>
        <div class="field"><%= f.label :npc_id, "About someone", for: "secret_npc_#{campaign.id}" %><%= f.select :npc_id, campaign.npcs.order(:name).map { |n| [ n.name, n.id ] }, { include_blank: "No one" }, id: "secret_npc_#{campaign.id}" %></div>
      </div>
      <%= f.submit "Keep it", class: "button" %>
    <% end %>
  </details>
</div>
