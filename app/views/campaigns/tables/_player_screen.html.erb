<%# A player's screen (docs/DESIGN.md, "The Stage"): who you are, then what's going on, then what you can do,
    then what you look up. On a wide screen: you and what you look up on the left edge, the stage in the middle
    with your moves along its bottom, the log on the right edge, each pinned or folded away (stage.css); on a
    phone, one column. %>
<% character = @seat.character %>
<div class="player-screen" data-controller="pinnable" data-pinnable-key-value="polychrome.youPinned">
  <%# On a wide screen, unpinned, the left column slides out from this tab. %>
  <button type="button" class="player-screen__tab" data-action="pinnable#toggle" aria-controls="player_side">You</button>
  <aside class="player-screen__side" id="player_side" aria-label="You, and what you look up">
  <section class="player-screen__card window" aria-label="You">
    <button type="button" class="button button--quiet player-screen__pin" data-pinnable-target="pin" data-action="pinnable#togglePin"
            aria-pressed="false" title="Keep this column open beside the page">Pin</button>
    <%= speaker_portrait(character, "neutral", size: :medium) %>
    <div>
      <p class="player-screen__label">You</p>
      <h2 class="player-screen__name"><%= character.name %></h2>
      <p class="muted">Lv <%= character.level %> <%= character.job.name %></p>
      <%# Kept in step with your row in the party panel, which the table's broadcasts replace. %>
      <div class="table-you" data-controller="mirror" data-mirror-from-value="#table_party [data-character='<%= character.id %>'] .vitals">
        <div data-mirror-target="slot"><%= render "campaigns/tables/vitals", character: character, copy: true %></div>
      </div>
      <%= link_to "My sheet →", character_path(character), class: "player-screen__sheet" %>
    </div>
  </section>
  <%# Not what you do, but what you look up: one at a time. On a wide screen it's under you, the party open (the map is on the stage). %>
  <div class="drawers player-screen__lookup" data-controller="drawers" data-drawers-wide-value="party">
    <div class="drawers__tabs" role="group" aria-label="Look up">
      <% { "party" => "Party", "knows" => "What we know" }.each do |key, label| %>
        <%= tag.button label, type: "button", class: "drawers__tab drawers__tab--#{key}", aria: { expanded: false, controls: "drawer_#{key}" },
                              data: { drawers_target: "tab", key: key, action: "drawers#toggle" } %>
      <% end %>
    </div>
    <div id="drawer_party" class="drawers__panel" hidden data-drawers-target="panel" data-key="party"><%= render "campaigns/tables/party", campaign: @campaign %></div>
    <div id="drawer_knows" class="drawers__panel" hidden data-drawers-target="panel" data-key="knows"><%= render "campaigns/tables/party_knows", campaign: @campaign, gm: false %></div>
  </div>
  </aside>

  <div class="player-screen__context">
    <header class="battle__header">
      <div>
        <p class="eyebrow"><%= link_to @campaign.name, campaign_path(@campaign) %> · Table</p>
        <h1><%= @campaign.name %></h1>
      </div>
    </header>
    <%= render "campaigns/tables/now", campaign: @campaign, gm: false %>
    <%= render "campaigns/tables/stage", campaign: @campaign, gm: false, last_dialogue: @last_dialogue %>
    <section class="recent-lines" aria-label="Just said" hidden data-controller="recent-lines"
             data-recent-lines-seat-value="<%= character.name %>" data-recent-lines-count-value="4">
      <ol data-recent-lines-target="list"></ol>
    </section>
  </div>

  <%# Your actions: what you can do now. On a wide screen a drawer along the bottom of the scene, pinned there
      (kept in view as the page scrolls) or folded to its bar. %>
  <section class="your-moves player-screen__moves" aria-label="Your moves" data-controller="pinnable" data-pinnable-key-value="polychrome.actionsPinned">
    <div class="player-screen__moves-bar">
      <button type="button" class="your-moves__tag" data-action="pinnable#toggle">Your moves</button>
      <button type="button" class="button button--quiet player-screen__pin" data-pinnable-target="pin" data-action="pinnable#togglePin"
              aria-pressed="false" title="Keep your moves open along the bottom">Pin</button>
    </div>
    <div class="player-screen__moves-body">
    <%= render "choices/panel", choice: @campaign.open_choice %>
    <%= render "campaigns/tables/ways", campaign: @campaign, gm: false %>
    <%= render "campaigns/field_uses/ability", character: character %>
    <details class="talk">
      <summary class="button button--quiet">Say something</summary>
      <%= turbo_frame_tag "composer", src: campaign_composer_path(@campaign) do %>
        <div class="window"><p class="muted">Loading…</p></div>
      <% end %>
    </details>
    </div>
  </section>
</div>
