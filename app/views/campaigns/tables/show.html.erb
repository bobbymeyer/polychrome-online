<% content_for :title, "#{@campaign.name} · Table" %>
<% content_for :head, music_meta(@campaign, @campaign.scene) %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<% view = coop_view %>
<%# The recap is the top bar's; the seat is in the account menu (the table itself is the three columns). %>
<% if !view && @recap %>
  <% content_for :table_menu do %>
    <%= link_to "Previously on…", campaign_table_path(@campaign, recap: 1) %>
  <% end %>
<% end %>
<%# The table (docs/DESIGN.md, "The Stage"): three columns on a wide screen. Left, who's here: you (a player's
    card) and the party, what it knows. Middle, the Stage, and under it the Controls: the Now line, then what
    this seat can do (a player's moves; the GM's tools in their place). Right, the log. On a phone, one column:
    you, the stage, the controls, the party. %>
<div class="table<%= " table--#{view}" if view %>" data-controller="dialogue recap moment whisper-toast<%= " heartbeat" if @seat.character? %><%= " table-views" unless view %>" <%= tag.attributes(data: { heartbeat_url_value: (campaign_presence_path(@campaign) if @seat.character?), whisper_toast_seat_value: @seat.character&.name, table_views_key_value: (@campaign.id unless view) }) %> <%= tag.attributes(data: { seat: (@seat.gm? ? "gm" : ("player" if @seat.character?)), seat_character: @seat.character&.id }) %> data-action="chat-line:arrived->dialogue#arrive chat-line:arrived->moment#arrive chat-line:arrived->whisper-toast#arrive turbo:before-stream-render@document->dialogue#streamed keydown@window->dialogue#key"
     data-recap-campaign-value="<%= @campaign.id %>" data-recap-auto-value="<%= @recap&.ended? || false %>" data-recap-asked-value="<%= params[:recap].present? %>">
  <%= render "campaigns/tables/recap", recap: @recap if @recap %>
  <%= render "campaigns/tables/cards" %>
  <%# Streams are signed per seat: whispers only reach the GM and the character involved. %>
  <%= seat_streams_from @seat, @campaign %>
  <%= render "shared/stage_stream", campaign: @campaign %>

  <% if view == "stage" %>
    <%# Nothing but the Stage, for a TV or a stream: the lines still land here, unseen, so the moments they
        cue (a check landing, an awakening, an arrival) play on it. %>
    <%= render "campaigns/tables/stage", campaign: @campaign, gm: false, last_dialogue: @last_dialogue, caption: false %>
    <div hidden><%= render "campaigns/tables/chat_log", messages: @messages, seat: @seat %></div>
    <%= link_to "Leave the stage", campaign_table_path(@campaign, view: "off"), class: "stage-leave" %>
  <% else %>
  <% unless view %>
    <%# On a phone the three columns are three views (table_views_controller): a thin strip under the top bar picks
        one. Wider, the strip is hidden and all three show (stage.css). %>
    <nav class="table-views" aria-label="Table views">
      <% { "party" => (@seat.character? ? "You & party" : "Party"), "stage" => "Stage", "log" => "Log" }.each do |key, label| %>
        <%= tag.button type: "button", class: "table-views__tab", aria: { current: "false" }, data: { table_views_target: "tab", key: key, action: "table-views#pick" } do %>
          <%= label %><% if key == "log" %> <span class="table-views__badge" data-table-views-target="badge" hidden></span><% end %>
        <% end %>
      <% end %>
    </nav>
  <% end %>
  <% if view == "controller" %>
    <%# This device was made a controller (a phone's view) and stays one until told otherwise: say so, up top. %>
    <p class="coop-banner">This device is a <strong>controller</strong>: your part, without the show.
      <%= link_to "Leave controller view", campaign_table_path(@campaign, view: "off") %></p>
  <% end %>
  <div class="table__main">
    <%# Left: who's here. A player first (their card, kept in step with the party panel), then the party and
        what it knows, one at a time (the map is on the stage). %>
    <aside class="table__side" aria-label="You and the party">
      <% if (character = @seat.character) && view != "screen" %>
        <section class="player-card window" aria-label="You">
          <%= speaker_portrait(character, "neutral", size: :medium) %>
          <div>
            <p class="player-card__label">You</p>
            <h2 class="player-card__name"><%= character.name %></h2>
            <p class="muted">Lv <%= character.level %> <%= character.job.name %></p>
            <% if character.motive.present? %><p class="motive motive--card"><%= character.motive %></p><% end %>
            <div class="table-you" data-controller="mirror" data-mirror-from-value="#table_party [data-character='<%= character.id %>'] .vitals">
              <div data-mirror-target="slot"><%= render "campaigns/tables/vitals", character: character, copy: true %></div>
            </div>
            <%= link_to "My sheet →", character_path(character), class: "player-card__sheet" %>
          </div>
        </section>
      <% end %>
      <% if view == "screen" %>
        <%= render "campaigns/tables/party", campaign: @campaign %>
      <% else %>
        <div class="drawers" data-controller="drawers" data-drawers-wide-value="party">
          <div class="drawers__tabs" role="group" aria-label="Look up">
            <% { "party" => "Party", "knows" => (@seat.gm? ? "What they know" : "What we know") }.each do |key, label| %>
              <%= tag.button label, type: "button", class: "drawers__tab drawers__tab--#{key}", aria: { expanded: false, controls: "drawer_#{key}" },
                                    data: { drawers_target: "tab", key: key, action: "drawers#toggle" } %>
            <% end %>
          </div>
          <div id="drawer_party" class="drawers__panel" hidden data-drawers-target="panel" data-key="party"><%= render "campaigns/tables/party", campaign: @campaign, gm: @seat.gm? %></div>
          <div id="drawer_knows" class="drawers__panel" hidden data-drawers-target="panel" data-key="knows"><%= render "campaigns/tables/party_knows", campaign: @campaign, gm: @seat.gm? %><%= render "campaigns/tables/limits", campaign: @campaign %></div>
        </div>
      <% end %>
    </aside>

    <div class="table__stage" data-controller="column-scroll" data-action="wheel->column-scroll#wheel:passive">
    <%# The Stage first, sacred: nothing above it, and what's under it scrolls on its own (stage.css); a wheel
        anywhere in the column scrolls it (column_scroll_controller). %>
    <% unless view == "controller" %>
    <%= render "campaigns/tables/stage", campaign: @campaign, gm: @seat.gm?, last_dialogue: @last_dialogue %>
    <% end %>
    <div class="table__under" data-column-scroll-target="under">
      <% if view == "controller" %>
        <%# A phone controller has no stage: your name, your vitals and the date sit in its head. %>
        <header class="battle__header">
          <div>
            <p class="eyebrow"><%= link_to @campaign.name, campaign_path(@campaign) %> · Controller</p>
            <h1><%= @seat.character? ? @seat.name : @campaign.name %></h1>
            <%= render "campaigns/tables/vitals", character: @seat.character if @seat.character? %>
          </div>
          <%= render "campaigns/tables/time", campaign: @campaign %>
        </header>
      <% end %>
      <%# The Controls: what's happening now, then what this seat does about it. %>
      <section class="table-controls" aria-label="Controls">
        <%= render "campaigns/tables/now", campaign: @campaign, gm: @seat.gm? %>
        <%# The door: with no seat, the way in comes before anything else. %>
        <%= render "campaigns/tables/take_a_seat", campaign: @campaign if !@seat.seated? && view != "screen" %>
        <% if @seat.gm? && view != "screen" %>
          <%# What needs the GM's answer first, then the rest of their tools behind "GM tools" (what they call is in the row). %>
          <%= render "campaigns/tables/gm/tools", campaign: @campaign, view: view %>
        <% end %>
        <%= tag.section(class: "your-moves", aria: { label: "Your moves" }) do %>
          <% if @seat.character? %><p class="your-moves__tag">Your moves</p><% end %>
          <%= render "choices/panel", choice: @campaign.open_choice %>
          <%= render "campaigns/tables/ways", campaign: @campaign, gm: @seat.gm? unless view == "screen" %>
          <%= render "campaigns/tables/called", campaign: @campaign, gm: @seat.gm? unless view == "screen" %>
          <%= render "campaigns/field_uses/ability", character: @seat.character if @seat.character? %>
          <% if @seat.seated? && !view %>
            <%# The talk box: here only while the GM has called Talk (#table_now data-controls, stage.css). %>
            <div class="table-talk">
              <% if @seat.gm? %>
                <%= turbo_frame_tag "composer", src: campaign_composer_path(@campaign) do %>
                  <div class="window"><p class="muted">Loading…</p></div>
                <% end %>
              <% else %>
                <details class="talk">
                  <summary class="button button--quiet">Say something</summary>
                  <%= turbo_frame_tag "composer", src: campaign_composer_path(@campaign) do %>
                    <div class="window"><p class="muted">Loading…</p></div>
                  <% end %>
                </details>
              <% end %>
            </div>
          <% end %>
        <% end %>
        <% if view == "screen" %>
          <p class="hint coop-leave"><%= link_to "Leave the shared screen", campaign_table_path(@campaign, view: "off") %></p>
        <% elsif @seat.seated? && view == "controller" %>
          <p class="coop-links">
            <%= link_to "My sheet", character_path(@seat.character), class: "button button--quiet" if @seat.character? %>
            <%= link_to "Leave controller view", campaign_table_path(@campaign, view: "off"), class: "link-button" %>
          </p>
        <% end %>
      </section>
    </div>
    </div>
  </div>

  <%# Right: the log. A column on a wide screen (pinned there unless unpinned), a drawer otherwise. %>
  <%= render layout: "shared/log_drawer", locals: { self_name: @seat&.character&.name, dockable: @seat&.gm?, wide: @seat.character? && view.nil? } do %>
    <%= render "campaigns/tables/chat_log", messages: @messages, seat: @seat %>
  <% end %>
  <% end %>
</div>
