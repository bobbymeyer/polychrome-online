<% content_for :title, "#{@campaign.name} · Table" %>
<% content_for :head, music_meta(@campaign, @campaign.scene) %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<% view = coop_view %>
<div class="table<%= " table--#{view}" if view %>" data-controller="dialogue recap moment" <%= tag.attributes(data: { seat: (@seat.gm? ? "gm" : ("player" if @seat.character?)), seat_character: @seat.character&.id }) %> data-action="chat-line:arrived->dialogue#arrive chat-line:arrived->moment#arrive turbo:before-stream-render@document->dialogue#streamed keydown@window->dialogue#key"
     data-recap-campaign-value="<%= @campaign.id %>" data-recap-auto-value="<%= @recap&.ended? || false %>">
  <%= render "campaigns/tables/recap", recap: @recap if @recap %>
  <%= render "campaigns/tables/cards" %>
  <%# Streams are signed per seat: whispers only reach the GM and the character involved. %>
  <%= seat_streams_from @seat, @campaign %>
  <%= render "shared/stage_stream", campaign: @campaign %>

  <header class="battle__header">
    <div>
      <p class="eyebrow"><%= link_to @campaign.name, campaign_path(@campaign) %> · <%= { "screen" => "Shared screen", "controller" => "Controller" }.fetch(view, "Table") %></p>
      <h1><%= view == "controller" && @seat.character? ? @seat.name : @campaign.name %></h1>
      <% if view == "controller" && @seat.character? %>
        <%= render "campaigns/tables/vitals", character: @seat.character %>
      <% end %>
      <% if @recap %>
        <button type="button" class="link-button recap-link" data-action="recap#open">Previously on <%= @campaign.name %>…</button>
      <% end %>
    </div>
    <%= render "campaigns/tables/time", campaign: @campaign %>
    <%= render "campaigns/tables/current_battle", campaign: @campaign %>
  </header>

  <div class="table__main">
    <div class="table__stage">
    <% unless view == "controller" %>
    <%= render "campaigns/tables/dialogue_box", last_dialogue: @last_dialogue %>
    <% end %>
    <%# The last few lines said, whoever said them (on a controller, what just happened): the log drawer keeps everything. %>
    <section class="recent-lines" aria-label="Just said" hidden data-controller="recent-lines"
             data-recent-lines-seat-value="<%= @seat.character&.name %>" data-recent-lines-count-value="<%= view == "controller" ? 2 : 4 %>">
      <ol data-recent-lines-target="list"></ol>
    </section>
    <%= render "choices/panel", choice: @campaign.open_choice %>
    <%= render "campaigns/tables/ways", campaign: @campaign, gm: @seat.gm? unless view == "screen" %>
    <% if @seat.seated? && !view %>
      <%# Talk where the story is: right under it, not below the map. %>
      <%= turbo_frame_tag "composer", src: campaign_composer_path(@campaign) do %>
        <div class="window"><p class="muted">Loading…</p></div>
      <% end %>
      <%= render "campaigns/field_uses/ability", character: @seat.character if @seat.character? %>
    <% end %>
    </div>

    <div class="table__side">
    <% if view == "screen" %>
      <%= render "campaigns/tables/coop_join", campaign: @campaign %>
    <% end %>
    <% unless view == "controller" %>
    <%# Always present, even before the map has any places, so broadcasts have something to replace. %>
    <section class="window table__map" aria-label="Map">
      <%= render "campaigns/maps/canvas", campaign: @campaign, gm: @seat.gm? %>
      <p class="hint">
        <%= link_to(@seat.gm? ? "Edit the map / travel →" : "Open the map →", campaign_map_path(@campaign)) %>
        <%= render "campaigns/tables/here", campaign: @campaign %>
      </p>
    </section>
    <%= render "campaigns/tables/party", campaign: @campaign %>
    <% end %>
    <%= render "campaigns/tables/party_knows", campaign: @campaign %>
    </div>
  </div>

  <%= render layout: "shared/log_drawer", locals: { self_name: @seat&.character&.name } do %>
    <%= render "campaigns/tables/chat_log", messages: @messages, seat: @seat %>
  <% end %>

  <% if view == "screen" %>
    <p class="hint coop-leave"><%= link_to "Leave the shared screen", campaign_table_path(@campaign, view: "off") %></p>
  <% elsif @seat.seated? %>
    <% if view == "controller" %>
      <p class="coop-links">
        <%= link_to "My sheet", character_path(@seat.character), class: "button button--quiet" if @seat.character? %>
        <%= link_to "Leave controller view", campaign_table_path(@campaign, view: "off"), class: "link-button" %>
      </p>
    <% end %>
    <% if view == "controller" && @seat.character? %>
      <%= render "campaigns/field_uses/ability", character: @seat.character %>
    <% end %>
    <p class="hint">
      At the table as <strong><%= @seat.name %></strong>.
      <%= button_to "Change seat", campaign_table_seat_path(@campaign), method: :delete, class: "link-button", form: { class: "inline" } %>
    </p>
    <% if @seat.gm? %>
      <%= render "campaigns/tables/gm/recovery", campaign: @campaign %>
      <%= render "campaigns/field_uses/requests", campaign: @campaign %>
      <%= render "campaigns/tables/coop_setup", campaign: @campaign unless view %>
      <%= render "campaigns/tables/gm/time", campaign: @campaign %>
      <%= render "campaigns/tables/gm/clocks", campaign: @campaign %>
      <%= render "campaigns/tables/gm/secrets", campaign: @campaign %>
      <%= render "campaigns/tables/gm/job_grants", campaign: @campaign %>
      <%= render "campaigns/tables/gm/awakening", campaign: @campaign %>
      <%= render "campaigns/tables/gm/check", campaign: @campaign %>
      <%= render "campaigns/tables/gm/scenes", campaign: @campaign %>
      <%= render "campaigns/tables/gm/music", campaign: @campaign %>
    <% end %>
  <% else %>
    <%= render "campaigns/tables/take_a_seat", campaign: @campaign %>
  <% end %>
</div>
