<% content_for :title, "#{@campaign.name} · Table" %>
<% content_for :head, music_meta(@campaign, @campaign.scene) %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<% view = coop_view %>
<div class="table<%= " table--#{view}" if view %>" data-controller="dialogue recap" <%= tag.attributes(data: { seat: (@seat.gm? ? "gm" : ("player" if @seat.character?)), seat_character: @seat.character&.id }) %> data-action="chat-line:arrived->dialogue#arrive turbo:before-stream-render@document->dialogue#streamed keydown@window->dialogue#key"
     data-recap-campaign-value="<%= @campaign.id %>" data-recap-auto-value="<%= @recap&.ended? || false %>">
  <%= render "campaigns/tables/recap", recap: @recap if @recap %>
  <%# Streams are signed per seat: whispers only reach the GM and the character involved. %>
  <%= seat_streams_from @seat, @campaign %>
  <%= render "shared/stage_stream", campaign: @campaign %>

  <header class="battle__header">
    <div>
      <p class="eyebrow"><%= link_to @campaign.name, campaign_path(@campaign) %> · <%= { "screen" => "Shared screen", "controller" => "Controller" }.fetch(view, "Table") %></p>
      <h1><%= view == "controller" && @seat.character? ? @seat.name : @campaign.name %></h1>
      <% if view == "controller" && @seat.character? %>
        <%= render "campaigns/tables/vitals", character: @seat.character %>
      <% end %>
      <% if @recap %>
        <button type="button" class="link-button recap-link" data-action="recap#open">Previously on <%= @campaign.name %>…</button>
      <% end %>
    </div>
    <%= render "campaigns/tables/time", campaign: @campaign %>
    <%= render "campaigns/tables/current_battle", campaign: @campaign %>
  </header>

  <div class="table__main">
    <div class="table__stage">
    <% unless view == "controller" %>
    <%= render "campaigns/tables/dialogue_box", last_dialogue: @last_dialogue %>
    <% end %>
    <%# The last few lines said, whoever said them (on a controller, what just happened): the log drawer keeps everything. %>
    <section class="recent-lines" aria-label="Just said" hidden data-controller="recent-lines"
             data-recent-lines-seat-value="<%= @seat.character&.name %>" data-recent-lines-count-value="<%= view == "controller" ? 2 : 4 %>">
      <ol data-recent-lines-target="list"></ol>
    </section>
    <%= render "choices/panel", choice: @campaign.open_choice %>
    <%= render "campaigns/tables/ways", campaign: @campaign, gm: @seat.gm? unless view == "screen" %>
    <% if @seat.seated? && !view %>
      <%# Talk where the story is: right under it, not below the map. %>
      <%= turbo_frame_tag "composer", src: campaign_composer_path(@campaign) do %>
        <div class="window"><p class="muted">Loading…</p></div>
      <% end %>
      <%= render "campaigns/field_uses/ability", character: @seat.character if @seat.character? %>
    <% end %>
    </div>

    <div class="table__side">
    <% if view == "screen" %>
      <%= render "campaigns/tables/coop_join", campaign: @campaign %>
    <% end %>
    <% unless view == "controller" %>
    <%# Always present, even before the map has any places, so broadcasts have something to replace. %>
    <section class="window table__map" aria-label="Map">
      <%= render "campaigns/maps/canvas", campaign: @campaign, gm: @seat.gm? %>
      <p class="hint">
        <%= link_to(@seat.gm? ? "Edit the map / travel →" : "Open the map →", campaign_map_path(@campaign)) %>
        <%= render "campaigns/tables/here", campaign: @campaign %>
      </p>
    </section>
    <%= render "campaigns/tables/party", campaign: @campaign %>
    <% end %>
    <%= render "campaigns/tables/party_knows", campaign: @campaign %>
    </div>
  </div>

  <%= render layout: "shared/log_drawer", locals: { self_name: @seat&.character&.name } do %>
    <%= render "campaigns/tables/chat_log", messages: @messages, seat: @seat %>
  <% end %>

  <% if view == "screen" %>
    <p class="hint coop-leave"><%= link_to "Leave the shared screen", campaign_table_path(@campaign, view: "off") %></p>
  <% elsif @seat.seated? %>
    <% if view == "controller" %>
      <p class="coop-links">
        <%= link_to "My sheet", character_path(@seat.character), class: "button button--quiet" if @seat.character? %>
        <%= link_to "Leave controller view", campaign_table_path(@campaign, view: "off"), class: "link-button" %>
      </p>
    <% end %>
    <% if view == "controller" && @seat.character? %>
      <%= render "campaigns/field_uses/ability", character: @seat.character %>
    <% end %>
    <p class="hint">
      At the table as <strong><%= @seat.name %></strong>.
      <%= button_to "Change seat", campaign_table_seat_path(@campaign), method: :delete, class: "link-button", form: { class: "inline" } %>
    </p>
    <% if @seat.gm? %>
      <%= render "campaigns/recovery", campaign: @campaign if @campaign.wiped_out? && !@campaign.battle_on? %>
      <%= render "campaigns/field_uses/requests", campaign: @campaign %>
      <%= render "campaigns/tables/coop_setup", campaign: @campaign unless view %>
      <details class="window table-scenes">
        <summary>Time</summary>
        <div class="inline-form">
          <%= button_to "A part of the day passes", campaign_time_path(@campaign), method: :patch, params: { parts: 1 }, class: "button button--quiet" %>
          <%= button_to "Until dawn", campaign_time_path(@campaign), method: :patch, params: { until: "dawn" }, class: "button button--quiet" %>
          <%= form_with url: campaign_time_path(@campaign), method: :patch, class: "inline-form" do |f| %>
            <%= number_field_tag :parts, 4, min: 1, max: 28, "aria-label": "Parts of the day" %>
            <%= f.submit "Pass", class: "button button--quiet" %>
          <% end %>
        </div>
        <p class="hint">A day has four parts: dawn, day, dusk and night. Journeys take their road's time; a rest sleeps until dawn. Each new day ticks the clocks that tick on dawn.</p>
      </details>
      <details class="window table-scenes" <%= "open" if @campaign.clocks.running.exists? %>>
        <summary>Clocks</summary>
        <%= render "campaigns/clocks/gm", campaign: @campaign %>
      </details>
      <details class="window table-scenes">
        <summary>Secrets</summary>
        <%= render "campaigns/secrets/gm", campaign: @campaign %>
      </details>
      <% locked = @campaign.locked_jobs.to_a %>
      <% if locked.any? %>
        <details class="window table-scenes">
          <summary>Grant jobs</summary>
          <%= form_with url: campaign_job_grants_path(@campaign), class: "book-form" do |f| %>
            <div class="checks">
              <% locked.each do |job| %>
                <label><%= check_box_tag "jobs[]", job.slug, false, id: "grant_#{job.slug}" %> <%= job.name %></label>
              <% end %>
            </div>
            <div class="field"><%= label_tag :line, "The moment" %><%= text_field_tag :line, nil, placeholder: "The old master finally nods, and shows you how." %></div>
            <%= f.submit "Grant", class: "button play" %>
          <% end %>
        </details>
      <% end %>
      <details class="window table-scenes">
        <summary>Call for a check</summary>
        <%= form_with url: campaign_checks_path(@campaign), scope: :check, class: "book-form check-form" do |f| %>
          <fieldset class="field">
            <legend>Who tries</legend>
            <% @campaign.characters.includes(:job, :character_jobs, equipment_slots: :item).order(:created_at).select(&:conscious?).each do |character| %>
              <label class="inline"><%= check_box_tag "check[characters][]", character.id, false, id: "check_character_#{character.id}" %> <%= character.name %></label>
            <% end %>
          </fieldset>
          <div class="field-row">
            <div class="field"><%= f.label :stat, "Roll" %><%= f.select :stat, check_options(@campaign.world) %></div>
            <div class="field"><%= f.label :difficulty %><%= f.select :difficulty, Stats::Check::DIFFICULTIES.keys.map { |d| [ d.capitalize, d ] }, selected: "normal" %></div>
            <div class="field"><%= f.label :reason, "To…" %><%= f.text_field :reason, placeholder: "scale the wall" %></div>
          </div>
          <p class="hint">Each rolls against their own stat (a skill uses its stat, and a job good at it adds +<%= Job::SKILL_BONUS %>). At Normal, someone typical for their level has an even chance; nothing is ever certain.</p>
          <%= f.submit "Roll", class: "button play" %>
        <% end %>
      </details>
      <details class="window table-scenes" <%= "open" if @campaign.scenes.where(played_at: nil).exists? %>>
        <summary>Scenes</summary>
        <%= render "scenes/list", campaign: @campaign, play: true %>
        <%= link_to "New scene", new_campaign_scene_path(@campaign), class: "button button--quiet" %>
      </details>
      <%= form_with url: campaign_music_path(@campaign), method: :patch, class: "music-switch", data: { controller: "autosubmit" } do %>
        <%= label_tag :music, "Music for the table" %>
        <%= select_tag :music, options_for_select([ [ "Follow the scene (#{@campaign.scene})", "" ] ] +
                                 Campaign::MUSIC_CHOICES.map { |c| [ c.capitalize + (c == "silence" || @campaign.world.music_track(c) ? "" : " (no track)"), c ] }, @campaign.music),
                       data: { action: "autosubmit#submit" } %>
        <noscript><%= submit_tag "Play", class: "button button--quiet" %></noscript>
      <% end %>
    <% end %>
  <% else %>
    <section class="window">
      <h2>Take a seat</h2>
      <p class="hint">Sit as your character, or as the GM if this is your campaign. A character nobody has claimed becomes yours when you sit as them.</p>
      <div class="menu" data-controller="menu" data-menu-primary-value="true">
        <%= button_to "Game Master", campaign_table_seat_path(@campaign), params: { seat: "gm" }, class: "menu__item" if can_gm?(@campaign) %>
        <% @campaign.characters.order(:created_at).select { |c| can_play?(c) }.each do |character| %>
          <%= button_to character.name + (character.user_id ? "" : " (unclaimed)"), campaign_table_seat_path(@campaign),
                        params: { seat: character.id }, class: "menu__item" %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
