<%# Where the party is, and the way in: replaced live when they travel (Campaign#table_changed), so it never points at the last place. %>
<span id="table_here">
  <% if (here = campaign.current_node&.location) %>
    · <%= link_to "#{here.dungeon? ? 'Explore' : 'Visit'} #{here.name} →", location_path(here) %>
  <% end %>
</span>
