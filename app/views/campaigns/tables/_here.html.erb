<%# The way into the place the party is at (its page: services, rooms), while the table is free. Replaced live
    when they travel (Campaign#table_changed), so it never points at the last place. %>
<span id="table_here">
  <% if (here = campaign.current_node&.location) %>
    <%= link_to "#{here.dungeon? ? 'Explore' : 'Visit'} #{here.name} →", location_path(here), class: "button button--quiet" %>
  <% end %>
</span>
