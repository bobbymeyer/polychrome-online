<%# The dialogue box (§7): GM and NPC lines, typed out beside the speaker's portrait, a page at a time
    when they don't fit. At the table it shows the last line said; in battle it starts empty and appears
    when someone speaks. The × puts it away until the next line, on this browser even across a reload (it
    carries its campaign and the last line's id to know which). A refresh leaves it as it is (data-turbo-permanent). %>
<% last = local_assigns[:last_dialogue] %>
<%# scope: the page's (the table, or one battle), so a scene's last box doesn't ride into the fight it starts. %>
<section id="dialogue_box_<%= local_assigns.fetch(:scope, "page") %>" data-turbo-permanent class="<%= [ "dialogue window", local_assigns[:extra], ("is-narration" if last && !last.speaker) ].compact.join(" ") %>" data-dialogue-target="box" data-action="click->dialogue#advance"
         <%= tag.attributes(data: { dialogue_campaign: local_assigns[:campaign]&.id, dialogue_last_id: last&.id }) %>
         aria-label="Dialogue" <%= "hidden" unless last %>>
  <div class="dialogue__portrait" data-dialogue-target="portrait">
    <%= speaker_portrait(last.speaker, last.expression, size: :large) if last&.speaker %>
  </div>
  <div class="dialogue__text">
    <p class="dialogue__name" data-dialogue-target="name" style="<%= plate_style(last.speaker.name, last.speaker.try(:colour)) if last&.speaker %>"><%= last&.speaker_name %></p>
    <p class="dialogue__body" data-dialogue-target="text"><%= last&.body %></p>
    <span class="dialogue__more" data-dialogue-target="more" hidden></span>
  </div>
  <button type="button" class="dialogue__close" data-action="dialogue#dismiss:stop" aria-label="Dismiss the dialogue">×</button>
  <p class="visually-hidden" aria-live="polite" data-dialogue-target="live"></p>
</section>
