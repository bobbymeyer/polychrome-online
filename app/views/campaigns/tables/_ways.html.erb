<%# Where the party can go from here (Campaign::Ways): players suggest a way (it goes to a vote in the choice panel);
    the GM can put it to the table or just go, and calls a waiting encounter here too. Replaced live, for each audience. %>
<% choice = campaign.open_choice %>
<%# While the party votes on where next, the vote's panel has the ways: players don't get them twice.
    The GM keeps them here, to go straight there (and see what waits in a dungeon's rooms). %>
<%# A rolled encounter waits for the GM's call before anyone goes on (Campaign::Ways#take_way!). %>
<% ways = campaign.battle_on? || campaign.pending_encounter.present? || (!gm && choice&.where_next?) ? [] : campaign.ways_on %>
<%# Players are offered only what they can do now: not what the purse can't pay for, nor doors still locked. %>
<% unless gm || ways.empty? %>
  <% prices = campaign.current_node ? campaign.current_node.pastimes.to_h { |pastime| [ pastime.name, pastime.price ] } : {} %>
  <% ways = ways.reject { |way| (doing = way.dig("move", "pastime")) && prices[doing].to_i > campaign.gil } %>
<% end %>
<% locked = campaign.battle_on? || !gm ? [] : campaign.locked_ways %>
<% dungeon = !campaign.battle_on? && campaign.dungeon_in_progress %>
<% here = dungeon && dungeon.room(dungeon.progress["current"]) %>
<% treasure = here && here.dig("decision", "kind") == "treasure" && !dungeon.resolved?(here["key"]) %>
<% encounter = gm && campaign.pending_encounter %>
<% deciding = ways.any? && !gm && choice && !choice.where_next? %>
<%# While the party votes on where next, the GM's ways shrink to a row under the vote: the same
    places, but going now, without waiting for the vote (which goes with them). %>
<% voting = gm && choice&.where_next? %>
<section class="window table-ways<%= " table-ways--straight" if voting %>" id="table_ways" aria-label="Where next" <%= "hidden" if ways.empty? && !encounter && !treasure %>>
  <% if encounter %>
    <%= render "campaigns/encounters/call", campaign: campaign, encounter: encounter, return_to: campaign_table_path(campaign) %>
  <% end %>
  <% if treasure %>
    <%# Anyone at the table picks it up: it's lying right there. %>
    <p class="table-ways__treasure"><strong>There's treasure in <%= here["name"] %>.</strong>
      <%= button_to "Take it", location_treasures_path(dungeon), params: { room: here["key"], return_to: "table" }, class: "button play", form: { class: "inline", data: { turbo_frame: "_top" } } %></p>
  <% end %>
  <% if ways.any? %>
    <% if voting %>
      <h3 class="table-ways__straight">Or go straight there, without the vote</h3>
    <% else %>
      <h2>Where next?</h2>
    <% end %>
    <%# What there is to do here this part of the day (Pastime) comes first, under the time; then the roads out. %>
    <% doings, roads = ways.partition { |way| way.dig("move", "pastime") } %>
    <% [ [ doings, "#{campaign.period.upcase_first} in #{campaign.current_node&.name}" ], [ roads, (doings.any? ? "Or go" : nil) ] ].each do |group, heading| %>
    <% next if group.empty? %>
    <% if heading %><h3 class="table-ways__group"><%= heading %></h3><% end %>
    <%# Things to do here have long names ("Wait for the train that isn't there (until day, tomorrow)"): wider. %>
    <div class="menu play<%= " menu--wide" if group.equal?(doings) %>">
      <% group.each do |way| %>
        <% if gm %>
          <%# Going straight there is one click: a dangerous road or a night asks first. In a dungeon, the GM
              sees what waits in each room (players don't: they find out by going). %>
          <% room = dungeon && way.dig("move", "room") && dungeon.room(way.dig("move", "room")) %>
          <% ahead = room && (dungeon.resolved?(room["key"]) ? "done" : room.dig("decision", "kind")) %>
          <%= button_to campaign_ways_path(campaign), params: { way: way["label"], go: 1 }, class: "menu__item",
                        form: { data: { turbo_frame: "_top", turbo_confirm: ("#{way['warn']} Go now?" if way["warn"]) }.compact } do %>
            <%= way["label"] %><%= tag.span(ahead, class: "menu__cost") if ahead %>
          <% end %>
        <% else %>
          <%= button_to campaign_ways_path(campaign), params: { way: way["label"] }, class: "menu__item", disabled: deciding do %>
            <%= way["label"] %> <span class="menu__cost">suggest</span>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <% if group.equal?(doings) && (paid = campaign.payoff_preview).any? %>
      <%# Daily life pays off through the archetypes, at the next rest (Campaign::Payoffs). %>
      <p class="hint table-ways__payoff">
        At the next rest: <%= paid.join("; ") %>.
        <% if campaign.spent_parts.positive? %><strong><%= pluralize(campaign.spent_parts, "part") %> of the day spent so far.</strong><% end %>
      </p>
    <% end %>
    <% end %>
    <% if locked.any? %>
      <p class="hint">Locked: <%= locked.to_sentence %>.</p>
    <% end %>
    <% if voting %>
      <p class="hint">Going now ends the vote.</p>
    <% elsif gm %>
      <%= button_to "Put it to the table", campaign_ways_path(campaign), class: "button button--quiet" %>
      <p class="hint">Go straight there, or let the party vote: settling the vote takes them where they chose.</p>
    <% elsif deciding %>
      <p class="hint">The table is deciding something else first: settle that, then say where you'd go.</p>
    <% else %>
      <p class="hint">Say where you'd go: it goes to a vote, and the GM settles it.</p>
    <% end %>
  <% end %>
</section>
