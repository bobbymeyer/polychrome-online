<%# Where the party can go from here, or what to do here (Campaign::Ways), shown only when the GM has
    called it (Campaign::Controls): "travel" offers the roads, a dungeon's door and its rooms; "doing"
    the things to do here this part of the day; "talk" offers nothing. Then everyone sees the same ways:
    a player suggests one (it goes to the "Where next?" vote with their pick in it); the GM puts it to
    the table, asks wider, or just goes. A waiting encounter is called here too, and treasure picked up,
    whatever the controls. Replaced live, for each audience. %>
<% choice = campaign.open_choice %>
<%# A rolled encounter waits for the GM's call before anyone goes on (Campaign::Ways#take_way!). %>
<% ways = campaign.battle_on? || campaign.pending_encounter.present? ? [] : campaign.ways_offered %>
<%# While the party votes on where next, the vote's panel has the ways: players don't get them twice.
    The GM keeps them here, to go straight there (and see what waits in a dungeon's rooms). %>
<% ways = [] if !gm && choice&.where_next? %>
<%# Players are offered only what they can do now: not what the purse can't pay for, nor doors still locked. %>
<% unless gm || ways.empty? %>
  <% prices = campaign.current_node ? campaign.current_node.pastimes.to_h { |pastime| [ pastime.name, pastime.price ] } : {} %>
  <% ways = ways.reject { |way| (doing = way.dig("move", "pastime")) && prices[doing].to_i > campaign.gil } %>
<% end %>
<% locked = campaign.battle_on? || !gm || !campaign.travelling? ? [] : campaign.locked_ways %>
<% dungeon = !campaign.battle_on? && campaign.dungeon_in_progress %>
<% here = dungeon && dungeon.room(dungeon.progress["current"]) %>
<% treasure = here && here.dig("decision", "kind") == "treasure" && !dungeon.resolved?(here["key"]) %>
<% encounter = gm && campaign.pending_encounter %>
<% deciding = ways.any? && !gm && choice && !choice.where_next? %>
<%# While the party votes on where next, the GM's ways shrink to a row under the vote: the same
    places, but going now, without waiting for the vote (which goes with them). %>
<% voting = gm && choice&.where_next? %>
<%# Time passes where the day is spent: the GM's time tools sit under the things to do here (gm/_time). %>
<% timing = gm && campaign.doing? && !voting && !campaign.battle_on? %>
<section class="window table-ways<%= " table-ways--straight" if voting %>" id="table_ways" aria-label="Where next" data-controller="help" <%= "hidden" if ways.empty? && !encounter && !treasure && !timing %>>
  <% if encounter %>
    <%= render "campaigns/encounters/call", campaign: campaign, encounter: encounter, return_to: campaign_table_path(campaign) %>
  <% end %>
  <% if treasure %>
    <%# Anyone at the table picks it up: it's lying right there. %>
    <p class="table-ways__treasure"><strong>There's treasure in <%= here["name"] %>.</strong>
      <%= button_to "Take it", location_treasures_path(dungeon), params: { room: here["key"], return_to: "table" }, class: "button play", form: { class: "inline", data: { turbo_frame: "_top" } } %></p>
  <% end %>
  <% if ways.any? %>
    <%# No heading: the control pressed on the strip (Move, Do) is the title; the stage says where and when. %>
    <% if voting %>
      <p class="muted table-ways__straight">Or go straight there, without the vote</p>
    <% end %>
    <%# One way a row (pick_table_controller): the whole row presses its button. The GM's goes; a player's suggests. %>
    <table class="pick-table play" data-controller="pick-table">
      <tbody>
      <% ways.each do |way| %>
        <% room = gm && dungeon && way.dig("move", "room") && dungeon.room(way.dig("move", "room")) %>
        <% ahead = room && (dungeon.resolved?(room["key"]) ? "done" : room.dig("decision", "kind")) %>
        <tr class="pick-row" data-help="<%= gm ? (way["warn"] ? "#{way['warn']} Going asks first." : "Go straight there, now.") : "Say you'd go here: it goes to a vote, and the GM settles it." %>">
          <td class="pick-row__what">
            <% if gm %>
              <%# Going straight there is one press: a dangerous road or a night asks first. In a dungeon, the GM
                  sees what waits in each room (players don't: they find out by going). %>
              <%= button_to way["label"], campaign_ways_path(campaign), params: { way: way["label"], go: 1 }, class: "pick-row__act",
                            form: { data: { turbo_frame: "_top", turbo_confirm: ("#{way['warn']} Go now?" if way["warn"]) }.compact } %>
            <% else %>
              <%= button_to way["label"], campaign_ways_path(campaign), params: { way: way["label"] }, class: "pick-row__act", disabled: deciding %>
            <% end %>
            <%= tag.span(way["note"], class: "pick-row__note") if way["note"] %>
          </td>
          <td class="pick-row__cost"><%= gm ? ahead : "suggest" %></td>
        </tr>
      <% end %>
      </tbody>
    </table>
    <% if timing %>
      <%= render "campaigns/tables/gm/time", campaign: campaign %>
    <% end %>
    <% if campaign.doing? && (paid = campaign.payoff_preview).any? %>
      <%# Daily life pays off through the archetypes, at the next rest (Campaign::Payoffs). %>
      <p class="muted table-ways__payoff">
        At the next rest: <%= paid.join("; ") %>.
        <% if campaign.spent_parts.positive? %><strong><%= pluralize(campaign.spent_parts, "part") %> of the day spent so far.</strong><% end %>
      </p>
    <% end %>
    <% if locked.any? %>
      <p class="muted">Locked: <%= locked.to_sentence %>.</p>
    <% end %>
    <%# One help line for the panel (help_controller): the row or button under the pointer says what it does. %>
    <% if voting %>
      <%= help_line("Going now ends the vote.") %>
    <% elsif gm %>
      <%= button_to "Put it to the table", campaign_ways_path(campaign), class: "button button--quiet",
                    data: { help: "The party votes between these; settling the vote takes them where they chose." } %>
      <%= help_line("Go straight there, or put it to the table.") %>
      <%# A wider ballot (anywhere on a map, or a place pressed) is asked from the map on the stage (maps/_sheet). %>
    <% elsif deciding %>
      <%= help_line("The table is deciding something else first: settle that, then say where you'd go.") %>
    <% else %>
      <%= help_line("Say which: it goes to a vote, and the GM settles it.") %>
    <% end %>
  <% elsif timing %>
    <%= render "campaigns/tables/gm/time", campaign: campaign %>
    <%= help_line("Nothing to do here this part of the day.") %>
  <% end %>
</section>
