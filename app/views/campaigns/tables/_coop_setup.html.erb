<%# The GM's way into local co-op: one shared screen, phones as controllers. %>
<details class="window table-scenes coop-setup">
  <summary>Local co-op</summary>
  <p>Play around one shared screen: a TV at the table, or your screen shared on a call. Everyone talks out loud (or on voice chat); phones are just controllers.</p>
  <ol class="coop-setup__steps">
    <li><%= link_to "Open the shared screen", campaign_table_path(campaign, view: "screen"), class: "button play", target: "_blank", rel: "noopener" %>
      on the device that drives the TV or the stream.</li>
    <li>Players scan its QR code, or open <strong><%= join_url(campaign.join_code!) %></strong>, and pick their character. No account needed.</li>
    <li>Want your phone as a GM remote? <%= link_to "Use this device as a controller", campaign_table_path(campaign, view: "controller") %>.</li>
  </ol>
  <%= button_to "New join code", campaign_join_code_path(campaign), method: :post, class: "link-button",
                form: { data: { turbo_confirm: "Make a new code? The old QR code and link stop working." } } %>
</details>
