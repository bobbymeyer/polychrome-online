<%# The day and the part of it (Timekeeping), and the days left on the public clocks that
    only a new day ticks: the date is what the party lives by. Replaced live as time passes. %>
<% deadlines = campaign.clocks.running.shown_to_players.select { |clock| clock.triggers == [ "dawn" ] && clock.times.empty? }
                       .map { |clock| [ clock.segments - clock.filled, clock ] }.sort_by(&:first).first(3) %>
<% season_and_year = campaign.almanac.season_and_year(campaign.day) %>
<section id="table_time" class="table-time time--<%= campaign.daylight %>" aria-label="The date">
  <p class="table-time__date"><%= campaign.world.date(campaign.day) %></p>
  <% if season_and_year.present? %><p class="table-time__season"><%= season_and_year %></p><% end %>
  <p class="table-time__part"><%= campaign.period %></p>
  <% if deadlines.any? %>
    <ul class="table-time__deadlines">
      <% deadlines.each do |days, clock| %>
        <%# The last day is a red band, and on a phone it stays in view (stage.css). %>
        <li class="<%= "is-tomorrow" if days == 1 %>"><strong><%= days == 1 ? "Tomorrow" : "#{days} days" %></strong> <%= clock.name %></li>
      <% end %>
    </ul>
  <% end %>
</section>
