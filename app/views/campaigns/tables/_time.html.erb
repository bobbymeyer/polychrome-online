<%# When and where (Timekeeping), as one line: the day clock, the part of the day it points at in that
    part's colour (the clock's slice runs into the label), and the day; under it the days left on the
    public clocks that only a new day ticks. Where the party is (inside a dungeon, the room too) is its own
    tag: on the stage, the frame's top-left corner. Refreshed with the table as time passes. %>
<% deadlines = campaign.clocks.running.shown_to_players.select { |clock| clock.triggers == [ "dawn" ] && clock.times.empty? }
                       .map { |clock| [ clock.segments - clock.filled, clock ] }.sort_by(&:first).first(3) %>
<section id="table_time" class="table-time time--<%= campaign.daylight %>" aria-label="The date">
  <div class="table-time__plate">
    <div class="table-time__clock">
      <%= render "campaigns/tables/day_clock", campaign: campaign %>
      <p class="table-time__part"><%= campaign.period %></p>
      <p class="table-time__date"><%= campaign.world.date(campaign.day) %></p>
    </div>
    <% if deadlines.any? %>
      <ul class="table-time__deadlines" aria-label="Coming up">
        <% deadlines.each do |days, clock| %>
          <%# The last day is a red band, and on a phone it stays in view (stage.css). %>
          <li class="<%= "is-tomorrow" if days == 1 %>"><strong><%= days == 1 ? "Tomorrow" : "#{days} days" %></strong> <%= days == 1 ? "it happens:" : "until" %> <%= clock.name %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
  <%# Where the party is; and for the GM, the stage's Map/Place switch on the same tag, even before the party is
      anywhere, or, while a scene is on, the scene's steps; under the tag, the GM's music (campaigns/tables/_music). %>
  <% node = campaign.current_node %>
  <% if node || local_assigns[:gm] %>
  <div class="table-time__corner">
    <% dungeon = campaign.dungeon_in_progress %>
    <% room = dungeon && dungeon.current_room %>
    <div class="table-time__where">
      <% if node %>
        <span class="table-time__pin" aria-hidden="true"></span>
        <%= node.location ? link_to(node.name, location_path(node.location), data: { turbo_frame: "_top" }) : node.name %><%= tag.span(" · #{room['name']}", class: "table-time__room") if room %>
      <% end %>
      <% scene = local_assigns[:gm] ? campaign.staged_scene : nil %>
      <% beat = scene&.current_beat %>
      <% if scene && beat %>
        <%# The director's hand, while a scene is on the stage: the next beat (or the ending), play on or pause, and down. %>
        <span class="table-time__scene">
          <span class="table-time__beat" title="<%= scene.name %>"><%= beat.position + 1 %>/<%= scene.beats.size %></span>
          <% ending = { "battle" => "then the battle", "reveal" => "then #{scene.map_node&.name} appears", "mode" => "then #{scene.map_node&.name} changes" }[scene.ending] %>
          <%= button_to(scene.last_beat? ? "Finish#{", #{ending}" if ending}" : "Next", scene_play_path(scene), method: :patch, params: { go: "next" },
                        class: "table-time__view table-time__view--play", form: { class: "inline" }) %>
          <% if scene.auto? %>
            <%= button_to "Pause", scene_play_path(scene), method: :patch, params: { go: "pause" }, class: "table-time__view", form: { class: "inline" } %>
          <% elsif !scene.last_beat? && !beat.choice? %>
            <%= button_to "Play on", scene_play_path(scene), method: :patch, params: { go: "on" }, class: "table-time__view", form: { class: "inline" } %>
          <% end %>
          <%= button_to "×", scene_play_path(scene), method: :delete, class: "table-time__view", title: "Take #{scene.name} down",
                        form: { class: "inline", data: { turbo_confirm: "Take #{scene.name} off the stage without its ending?" } } %>
        </span>
      <% elsif local_assigns[:gm] && campaign.map_shown %>
        <% on_map = campaign.map_on_stage? %>
        <%= button_to (on_map ? "Place" : "Map"), campaign_map_view_path(campaign), method: :patch, params: (on_map ? { off: 1 } : {}),
                      class: "table-time__view", form: { class: "inline", data: { turbo_frame: "_top" } }, title: (on_map ? "Show the place on the stage" : "Show the map on the stage") %>
      <% end %>
    </div>
    <%= render "campaigns/tables/music", campaign: campaign, gm: local_assigns[:gm] %>
  </div>
  <% end %>
</section>
