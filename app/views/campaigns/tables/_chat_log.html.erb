<%# The table's log: every line said and everything that happened, as the seat may see it.
    data-retract says whose lines this seat may take back: the GM any line said, a player their
    own (the lines themselves are the same for everyone; chat_line_controller shows the button). %>
<% seat = local_assigns[:seat] %>
<% retract = seat&.retracts %>
<section class="chat-log log-drawer__section" aria-label="Table" <%= tag.attributes(data: { retract: retract }) %>>
  <h3>Table</h3>
  <ol id="chat_log" data-dialogue-target="log" data-log-drawer-target="list">
    <% messages.each do |message| %>
      <%= render "messages/message", message: message %>
    <% end %>
  </ol>
</section>
