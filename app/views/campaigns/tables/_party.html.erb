<%# On the shared screen: the party at a glance. %>
<section class="window coop-party" aria-label="The party">
  <h2>Party</h2>
  <ol class="coop-party__list">
    <% campaign.characters.includes(:job, :user).order(:created_at).each do |character| %>
      <li class="<%= 'is-ko' unless character.conscious? %>">
        <%= entry_portrait(character.job, size: :small) %>
        <div>
          <strong><%= character.name %></strong>
          <span class="muted"><%= character.user&.name %></span>
          <%= render "campaigns/tables/vitals", character: character %>
        </div>
      </li>
    <% end %>
  </ol>
</section>
