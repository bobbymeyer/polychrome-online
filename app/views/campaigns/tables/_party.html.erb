<%# The party at a glance, on every view of the table but a phone controller (which shows its own). Refreshed
    with the table (Campaign#table_changed). A player's own row comes first, marked "You" (you: on the first render;
    you_controller after each refresh). %>
<% @world ||= campaign.world # the world's words %>
<% you = local_assigns[:you] %>
<section class="window coop-party" id="table_party" aria-label="The party" data-controller="here party-whisper you">
  <h2>Party</h2>
  <% party = campaign.characters.includes(:job, :user, :character_jobs, equipment_slots: :item, portraits: { image_attachment: :blob }).order(:created_at).to_a %>
  <% party = party.sort_by { |character| character == you ? 0 : 1 } if you %>
  <% if party.empty? %>
    <p class="empty">Nobody yet.</p>
  <% elsif party.none?(&:conscious?) %>
    <p class="party-down">Everyone is KO'd.</p>
  <% end %>
  <ol class="coop-party__list">
    <% party.each do |character| %>
      <li class="<%= class_names("is-you": character == you, "is-ko": !character.conscious?) %>" data-character="<%= character.id %>">
        <%= character_portrait(character, size: :small) %>
        <div>
          <strong class="coop-party__name"><%= link_to character.name, character_path(character), data: { turbo_frame: "_top" }, title: "#{character.name}'s sheet" %></strong>
          <%= tag.span("Coward", class: "coward-mark", title: "Refused a duel: no mask will have them, nobody hires them, and every price is dearer, until they win one") if character.coward? %>
          <span class="muted">Lv <%= character.level %> <%= character.job.name %> ·
            <% if character.user %>
              <%= character.user.name %>
              <%= tag.span(character.here? ? "here" : "away", class: [ "coop-party__here", { "is-here": character.here? } ],
                           data: { here_target: "who", seen_at: character.seen_at&.iso8601 }) %>
            <% else %>
              <span title="Nobody plays them yet: anyone can sit down as them">unplayed</span>
            <% end %>
          </span>
          <% if character.motive.present? %><p class="motive motive--card coop-party__motive"><%= character.motive %></p><% end %>
          <%= render "campaigns/tables/vitals", character: character %>
        </div>
        <% if local_assigns[:gm] %>
          <%# A whisper is something you do to a person: the GM's starts here (it reaches whoever sits as them), and
              the talk box says who hears. %>
          <%= tag.button "Whisper", type: "button", class: "link-button coop-party__whisper", title: "Whisper to #{character.name}",
                         data: { character_id: character.id, character_name: character.name,
                                 action: "click->party-whisper#start" } %>
        <% end %>
      </li>
    <% end %>
  </ol>
</section>
