<%# The party at a glance, on every view of the table but a phone controller (which shows its own). Replaced live (Campaign#table_changed). %>
<% @world ||= campaign.world # broadcast (Campaign#broadcast_table): the world's words %>
<section class="window coop-party" id="table_party" aria-label="The party" data-controller="here">
  <h2>Party</h2>
  <% party = campaign.characters.includes(:job, :user, :character_jobs, equipment_slots: :item).order(:created_at).to_a %>
  <% if party.empty? %>
    <p class="empty">Nobody yet.</p>
  <% elsif party.none?(&:conscious?) %>
    <p class="party-down">Everyone is KO'd.</p>
  <% end %>
  <ol class="coop-party__list">
    <% party.each do |character| %>
      <li class="<%= 'is-ko' unless character.conscious? %>" data-character="<%= character.id %>">
        <%= entry_portrait(character.job, size: :small) %>
        <div>
          <strong><%= link_to character.name, character_path(character), data: { turbo_frame: "_top" } %></strong>
          <span class="muted">Lv <%= character.level %> <%= character.job.name %> ·
            <% if character.user %>
              <%= character.user.name %>
              <%= tag.span(character.here? ? "here" : "away", class: [ "coop-party__here", { "is-here": character.here? } ],
                           data: { here_target: "who", seen_at: character.seen_at&.iso8601 }) %>
            <% else %>
              nobody plays them
            <% end %>
          </span>
          <%= render "campaigns/tables/vitals", character: character %>
        </div>
      </li>
    <% end %>
  </ol>
</section>
