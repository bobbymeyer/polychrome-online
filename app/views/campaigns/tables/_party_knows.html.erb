<%# What the party knows and can see coming: public clocks, and its secrets, revealed. Replaced live as they change. %>
<% clocks = campaign.clocks.shown_to_players.where(stopped_at: nil).order(:full_at, :id) %>
<% secrets = campaign.secrets.revealed.order(:revealed_at) %>
<section class="window party-knows" id="party_knows" aria-label="What the party knows" <%= "hidden" if clocks.none? && secrets.none? %>>
  <h2>The party knows</h2>
  <% if local_assigns[:gm] %><p class="hint">Everyone at the table sees this.</p><% end %>
  <% if clocks.any? %>
    <ul class="clock-list">
      <% clocks.each do |clock| %>
        <li><%= render "campaigns/clocks/dial", clock: clock %> <span><%= clock.name %> <span class="muted">(<%= clock.filled %> of <%= clock.segments %>)</span></span></li>
      <% end %>
    </ul>
    <p class="hint">Trouble on its way: each box fills as time passes or things go wrong, and when the last one fills, it happens.</p>
  <% end %>
  <% if secrets.any? %>
    <ul class="refs secret-list">
      <% secrets.each do |secret| %><li><%= secret.body %></li><% end %>
    </ul>
  <% end %>
</section>
