<%# One archetype, to the party (it opens) or to someone (they awaken to it: Campaign#grant_job!). %>
<details class="window table-scenes">
  <summary>Grant an archetype</summary>
  <%= form_with url: campaign_job_grants_path(campaign), class: "book-form" do |f| %>
    <div class="field-row">
      <div class="field">
        <%= label_tag :job, "Archetype" %>
        <%= select_tag :job, options_for_select(campaign.world.jobs.order(:name).map { |j| [ "#{j.name}#{' (open)' if campaign.job_open?(j)}", j.slug ] }) %>
      </div>
      <div class="field">
        <%= label_tag :character_id, "To" %>
        <%= select_tag :character_id, options_from_collection_for_select(campaign.characters.order(:created_at), :id, :name), include_blank: "The party: it opens" %>
      </div>
    </div>
    <div class="field"><%= label_tag :line, "The moment" %><%= text_field_tag :line, nil, placeholder: "The old master finally nods, and shows you how." %></div>
    <p class="hint">To the party, it opens for anyone to take up. To someone, they awaken to it: they take it up at once, and the table stops for it.</p>
    <%= f.submit "Grant", class: "button play" %>
  <% end %>
</details>
