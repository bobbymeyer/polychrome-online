<% locked = campaign.locked_jobs.to_a %>
<% if locked.any? %>
  <details class="window table-scenes">
    <summary>Grant archetypes</summary>
    <%= form_with url: campaign_job_grants_path(campaign), class: "book-form" do |f| %>
      <div class="checks">
        <% locked.each do |job| %>
          <label><%= check_box_tag "jobs[]", job.slug, false, id: "grant_#{job.slug}" %> <%= job.name %></label>
        <% end %>
      </div>
      <div class="field"><%= label_tag :line, "The moment" %><%= text_field_tag :line, nil, placeholder: "The old master finally nods, and shows you how." %></div>
      <%= f.submit "Grant", class: "button play" %>
    <% end %>
  </details>
<% end %>
