<%# The rest of the GM's tools at the table, behind "Tools" until wanted: the moves that are live, and More
    (grants, music, the shared screen). What the GM calls (scenes, checks, travel, the day) is the Now line's
    controls row (Campaign::Controls); clocks and secrets are Prep's, and the Now line says when a clock is
    about to fill. One tab at a time; gm_tools_controller keeps the one you had open. What needs an answer
    now comes first: everyone down, a field ability asked for. %>
<% tabs = { "moves" => [ "Moves", nil ], "more" => [ "More", nil ] } %>
<section class="gm-tools" aria-label="GM tools" data-controller="gm-tools" data-gm-tools-campaign-value="<%= campaign.id %>">
  <%= render "campaigns/tables/gm/recovery", campaign: campaign %>
  <%= render "campaigns/field_uses/requests", campaign: campaign %>
  <p class="gm-only">GM tools · only you see these</p>
  <button type="button" class="button button--quiet gm-tools__reveal" data-action="gm-tools#reveal" aria-expanded="false">Tools</button>
  <div class="gm-tools__tabs" role="tablist" aria-label="GM tools">
    <% tabs.each_with_index do |(key, (label, count)), i| %>
      <%= tag.button type: "button", role: "tab", id: "gm_tab_#{key}", class: "gm-tools__tab",
                     aria: { selected: i.zero?, controls: "gm_panel_#{key}" }, tabindex: (i.zero? ? 0 : -1),
                     data: { gm_tools_target: "tab", key: key, action: "gm-tools#pick keydown->gm-tools#arrow" } do %>
        <%= label %><%= tag.span(count, class: "gm-tools__count") if count.to_i.positive? %>
      <% end %>
    <% end %>
  </div>
  <% tabs.each_key.with_index do |key, i| %>
    <%= tag.div id: "gm_panel_#{key}", role: "tabpanel", class: "gm-tools__panel", hidden: !i.zero?,
                aria: { labelledby: "gm_tab_#{key}" }, data: { gm_tools_target: "panel", key: key } do %>
      <%= render "campaigns/tables/gm/#{key}", campaign: campaign, view: local_assigns[:view] %>
    <% end %>
  <% end %>
</section>
