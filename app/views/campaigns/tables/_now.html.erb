<%# What the table is doing right now, in one line, and whose move it is: a battle first (it holds
    everything else), then an open choice and who still has to pick, else whose floor it is.
    Refreshed with the table, each seat rendering its own. %>
<% battle = campaign.current_battle %>
<% choice = campaign.open_choice %>
<%# data-state says which: a player's moves follow it (stage.css, "What you can do now"); data-controls what the GM
    has called (Campaign::Controls): the talk box is there only under Talk. %>
<% state = campaign.table_state %>
<%# table-now--controls: the GM's controls strip is in the line (below), and the line is that strip (stage.css, "The controls"). %>
<% controls = gm && !battle && !state.in?(%w[encounter choice challenge duel]) %>
<section id="table_now" class="table-now<%= " table-now--battle" if battle || campaign.pending_encounter.present? %><%= " table-now--controls" if controls %>" aria-label="Right now" aria-live="polite" data-state="<%= state %>" data-controls="<%= campaign.controls %>" data-change="state" data-change-key="table-now">
  <%# In free play the GM's line is the controls row and nothing else: no label, no sentence. A scene on the stage
      says nothing here either: the stage is the scene, and the director's hand is on the stage's corner tag
      (campaigns/tables/_time). %>
  <% if (gm && state.in?(%w[free scene])) || (!gm && state == "scene") %>
    <%# Clocks live in Prep; the one thing the table needs to know is when one is about to fill. %>
    <% nearly = campaign.clocks.running.nearly_full.to_a %>
    <% if nearly.any? %>
      <p class="table-now__clock"><%= nearly.map(&:name).to_sentence %> <%= nearly.one? ? "is" : "are" %> one tick from full · <%= link_to "Clocks", campaign_prep_path(campaign, anchor: "clocks") %></p>
    <% end %>
  <% else %>
  <p class="table-now__label">Now</p>
  <p class="table-now__what" data-change="text">
    <% if battle %>
      <strong>A battle is on: <%= battle.name %>.</strong>
      <%= gm ? "You run it from the battle page." : "Everyone at the table fights it." %>
      <%= "The choice waits until it's over." if choice %>
    <% elsif state == "duel" %>
      <% duel = campaign.current_duel %>
      <strong><%= duel.on? ? "A duel: #{duel.character.name} and #{duel.opponent_name}." : "The duel is over." %></strong>
      <%= "Everyone else watches." if duel.on? %>
    <% elsif state == "challenge" %>
      <%# A duel (Campaign::Duels): the challenged character answers; refusing makes them a coward. %>
      <% challenged = campaign.challenged_character %>
      <strong><%= campaign.challenger_name %> challenges <%= challenged&.name %> to a duel!</strong>
      <%= "“#{campaign.challenge['line']}”" if campaign.challenge["line"] %>
      <% if challenged && (gm || local_assigns[:you] == challenged) %>
        Accept, or refuse and be a coward until you win one.
      <% else %>
        <%= challenged&.name %> answers.
      <% end %>
    <% elsif (encounter = campaign.pending_encounter).present? %>
      <strong>Encounter! <%= campaign.encounter_foes(encounter).to_sentence %>.</strong>
      <%= gm ? "It's your call." : "The GM calls it: fight, or wave it off." %>
    <% elsif choice %>
      <%# Who has picked is the vote's own footer (choices/_panel), under the options where the picks are. %>
      <strong><%= choice.where_next? ? "The party is choosing where to go next." : choice.what_now? ? "The party is down. What happens now?" : "The party is choosing." %></strong>
      <%# The shared screen has no buttons: it sends the table to their phones (stage.css swaps the words). %>
      <% if gm %>Settle it when you're ready.<% else %><span class="table-now__here">Pick below; the GM settles it.</span><span class="table-now__phones">Pick on your phones; the GM settles it.</span><% end %>
    <% elsif campaign.travelling? %>
      <strong>Where next?</strong> Say where you'd go: it goes to a vote, and the GM settles it.
    <% elsif campaign.doing? %>
      <strong>What will you do here?</strong> Say which: it goes to a vote, and the GM settles it.
    <% else %>
      <strong>The GM has the floor.</strong> Talk at the table.
    <% end %>
  </p>
  <% end %>
  <%= render "campaigns/tables/current_battle", campaign: campaign %>
  <%= render "campaigns/tables/duel", duel: campaign.current_duel, gm: gm, you: local_assigns[:you] if state == "duel" %>
  <%# The challenged player's answer, on their own screen. %>
  <% if !gm && state == "challenge" && local_assigns[:you] && local_assigns[:you] == campaign.challenged_character %>
    <div class="table-now__do">
      <%= button_to "Accept", campaign_challenge_answer_path(campaign), params: { answer: "accept" }, class: "button play", form: { class: "inline" } %>
      <%= button_to "Refuse", campaign_challenge_answer_path(campaign), params: { answer: "refuse" }, class: "button", form: { class: "inline" },
                    data: { turbo_confirm: "A coward has no place in this world. You'll be one until you win a duel. Refuse?" } %>
    </div>
  <% end %>
  <%# The GM's prompt: the moves that fit this state, right here (the panels below have the detail). %>
  <% if gm && !battle %>
    <div class="table-now__do">
      <% if state == "challenge" %>
        <%= button_to "Accept for #{campaign.challenged_character&.name}", campaign_challenge_answer_path(campaign), params: { answer: "accept" }, class: "button play", form: { class: "inline" } %>
        <%= button_to "Refuse", campaign_challenge_answer_path(campaign), params: { answer: "refuse" }, class: "button", form: { class: "inline" },
                      data: { turbo_confirm: "#{campaign.challenged_character&.name} will be a coward until they win a duel. Refuse?" } %>
        <%= button_to "Withdraw it", campaign_challenge_path(campaign), method: :delete, class: "button button--quiet", form: { class: "inline" } %>
      <% elsif state == "encounter" %>
        <%= link_to "Fight or wave it off ↓", "#table_ways", class: "button play" %>
      <% elsif state == "choice" %>
        <%= link_to "Settle it ↓", "#table_choice", class: "button play" %>
      <% else %>
        <%# The controls (Campaign::Controls): what kind of moment this is, so everyone gets the actions that fit.
            Talk is the floor; Travel and Things to do here put the ways below, for the GM and the players alike;
            Scene and Check put that tool below, for the GM. %>
        <% ways = campaign.ways_on %>
        <%# Things to do here is always open to the GM: time passes there even where there's nothing else to do. %>
        <% offered = { "travel" => ways.any? { |way| !way.dig("move", "pastime") }, "battle" => campaign.characters.any? } %>
        <div class="controls-call" role="group" aria-label="What's happening">
          <% Campaign::Controls::CONTROL_LABELS.each do |kind, label| %>
            <% current = campaign.controls == kind %>
            <%# data-kind colours it from the spectrum (stage.css, "The controls"); the one called is black. %>
            <%= button_to label, campaign_controls_path(campaign), method: :patch, params: { kind: kind },
                          class: "button", disabled: offered.fetch(kind, true) == false, data: { kind: kind },
                          "aria-pressed": current.to_s, form: { class: "inline" } %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
