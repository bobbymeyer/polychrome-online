<%# What the table is doing right now, in one line, and whose move it is: a battle first (it holds
    everything else), then an open choice and who still has to pick, else whose floor it is.
    Replaced live with the table's panels, once for the GM and once for everyone else. %>
<% battle = campaign.current_battle %>
<% choice = campaign.open_choice %>
<% scene = campaign.staged_scene %>
<% beat = scene&.current_beat %>
<%# data-state says which: a player's moves follow it (stage.css, "What you can do now"). %>
<% state = battle ? "battle" : campaign.pending_encounter.present? ? "encounter" : choice ? "choice" : (scene && beat) ? "scene" : "free" %>
<section id="table_now" class="table-now<%= " table-now--battle" if battle || campaign.pending_encounter.present? %>" aria-label="Right now" aria-live="polite" data-state="<%= state %>" data-change="state" data-change-key="table-now">
  <p class="table-now__label">Now</p>
  <p class="table-now__what" data-change="text">
    <% if battle %>
      <strong>A battle is on: <%= battle.name %>.</strong>
      <%= gm ? "You run it from the battle page." : "Everyone at the table fights it." %>
      <%= "The choice waits until it's over." if choice %>
    <% elsif (encounter = campaign.pending_encounter).present? %>
      <% foes = (campaign.npcs.where(id: encounter.fetch("antagonists", [])).map(&:name) + [ (campaign.describe_encounter(encounter["monsters"]) if encounter["monsters"].present?) ]).compact %>
      <strong>Encounter! <%= foes.to_sentence %>.</strong>
      <%= gm ? "It's your call." : "The GM calls it: fight, or wave it off." %>
    <% elsif choice %>
      <% picked = choice.picks.includes(:character).map { |pick| pick.character.name } %>
      <% unplayed, waiting = campaign.characters.order(:created_at).reject { |c| picked.include?(c.name) }.partition { |c| c.user_id.nil? }.map { |cs| cs.map(&:name) } %>
      <strong><%= choice.where_next? ? "The party is choosing where to go next." : choice.what_now? ? "The party is down. What happens now?" : "The party has a choice to make." %></strong>
      <%# The shared screen has no buttons: it sends the table to their phones (stage.css swaps the words). %>
      <% if gm %>Settle it when you're ready.<% else %><span class="table-now__here">Pick below; the GM settles it.</span><span class="table-now__phones">Pick on your phones; the GM settles it.</span><% end %>
      <span class="table-now__who">
        <%= picked.any? ? "Picked: #{picked.to_sentence}." : "Nobody has picked yet." %>
        <%= "Still to pick: #{waiting.to_sentence}." if picked.any? && waiting.any? %>
        <%= "Nobody plays #{unplayed.to_sentence}: no pick from them." if unplayed.any? %>
      </span>
    <% elsif scene && beat %>
      <strong>A scene is on the stage: <%= scene.name %>.</strong>
      <%= gm ? "Beat #{beat.position + 1} of #{scene.beats.size}#{scene.auto? ? ', playing on' : ''}." : "Watch the stage." %>
    <% elsif gm %>
      <strong>The table is yours.</strong>
      <%= { "travel" => "Travel: the ways on are below, for everyone.", "doing" => "Things to do here are below, for everyone.",
            "scene" => "Scene: pick one below to put on the stage.", "check" => "Check: say who rolls what, below." }[campaign.controls] %>
    <% elsif campaign.travelling? %>
      <strong>Where next?</strong> Say where you'd go: it goes to a vote, and the GM settles it.
    <% elsif campaign.doing? %>
      <strong>What will you do here?</strong> Say which: it goes to a vote, and the GM settles it.
    <% else %>
      <strong>The GM has the floor.</strong> Talk at the table.
    <% end %>
  </p>
  <%= render "campaigns/tables/current_battle", campaign: campaign %>
  <%# The GM's prompt: the moves that fit this state, right here (the panels below have the detail). %>
  <% if gm && !battle %>
    <div class="table-now__do">
      <% if state == "scene" %>
        <%# The director's hand: the next beat (or the ending), play on or pause, and down. %>
        <% ending = { "battle" => "then the battle", "reveal" => "then #{scene.map_node&.name} appears", "mode" => "then #{scene.map_node&.name} changes" }[scene.ending] %>
        <%= button_to(scene.last_beat? ? "Finish#{", #{ending}" if ending}" : "Next beat", scene_play_path(scene), method: :patch, params: { go: "next" }, class: "button play", form: { class: "inline" }) %>
        <% if scene.auto? %>
          <%= button_to "Pause", scene_play_path(scene), method: :patch, params: { go: "pause" }, class: "button button--quiet", form: { class: "inline" } %>
        <% elsif !scene.last_beat? && !beat.choice? %>
          <%= button_to "Play on", scene_play_path(scene), method: :patch, params: { go: "on" }, class: "button button--quiet", form: { class: "inline" } %>
        <% end %>
        <%= button_to "Take it down", scene_play_path(scene), method: :delete, class: "link-button", form: { class: "inline", data: { turbo_confirm: "Take #{scene.name} off the stage without its ending?" } } %>
      <% elsif state == "encounter" %>
        <%= link_to "Fight or wave it off ↓", "#table_ways", class: "button play" %>
      <% elsif state == "choice" %>
        <%= link_to "Settle it ↓", "#table_choice", class: "button play" %>
      <% else %>
        <%# The controls (Campaign::Controls): what kind of moment this is, so everyone gets the actions that fit.
            Talk is the floor; Travel and Things to do here put the ways below, for the GM and the players alike;
            Scene and Check put that tool below, for the GM. %>
        <% ways = campaign.ways_on %>
        <% offered = { "travel" => ways.any? { |way| !way.dig("move", "pastime") }, "doing" => ways.any? { |way| way.dig("move", "pastime") } } %>
        <div class="controls-call" role="group" aria-label="What's happening">
          <% Campaign::Controls::CONTROL_LABELS.each do |kind, label| %>
            <% current = campaign.controls == kind %>
            <%= button_to label, campaign_controls_path(campaign), method: :patch, params: { kind: kind },
                          class: "button #{current ? 'play' : 'button--quiet'}", disabled: offered.fetch(kind, true) == false,
                          "aria-pressed": current.to_s, form: { class: "inline" } %>
          <% end %>
        </div>
        <% if campaign.map_on_stage? %>
          <%= button_to "Show the place", campaign_map_view_path(campaign), method: :patch, params: { off: 1 }, class: "button button--quiet", form: { class: "inline" } %>
        <% else %>
          <%= button_to "Show the map", campaign_map_view_path(campaign), method: :patch, class: "button button--quiet", form: { class: "inline" } %>
        <% end %>
        <%= render "campaigns/tables/here", campaign: campaign %>
      <% end %>
    </div>
  <% elsif !gm && state == "free" %>
    <%# A player's way into the place, while the table is free: its page (shops, rooms, the floor). %>
    <div class="table-now__do"><%= render "campaigns/tables/here", campaign: campaign %></div>
  <% end %>
</section>
