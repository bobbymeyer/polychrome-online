<%# A scene's beat on the stage (Beat): what's behind it (a place's picture as it is now, a panel made for
    the beat, black, or what the table had), and who stands on it, left and right, the speaker lit: full
    body as their sprite (Sprite, or the archetype's figure), else as their portrait.
    Sized to the frame (container units), so it reads the same on the table, the TV and the preview. %>
<% behind = beat.effective_backdrop %>
<% image = beat.backdrop_image || (behind.nil? ? beat.campaign.current_node&.location&.picture : nil) %>
<div class="beat-stage beat-stage--<%= behind&.dig("kind") || "table" %>">
  <%= image_tag url_for(image), alt: "", class: "beat-stage__backdrop" if image %>
  <div class="beat-stage__figures">
    <% Beat::SIDES.each do |side| %>
      <div class="beat-stage__side beat-stage__side--<%= side %>">
        <% beat.on_stage.select { |f| f["side"] == side }.each do |figure| %>
          <% sprite = figure["who"].sprite_image %>
          <%= tag.span class: [ "beat-stage__figure", (sprite ? "beat-stage__figure--sprite" : "beat-stage__figure--portrait"), ("is-speaking" if figure["speaking"]) ], title: figure["who"].name do %>
            <% if sprite %>
              <%= image_tag url_for(sprite), alt: figure["who"].name, class: "beat-stage__sprite" %>
            <% else %>
              <%= speaker_portrait(figure["who"], figure["expression"], size: :large) %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
