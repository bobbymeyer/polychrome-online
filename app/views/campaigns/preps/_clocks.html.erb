<section class="window" id="clocks">
  <h2>Clocks</h2>
  <p class="hint">Things that happen if the party doesn't stop them. They tick by hand, or on their own as the party rests, travels or fails.</p>
  <%= render "campaigns/clocks/gm", campaign: campaign %>
  <% fronts = campaign.world.world_fronts.in_order.reject { |front| front.dealt_into?(campaign) } %>
  <% if fronts.any? %>
    <details class="draft-panel">
      <summary>Fronts from <%= campaign.world.name %> (<%= fronts.size %>)</summary>
      <ul class="refs">
        <% fronts.each do |front| %>
          <li><strong><%= front.name %></strong> <span class="muted">· <%= pluralize(front.clocks.size, "clock") %>, <%= pluralize(front.secrets.size, "secret") %></span>
            <%= button_to "Deal it in", campaign_front_deals_path(campaign), params: { front_id: front.id }, class: "button button--quiet", form: { class: "inline" } %></li>
        <% end %>
      </ul>
    </details>
  <% end %>
  <%= render "drafts/panel", owner: campaign, kind: "clocks", title: "Suggest clocks", placeholder: "The Syndicate wants the docks" %>
</section>
