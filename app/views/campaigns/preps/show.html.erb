<% content_for :title, "Prep · #{@campaign.name}" %>
<%= render "shared/stage_stream", campaign: @campaign %>
<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>
<%= turbo_stream_from @campaign, :pages %>
<div class="crumbs"><%= link_to @campaign.name, campaign_path(@campaign) %> / Prep</div>
<div class="book-header">
  <div>
    <p class="eyebrow"><%= @world.name %> · <%= @campaign.when_it_is %></p>
    <h1>Prep</h1>
  </div>
  <div class="actions">
    <%= link_to "Open the table", campaign_table_path(@campaign), class: "button button--primary" %>
    <%= link_to "Maps", campaign_maps_path(@campaign), class: "button button--quiet" %>
    <%= link_to "Legends", campaign_legends_path(@campaign), class: "button button--quiet" %>
    <%= link_to "Battle report", campaign_battle_report_path(@campaign), class: "button button--quiet" %>
    <%= link_to "Simulate", campaign_simulation_path(@campaign), class: "button button--quiet" %>
    <% if can_gm?(@campaign) %><%= link_to "Export module", campaign_campaign_module_path(@campaign), class: "button button--quiet", data: { turbo: false } %><% end %>
    <% if table_gm? %>
    <% end %>
  </div>
</div>
<%# Two tiers (docs/DESIGN.md): this session on the page (scenes, clocks, the moment), the reference behind
    tabs (drawers_controller; a link to #secrets opens its tab). %>
<nav class="prep-nav" aria-label="Prep">
  <% { "scenes" => "Scenes", "clocks" => "Clocks", "moment" => "The moment" }.each do |anchor, label| %>
    <a href="#<%= anchor %>"><%= label %></a>
  <% end %>
  <%# The maps are Prep's too, on their own page (they need the room). %>
  <%= link_to "Maps →", campaign_maps_path(@campaign) %>
</nav>

<%= render "campaigns/preps/scenes", campaign: @campaign %>

<% if table_gm? %>
  <div class="two-up">
    <%= render "campaigns/preps/clocks", campaign: @campaign %>
    <%= render "campaigns/preps/moment", campaign: @campaign %>
  </div>
  <% reference = { "secrets" => "Secrets", "deeds" => "Deeds", "rumours" => "Rumours", "flags" => "Flags", "bag" => "Bag" } %>
  <div class="drawers prep-reference" data-controller="drawers" aria-label="The reference">
    <div class="drawers__tabs" role="group" aria-label="Look up">
      <% reference.each do |key, label| %>
        <%= tag.button label, type: "button", class: "drawers__tab", aria: { expanded: false, controls: "prep_#{key}" },
                              data: { drawers_target: "tab", key: key, action: "drawers#toggle" } %>
      <% end %>
      <%= link_to "Changes to places →", campaign_changes_path(@campaign), class: "drawers__link" %>
    </div>
    <% reference.each_key do |key| %>
      <div id="prep_<%= key %>" class="drawers__panel" hidden data-drawers-target="panel" data-key="<%= key %>">
        <%= render "campaigns/preps/#{key}", campaign: @campaign %>
      </div>
    <% end %>
  </div>
<% else %>
  <section class="window">
    <p>You're sitting as a character at this table. Clocks, secrets, deeds, rumours and flags are changed from the GM's seat.</p>
    <%= button_to "Take the GM's seat", campaign_table_seat_path(@campaign), params: { seat: "gm" }, class: "button" %>
  </section>
<% end %>
