<%# The party's chest and each adventurer's bag, stocked here before a session (InventoriesController); at the table
    items go between them from the sheets, and are spent in shops and battles. %>
<section class="window" id="bag">
  <h2>Chest and bags</h2>
  <%# One query for every bag, however big the party. %>
  <% party = campaign.characters.order(:created_at).to_a %>
  <% held = campaign.inventories.includes(:item).where("quantity > 0").group_by(&:character_id) %>
  <% ([ nil ] + party.map(&:id)).each do |holder_id| %>
    <% rows = Array(held[holder_id]).sort_by { |row| [ row.item.category, row.item.name ] } %>
    <h3><%= holder_id ? "#{party.find { |c| c.id == holder_id }.name}'s bag" : "The chest" %></h3>
    <% if rows.empty? %>
      <p class="empty">Empty.</p>
    <% else %>
      <table class="book-table book-table--plain">
        <thead><tr><th>Item</th><th>Category</th><th class="num">Qty</th></tr></thead>
        <tbody>
          <% rows.each do |row| %>
            <tr>
              <td><%= link_to row.item.name, world_armory_item_path(campaign.world, row.item) %></td>
              <td><%= term(row.item.category) %></td>
              <td class="num"><%= row.quantity %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>
  <details id="add_items" data-turbo-permanent data-controller="fresh-form" data-action="turbo:submit-end->fresh-form#done">
    <summary>Add items</summary>
    <%= form_with url: campaign_inventories_path(campaign), scope: :inventory, class: "book-form" do |f| %>
      <div class="field-row">
        <div class="field"><%= f.label :item_id, "Item" %><%= f.select :item_id, campaign.world.items.order(:name).map { |i| [ i.name, i.id ] } %></div>
        <div class="field"><%= f.label :quantity %><%= f.number_field :quantity, value: 1, min: 1, max: 99 %></div>
        <div class="field"><%= f.label :character_id, "To" %><%= f.select :character_id, party.map { |c| [ "#{c.name}'s bag", c.id ] }, include_blank: "The chest" %></div>
      </div>
      <%= f.submit "Add to chest", class: "button" %>
    <% end %>
  </details>
</section>
