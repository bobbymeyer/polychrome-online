<%# The GM's way into local co-op: one shared screen, phones as controllers. Set up here, on the campaign page beside the
    invite, before play (it isn't a move at the table). %>
<section class="window coop-setup" id="coop" aria-label="Play around one screen">
  <h2>Play around one screen</h2>
  <p>Play around one shared screen: a TV at the table, or your screen shared on a call. Everyone talks out loud (or on voice chat); phones are just controllers.</p>
  <%= render "campaigns/tables/coop_join", campaign: campaign %>
  <ol class="coop-setup__steps">
    <li><%= link_to "Open the shared screen", campaign_table_path(campaign, view: "screen"), class: "button play", target: "_blank", rel: "noopener" %>
      on the device that drives the TV or the stream.</li>
    <li>Players scan its QR code, or open <strong><%= join_url(campaign.join_code, view: "controller") %></strong>, and pick their character. No account needed.</li>
    <li>Want your phone as a GM remote? <%= link_to "Use this device as a controller", campaign_table_path(campaign, view: "controller") %>.</li>
  </ol>
  <p>Playing at a table, or on a call, with nothing to press on the screen? <%= link_to "Open the stage only", campaign_table_path(campaign, view: "stage"), class: "button button--quiet", target: "_blank", rel: "noopener" %>:
    nothing but the Stage, filling the screen, for a TV or a stream.</p>
  <p class="hint">Players somewhere else join with the <%= link_to "invite link", "#invite" %> above.</p>
</section>
