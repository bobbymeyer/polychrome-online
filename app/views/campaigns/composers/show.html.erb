<%= turbo_frame_tag "composer" do %>
  <% seat = table_seat %>
  <%= form_with model: @message, url: campaign_messages_path(@campaign), class: "window composer",
                data: { controller: "composer", action: "keydown->composer#key" } do |f| %>
    <%= render "book_entries/errors", entry: @message %>
    <div class="composer__controls">
      <% if seat.gm? %>
        <div class="field">
          <label for="message_speaker">Speak as</label>
          <%= select_tag "message[speaker]",
                         options_for_select([ [ "Narrator", "narrator" ] ] + @campaign.npcs.order(:name).map { |npc| [ [ npc.name, npc.title.presence ].compact.join(", "), "npc:#{npc.id}" ] },
                                            @message.speaker.is_a?(Npc) ? "npc:#{@message.speaker.id}" : "narrator"),
                         id: "message_speaker" %>
        </div>
        <div class="field">
          <label for="message_whisper_to">To</label>
          <%= select_tag "message[whisper_to]",
                         options_for_select([ [ "Everyone", "" ] ] + @campaign.characters.order(:created_at).map { |c| [ "Whisper to #{c.name}", c.id ] }, @message.recipient&.id),
                         id: "message_whisper_to" %>
        </div>
      <% else %>
        <div class="field">
          <label for="message_whisper_to">To</label>
          <%= select_tag "message[whisper_to]", options_for_select([ [ "Everyone", "" ], [ "Whisper to the GM", "gm" ] ], @message.whisper? ? "gm" : ""),
                         id: "message_whisper_to" %>
        </div>
      <% end %>
      <%# How it's said: optional, so it waits behind a word until wanted. %>
      <details class="field composer__expression" <%= "open" if @message.expression.present? && @message.expression != Portrait::EXPRESSIONS.first %>>
        <summary>Expression</summary>
        <%= f.select :expression, Portrait::EXPRESSIONS.map { |e| [ e.humanize, e ] }, {}, "aria-label": "Expression" %>
      </details>
    </div>
    <div class="composer__row">
      <%= f.text_area :body, rows: 2, placeholder: seat.gm? ? "Say something as them… (Enter to send; “? A | B” asks the table)" : "Say something… (Enter to send)", autofocus: @refocus,
                      data: { composer_target: "body" }, "aria-label": "Message" %>
      <%= f.submit "Send", class: "button play" %>
    </div>
  <% end %>
<% end %>
