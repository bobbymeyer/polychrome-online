<%# Each kind of fighter and each move over many battles (Battle::Report.across): the campaign's battle report, and
    the simulator's runs. each: what one of them is called, "battle" or "run". %>
<% sides = { "party" => "The party", "enemy" => "The enemies" } %>
<% mp = local_assigns.fetch(:mp, "MP") %>
<% sides.each do |side, title| %>
  <% fighters = across["fighters"].select { |fighter| fighter["side"] == side } %>
  <% next if fighters.empty? %>
  <section class="battle-report__side">
    <h2><%= title %>, over every <%= each %></h2>
    <table class="book-table book-table--plain">
      <thead>
        <tr>
          <th>Who</th><th class="num"><%= each.pluralize.capitalize %></th><% if side == "enemy" %><th class="num">Faced</th><% end %>
          <th class="num">Dealt</th><th class="num">A <%= each %></th><th class="num">An action</th><th class="num">Taken</th>
          <th class="num">Healed</th><th class="num">KOs</th><th class="num">Went down</th><th class="num">Actions</th>
          <th class="num">Misses</th><th class="num">Crits</th><th class="num"><%= mp %> spent</th>
        </tr>
      </thead>
      <tbody>
        <% fighters.each do |fighter| %>
          <tr>
            <th scope="row"><%= fighter["name"] %></th>
            <td class="num"><%= fighter["battles"] %></td>
            <% if side == "enemy" %><td class="num"><%= fighter["units"] %></td><% end %>
            <td class="num"><%= fighter["dealt"] %></td>
            <td class="num"><%= fighter["dealt_per_battle"] || "—" %></td>
            <td class="num"><%= fighter["dealt_per_action"] || "—" %></td>
            <% %w[taken healed kos downed actions misses crits mp_spent].each do |key| %>
              <td class="num"><%= fighter[key] %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<% sides.each do |side, title| %>
  <% moves = across["moves"].select { |move| move["side"] == side } %>
  <% next if moves.empty? %>
  <section class="battle-report__moves">
    <h2><%= side == "party" ? "The party's moves" : "The enemies' moves" %></h2>
    <table class="book-table book-table--plain">
      <thead><tr><th>Move</th><th class="num">Uses</th><th class="num">Dealt</th><th class="num">A use</th><th class="num">Healed</th></tr></thead>
      <tbody>
        <% moves.each do |move| %>
          <tr>
            <th scope="row"><%= move["name"] %></th>
            <td class="num"><%= move["uses"] %></td>
            <td class="num"><%= move["dealt"] %></td>
            <td class="num"><%= move["dealt_per_use"] || "—" %></td>
            <td class="num"><%= move["healed"] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
