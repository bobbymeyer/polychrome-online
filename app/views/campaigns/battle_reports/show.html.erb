<% content_for :title, "#{@campaign.name} · Battle report" %>
<%# Every battle the campaign has fought, its numbers together, for the GM balancing the game (Battle::Report.across):
    each fight in a line, then each kind of fighter and each move over every battle it was in. Plain tables, so they
    paste into a spreadsheet as they are; each battle's own report has the rest. %>
<% hp, mp = @world.word("hp"), @world.word("mp") %>
<% sides = { "party" => "The party", "enemy" => "The enemies" } %>
<% battles = @across["battles"] %>
<div class="battle-report">
  <p class="crumbs"><%= link_to @campaign.name, campaign_path(@campaign) %> · <%= link_to "Prep", campaign_prep_path(@campaign) %> · Battle report</p>
  <h1>Battle report</h1>

  <% if battles.empty? %>
    <p class="empty">No battles yet. Each one fought shows here, with its numbers.</p>
  <% else %>
    <p>
      <%= pluralize(battles.size, "battle") %>:
      <%= @across["results"].map { |result, count| "#{count} #{result == "input" ? "still being fought" : result.humanize.downcase}" }.to_sentence %>.
      What landed counts: damage past a unit's last <%= hp %> and healing past its full <%= hp %> don't.
    </p>
    <p class="battle-report__download">Download as CSV:
      <%= safe_join(BattleReportCsv::CAMPAIGN_TABLES.map { |table| link_to table.capitalize, campaign_battle_report_path(@campaign, format: :csv, table: table), data: { turbo: false } }, " · ") %></p>

    <section class="battle-report__battles">
      <h2>Battles</h2>
      <table class="book-table book-table--plain">
        <thead>
          <tr>
            <th>Battle</th><th>Fought</th><th>Result</th><th class="num">Rounds</th><th class="num">Party dealt</th>
            <th class="num">Party took</th><th class="num">Party healed</th><th class="num">Party down</th><th>Against</th>
          </tr>
        </thead>
        <tbody>
          <% battles.each do |battle| %>
            <tr>
              <th scope="row"><%= link_to battle["name"], battle_report_path(battle["id"]) %><%= " (boss)" if battle["boss"] %></th>
              <td><%= l(battle["fought_on"], format: :short) %></td>
              <td><%= battle["result"] == "input" ? "Under way" : battle["result"].humanize %></td>
              <td class="num"><%= battle["rounds"] %></td>
              <td class="num"><%= battle["party_dealt"] %></td>
              <td class="num"><%= battle["party_taken"] %></td>
              <td class="num"><%= battle["party_healed"] %></td>
              <td class="num"><%= battle["party_downed"] %></td>
              <td><%= battle["foes"].map { |name, count| count > 1 ? "#{count} × #{name}" : name }.join(", ") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>

    <%= render "campaigns/battle_reports/across", across: @across, each: "battle", mp: mp %>
  <% end %>
</div>
