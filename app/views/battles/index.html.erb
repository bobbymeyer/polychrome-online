<% content_for :title, "Battles" %>
<div class="book-header">
  <h1>Battles</h1>
  <%= link_to "New battle", new_world_battle_path(@world), class: "button" %>
</div>
<% if @battles.empty? %>
  <p class="empty">No battles yet.</p>
<% else %>
  <table class="book-table">
    <thead><tr><th>Name</th><th>Status</th><th class="num">Round</th><th>Last action</th></tr></thead>
    <tbody>
      <% @battles.each do |battle| %>
        <tr>
          <td><%= link_to battle.name, battle_path(battle) %></td>
          <td><%= battle.status.humanize %></td>
          <td class="num"><%= battle.round %></td>
          <td><%= time_ago_in_words(battle.updated_at) %> ago</td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
