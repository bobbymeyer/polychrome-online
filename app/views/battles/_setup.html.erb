<%# A battle, set up under the stage once the GM calls Battle (Campaign::Controls; BattleSetup): what they face,
    who fights (the standing pre-checked), Start; the forecast as it changes; and behind More, the name, the
    timer, the seed, where, and whether the party can flee. The form posts to BattlesController#create.
    campaign; setup (BattleSetup.defaults, or the form as it came back). %>
<% world = campaign.world %>
<% monsters = monster_options(world.monsters) %>
<%= form_with url: campaign_battles_path(campaign), scope: :battle, class: "book-form battle-setup",
              data: { controller: "forecast help", forecast_url_value: campaign_forecast_path(campaign), action: "change->forecast#changed input->forecast#changed", turbo_frame: "_top" } do |f| %>
  <%= hidden_field_tag :from, "table", id: nil %>
  <% antagonists = campaign.npcs.at_large.includes(:monster).order(:name) %>
  <% if antagonists.any? %>
    <fieldset class="panel">
      <legend>Antagonists</legend>
      <%= hidden_field_tag "battle[antagonists][]", "", id: nil %>
      <div class="checks">
        <% antagonists.each do |npc| %>
          <label data-help="Fights as <%= npc.monster.name %>, under their own name, as a boss. Sent off the field, they get away, stronger next time.">
            <%= check_box_tag "battle[antagonists][]", npc.id, setup[:antagonists].include?(npc.id), id: "battle_antagonist_#{npc.id}" %>
            <%= npc.name %> <span class="muted">(as <%= npc.monster.name %><%= ", #{npc.strength_percent}%" if npc.escapes.positive? %>)</span>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <fieldset class="panel">
    <legend>What they face</legend>
    <%# One monster to start; "+" on the first row adds another, and each added row has "−" to take it out (rows_controller). %>
    <% shown = setup[:encounter].select { |row| row[:monster].present? }.presence || [ setup[:encounter].first || { monster: "", count: 1 } ] %>
    <% slot = ->(i, row, n) { safe_join([
         tag.td(select_tag("battle[encounter][#{i}][monster]", options_for_select(monsters, row[:monster]), include_blank: "(none)", "aria-label": "Monster #{n}")),
         tag.td(number_field_tag("battle[encounter][#{i}][count]", row[:count], min: 1, max: 8, "aria-label": "Monster #{n} count"))
       ]) } %>
    <table class="grid-form" data-controller="rows">
      <thead><tr><th>Monster</th><th>Count</th><th><span class="visually-hidden">More</span></th></tr></thead>
      <tbody data-rows-target="body">
        <% shown.each_with_index do |row, i| %>
          <tr data-rows-target="row">
            <%= slot.(i, row, i + 1) %>
            <td class="grid-form__act">
              <% if i.zero? %>
                <%= tag.button "+", type: "button", class: "rows__add", title: "Another monster", aria: { label: "Another monster" }, data: { action: "rows#add" } %>
              <% else %>
                <%= tag.button "−", type: "button", class: "rows__remove", title: "Take this one out", aria: { label: "Take this one out" }, data: { action: "rows#remove" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <template data-rows-target="template">
        <tr data-rows-target="row">
          <%= slot.("__i__", { monster: "", count: 1 }, "__n__") %>
          <td class="grid-form__act"><%= tag.button "−", type: "button", class: "rows__remove", title: "Take this one out", aria: { label: "Take this one out" }, data: { action: "rows#remove" } %></td>
        </tr>
      </template>
    </table>
  </fieldset>
  <fieldset class="panel">
    <legend>Who fights</legend>
    <% characters = campaign.characters.includes(:job).order(:created_at) %>
    <% if characters.empty? %>
      <p class="empty">This campaign has no characters. <%= link_to "Create one", new_campaign_character_path(campaign), data: { turbo_frame: "_top" } %>.</p>
    <% else %>
      <%= hidden_field_tag "battle[characters][]", "", id: nil %>
      <div class="checks">
        <% characters.each do |character| %>
          <label class="<%= 'muted' unless character.conscious? %>" data-help="<%= character.conscious? ? "Brings their current HP and MP." : "Fallen: starts the battle down." %>">
            <%= check_box_tag "battle[characters][]", character.id, setup[:characters].include?(character.id), id: "battle_character_#{character.id}" %>
            <%= character.name %> <span class="muted">Lv <%= character.level %> <%= character.job.name %>, <%= word("hp") %> <%= character.current_hp %>/<%= character.stats["max_hp"] %></span>
          </label>
        <% end %>
      </div>
      <%= help_line %>
    <% end %>
  </fieldset>
  <%= turbo_frame_tag "forecast", data: { forecast_target: "frame" } %>
  <details class="battle-setup__more">
    <summary>More</summary>
    <div class="field-row">
      <div class="field"><%= f.label :name %><%= f.text_field :name, value: setup[:name] %></div>
      <div class="field">
        <%= f.label :input_seconds, "Input timer" %>
        <%= f.select :input_seconds, BattleRecord::INPUT_TIMERS.map { |s| [ s ? "#{s} seconds" : "None", s ] }, selected: setup[:input_seconds].presence&.to_i %>
      </div>
      <div class="field"><%= f.label :seed %><%= f.number_field :seed, value: setup[:seed], placeholder: "random" %></div>
      <% if types_matter?(world) %>
        <div class="field">
          <%= f.label :terrain, "Where" %>
          <%= f.select :terrain, EncounterTable::TERRAINS.map { |place| [ "#{place.capitalize} (#{type_name(world.terrain_type(place))})", world.terrain_type(place) ] }.uniq(&:last),
                       { selected: setup[:terrain], include_blank: "Anywhere (#{type_name(type_chart(world).plain)})" } %>
        </div>
      <% end %>
      <div class="field field--check">
        <%= f.hidden_field :escapable, value: "0", id: nil %>
        <%= f.check_box :escapable, { checked: setup[:escapable] != "0" }, "1", nil %>
        <%= f.label :escapable, "Can flee" %>
      </div>
    </div>
  </details>
  <div class="actions"><%= f.submit "Start the battle", class: "button play" %></div>
<% end %>
