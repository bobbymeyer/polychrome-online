<%# One broadcast beat (§6): the events, the board before them, and the board after them. The player
    shows `before`, plays the events, and only swaps in `after` when the timeline completes, so the
    broadcast can't spoil the outcome. Log lines line up one-to-one with events. %>
<% @world ||= battle.world # broadcast, so the log speaks the world's words (VocabularyHelper) %>
<div data-controller="battle-beat" data-battle-beat-position-value="<%= position %>"
     data-battle-beat-events-value="<%= events.to_json %>"
     data-battle-beat-abilities-value="<%= battle.field.abilities.transform_values { |a| a.slice('name', 'gesture', 'kind') }.to_json %>">
  <template data-battle-beat-target="before"><%= render "battles/board", battle: battle, field: BattleState.new(before) %></template>
  <template data-battle-beat-target="after"><%= render "battles/board", battle: battle, field: battle.field %></template>
  <template data-battle-beat-target="log"><% field = battle.field %><% events.each do |event| %><li><%= battle_log_line(event, field) %></li><% end %></template>
</div>
