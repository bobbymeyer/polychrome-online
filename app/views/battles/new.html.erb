<% content_for :title, "New battle" %>
<div class="crumbs"><%= link_to @campaign.name, campaign_path(@campaign) %> / New battle</div>
<h1>New battle</h1>
<% if @error %><div class="form-errors" role="alert"><p><%= @error %></p></div><% end %>

<% monsters = @world.monsters.order(:level, :name).map { |m| [ "#{m.name} (Lv #{m.level})", m.slug ] } %>
<%= form_with url: campaign_battles_path(@campaign), scope: :battle, class: "book-form",
              data: { controller: "forecast", forecast_url_value: campaign_forecast_path(@campaign), action: "change->forecast#changed input->forecast#changed" } do |f| %>
  <div class="field-row">
    <div class="field"><%= f.label :name %><%= f.text_field :name, value: @setup[:name] %></div>
    <div class="field">
      <%= f.label :input_seconds, "Input timer" %>
      <%= f.select :input_seconds, BattleRecord::INPUT_TIMERS.map { |s| [ s ? "#{s} seconds" : "None", s ] }, selected: @setup[:input_seconds].presence&.to_i %>
    </div>
    <div class="field"><%= f.label :seed %><%= f.number_field :seed, value: @setup[:seed], placeholder: "random" %></div>
    <% if types_matter? %>
      <div class="field">
        <%= f.label :terrain, "Where" %>
        <%= f.select :terrain, EncounterTable::TERRAINS.map { |place| [ "#{place.capitalize} (#{type_name(@world.terrain_type(place))})", @world.terrain_type(place) ] }.uniq(&:last),
                     { selected: @setup[:terrain], include_blank: "Anywhere (#{type_name(type_chart.plain)})" } %>
      </div>
    <% end %>
    <div class="field field--check">
      <%= f.hidden_field :escapable, value: "0", id: nil %>
      <%= f.check_box :escapable, { checked: @setup[:escapable] != "0" }, "1", nil %>
      <%= f.label :escapable, "Can flee" %>
    </div>
  </div>

  <% antagonists = @campaign.npcs.at_large.includes(:monster).order(:name) %>
  <% if antagonists.any? %>
    <fieldset class="panel">
      <legend>Antagonists</legend>
      <p class="hint">They fight as their Bestiary entry, under their own name, as a boss. Send them off the field and they get away, stronger next time.</p>
      <%= hidden_field_tag "battle[antagonists][]", "", id: nil %>
      <div class="checks">
        <% antagonists.each do |npc| %>
          <label>
            <%= check_box_tag "battle[antagonists][]", npc.id, @setup[:antagonists].include?(npc.id), id: "battle_antagonist_#{npc.id}" %>
            <%= npc.name %> <span class="muted">(as <%= npc.monster.name %><%= ", #{npc.strength_percent}%" if npc.escapes.positive? %>)</span>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <fieldset class="panel">
    <legend>Party</legend>
    <% characters = @campaign.characters.includes(:job).order(:created_at) %>
    <% if characters.empty? %>
      <p class="empty">This campaign has no characters. <%= link_to "Create one", new_campaign_character_path(@campaign) %>.</p>
    <% else %>
      <%= hidden_field_tag "battle[characters][]", "", id: nil %>
      <div class="checks">
        <% characters.each do |character| %>
          <label class="<%= 'muted' unless character.conscious? %>">
            <%= check_box_tag "battle[characters][]", character.id, @setup[:characters].include?(character.id), id: "battle_character_#{character.id}" %>
            <%= character.name %> <span class="muted">Lv <%= character.level %> <%= character.job.name %>, <%= word("hp") %> <%= character.current_hp %>/<%= character.stats["max_hp"] %></span>
          </label>
        <% end %>
      </div>
      <p class="hint">Characters bring their current HP and MP. Fallen characters start the battle down.</p>
    <% end %>
  </fieldset>

  <fieldset class="panel">
    <legend>Encounter</legend>
    <table class="grid-form">
      <thead><tr><th>Monster</th><th>Count</th></tr></thead>
      <tbody>
        <% @setup[:encounter].each_with_index do |row, i| %>
          <tr>
            <td><%= select_tag "battle[encounter][#{i}][monster]", options_for_select(monsters, row[:monster]), include_blank: "(none)", "aria-label": "Monster #{i + 1}" %></td>
            <td><%= number_field_tag "battle[encounter][#{i}][count]", row[:count], min: 1, max: 8, "aria-label": "Monster #{i + 1} count" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </fieldset>

  <%= turbo_frame_tag "forecast", data: { forecast_target: "frame" } %>

  <div class="actions"><%= f.submit "Start battle", class: "button play" %></div>
<% end %>
