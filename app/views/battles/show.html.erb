<% content_for :title, @battle.name %>
<% content_for :head, music_meta(@battle.campaign, @battle.boss? ? "boss" : "battle", fixed: true) %>
<% content_for :head do %>
  <%# The battle screen is one long-lived page (§9.9): never show a stale cached snapshot. %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<% boss_names = @battle.boss? ? @battle.boss_names : [] %>
<%# An antagonist's entrance was their own lines, said before the fight: the card is for a dungeon's monster. %>
<% villains = @battle.enemies.any? { |u| Npc.from_battle_unit(u["id"]) } %>
<% bosses = villains ? [] : @battle.boss_monsters.to_a %>
<% view = @battle.campaign && coop_view(@battle.campaign) %>
<%# A setting for this device, not a move: in the Menu with the rest of the way around (DESIGN.md, "Only the battle"). %>
<% if @battle.campaign %>
  <% content_for :table_menu do %>
    <button type="button" class="link-button" data-battle-fast aria-pressed="false" title="Play battles twice as fast on this device">Fast animations</button>
  <% end %>
<% end %>
<div class="battle<%= " battle--#{view}" if view %><%= " battle--boss" if boss_names.any? %>" data-controller="battle-player dialogue heartbeat<%= " recap" if @battle.campaign %>" data-heartbeat-url-value="<%= battle_watch_path(@battle) %>" <%= tag.attributes(data: { recap_campaign_value: @battle.campaign_id }) if @battle.campaign %>
     <%= tag.attributes(data: { boss_down: ("#{boss_names.to_sentence} #{boss_names.size > 1 ? 'fall' : 'falls'}!" if boss_names.any?) }) %>
     data-battle-player-panel-url-value="<%= battle_panel_path(@battle) %>"
     data-battle-player-words-value="<%= battle_words(@battle.campaign.world).to_json %>"
     data-battle-player-next-value="<%= @battle.battle_actions.count %>"
     data-battle-player-cries-value="<%= (@battle.campaign ? @battle.characters_by_unit.transform_values(&:motive).compact : {}).to_json %>"
     data-dialogue-auto-hide-value="true"
     data-action="battle-beat:arrived->battle-player#enqueue turbo:frame-load->battle-player#panelLoaded keydown@window->battle-player#key click@window->battle-player#fastClick chat-line:arrived->dialogue#arrive turbo:before-stream-render@document->dialogue#streamed dialogue:say@window->dialogue#say">
  <%= turbo_stream_from @battle %>
  <%# The first round's clock waits for each player to say they're ready (BattleRecord#arrive!). %>
  <% if @seat.unit_id && @battle.waiting_for_arrivals? && @battle.still_coming.include?(@seat.unit_id) %>
    <div id="battle_ready" class="battle-ready">
      <%= button_to "Ready", battle_arrival_path(@battle), class: "button play", form: { data: { turbo_stream: true } } %>
      <p class="hint">Choosing your first move counts too. The clock starts once everyone in the fight is ready.</p>
    </div>
  <% end %>
  <%# What's said at the table reaches the battle too (the same signed streams as the table). %>
  <% if @battle.campaign %>
    <%= seat_streams_from @seat, @battle.campaign %>
    <%# The next battle pulls in whoever is still looking at this one's results. %>
    <%= render "shared/stage_stream", campaign: @battle.campaign %>
  <% end %>

  <header class="battle__header">
    <div>
      <p class="eyebrow">
        <%= @battle.campaign ? link_to(@battle.campaign.name, campaign_path(@battle.campaign)) : link_to(@world.name, world_path(@world)) %> · Battle
      </p>
      <h1><%= @battle.name %></h1>
    </div>
    <div class="battle__controls">
      <%= render "battles/playback", battle: @battle %>
      <% unless @battle.campaign %>
        <button type="button" class="button button--quiet" data-battle-fast aria-pressed="false" title="Play battles twice as fast on this device">Fast animations</button>
      <% end %>
      <button type="button" class="button button--quiet" data-battle-player-target="skip"
              data-action="battle-player#skip" title="Or press Enter, Space or Esc" hidden>Skip</button>
    </div>
  </header>

  <div class="stage" data-battle-player-target="stage">
    <%# This round's order, as it plays: who has gone, who's up, who's still to come (battle/board.js). %>
    <ol class="turn-rail" data-battle-player-target="rail" aria-label="This round" hidden></ol>
    <div data-battle-player-target="boardContainer">
      <%= render "battles/board", battle: @battle, state: @battle.state %>
    </div>
    <%# What the round came to, once it's played, until the next one starts. %>
    <p class="round-tally" data-battle-player-target="tally" aria-live="polite" hidden></p>
    <div class="fx" data-battle-player-target="fx" aria-hidden="true"></div>
  </div>

  <div class="battle__lower">
    <% if view == "screen" %>
      <%= turbo_frame_tag "command_panel", src: battle_panel_path(@battle), class: "command-frame",
                          data: { battle_player_target: "panel" } do %>
        <div class="window"><p class="muted">Loading…</p></div>
      <% end %>
    <% else %>
      <%# Commands, and above them what just happened (on a phone the stage may be off-screen, or under your thumb). Pinned on a phone. %>
      <div class="battle__dock">
        <ol class="battle-ticker" data-battle-player-target="ticker" aria-label="What just happened">
          <% @log.last(1).each do |event| %>
            <% line = battle_log_line(event.payload, @battle.state) %>
            <% if line %><li><%= line %></li><% end %>
          <% end %>
        </ol>
        <%= turbo_frame_tag "command_panel", src: battle_panel_path(@battle), class: "command-frame",
                            data: { battle_player_target: "panel" } do %>
          <div class="window"><p class="muted">Loading…</p></div>
        <% end %>
      </div>
    <% end %>

    <%= render "campaigns/tables/dialogue_box", extra: "dialogue--battle" if @battle.campaign && view != "controller" %>
  </div>

  <% if view == "controller" %>
    <p class="coop-links"><%= link_to "Leave controller view", battle_path(@battle, view: "off"), class: "link-button" %></p>
  <% elsif view == "screen" %>
    <p class="hint coop-leave"><%= link_to "Leave the shared screen", battle_path(@battle, view: "off") %></p>
  <% elsif @battle.campaign && (@seat.gm? || @seat.character?) %>
    <%# Talk without leaving the fight: a monster's taunt, a cry across the field. Open for the GM. %>
    <details class="battle-composer" <%= "open" if @seat.gm? %>>
      <summary><%= @seat.gm? ? "Speak (as the narrator or an NPC)" : "Speak" %></summary>
      <%= turbo_frame_tag "composer", src: campaign_composer_path(@battle.campaign), loading: "lazy" do %>
        <div class="window"><p class="muted">Loading…</p></div>
      <% end %>
    </details>
  <% end %>

  <%= render layout: "shared/log_drawer", locals: { self_name: @seat&.character&.name, dockable: @seat&.gm? } do %>
    <section class="battle-log log-drawer__section" aria-label="Battle">
      <h3>Battle</h3>
      <ol data-battle-player-target="log" data-log-drawer-target="list" aria-live="polite">
        <% @log.each do |event| %>
          <% line = battle_log_line(event.payload, @battle.state) %>
          <% if line %><li><%= line %></li><% end %>
        <% end %>
      </ol>
    </section>
    <%= render "campaigns/tables/chat_log", messages: @messages, seat: @seat if @battle.campaign %>
  <% end %>

  <% if (boss = bosses.first) %>
    <%# The boss's entrance: once per viewer, and only before the fight gets going. %>
    <div class="boss-intro" hidden data-controller="boss-intro" data-action="click->boss-intro#skip"
         data-boss-intro-key-value="battle-<%= @battle.id %>"
         data-boss-intro-fresh-value="<%= @battle.round <= 1 && !@battle.over? %>"
         data-boss-intro-name-value="<%= boss_names.first %>"
         data-boss-intro-line-value="<%= boss.boss_line %>"
         data-boss-intro-plate-value="<%= plate_style(boss.slug, boss.colour) %>">
      <div class="boss-card" data-boss-intro-target="card" style="<%= plate_style(boss.slug, boss.colour) %>">
        <span class="boss-card__tag">Boss</span>
        <span class="boss-card__name"><%= boss_names.to_sentence %></span>
      </div>
    </div>
  <% end %>

  <div id="battle_beats" hidden></div>
</div>
