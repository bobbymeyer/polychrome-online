<h2>Take a seat</h2>
<p class="hint">You can sit as your own characters, or as the GM if this is your campaign.</p>
<div class="menu" data-controller="menu" data-menu-primary-value="true" data-menu-autofocus-value="true">
  <%= button_to "Game Master", battle_seat_path(@battle), params: { seat: "gm" }, class: "menu__item" if battle_gm? %>
  <% @battle.party.each do |unit| %>
    <%= button_to unit["name"], battle_seat_path(@battle), params: { seat: unit["id"] }, class: "menu__item" if may_sit?(unit["id"]) %>
  <% end %>
</div>
