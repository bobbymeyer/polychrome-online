<%# After a wipe, the table decides what the story does with it (Campaign::Defeat), and the GM settles it. Replaced by broadcast. %>
<div id="battle_aftermath" aria-live="polite">
<% if battle.status == "defeat" && battle.campaign %>
  <% if (line = battle.settlement&.dig("aftermath")) %>
    <p class="aftermath"><%= line %></p>
  <% elsif battle.campaign.wiped_out? %>
    <p class="aftermath is-waiting">Everyone is KO'd. What happens now? The table decides.</p>
  <% end %>
<% end %>
</div>
