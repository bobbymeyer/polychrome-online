<% result = { "victory" => "Victory!", "defeat" => "The party has fallen.", "fled" => "The party got away.", "abandoned" => "Called off. Nothing came of it." } %>
<% settlement = @battle.settlement || {} %>
<h2><%= result.fetch(@battle.status, @battle.status.humanize) %></h2>

<% if settlement["stolen"].present? %>
  <p>Stolen: <%= settlement["stolen"].to_sentence %>.</p>
<% end %>
<% if settlement["used"].present? %>
  <p>Used <%= settlement["used"].map { |name, n| "#{n} × #{name}" }.to_sentence %>.</p>
<% end %>

<% if settlement["result"] == "victory" %>
  <% levelled = settlement["members"].any? { |m| m["level"] || m["learned"].present? } %>
  <ul class="refs" <%= tag.attributes(data: { controller: "jingle", jingle_name_value: "level_up", jingle_once_value: "levelled-#{@battle.id}" }) if levelled %>>
    <% if settlement["gil"].to_i.positive? %><li><%= money(settlement["gil"]) %> for the party</li><% end %>
    <% if settlement["drops"].present? %><li>Found <%= settlement["drops"].to_sentence %></li><% end %>
    <% settlement["members"].each do |member| %>
      <li>
        <strong><%= member["name"] %></strong>: <%= member["exp"] %> EXP, <%= member["abp"] %> ABP.
        <% if member["to_next"] %><span class="muted"><%= member["to_next"] %> to the next level.</span><% end %>
        <% if member["level"] %><span class="level-up">Level <%= member["level"].last %>!</span><% end %>
        <% if member["learned"].present? %><span class="level-up">Learned <%= member["learned"].to_sentence %>!</span><% end %>
      </li>
    <% end %>
  </ul>
  <%# The moments worth a card of their own: a new ability, an ability or a job mastered. %>
  <% cards = settlement["members"].flat_map do |member|
       Array(member["abilities"]).map { |a| [ "New ability", member["name"], a["name"], a["description"] ] } +
         Array(member["mastered_abilities"]).map { |name| [ "Mastered", member["name"], name, "At full strength, in any job." ] } +
         (member["mastered"] ? [ [ "Mastered", member["name"], member["mastered"]["job"],
                                   (member["mastered"]["passive"] ? "#{GlossaryHelper::PASSIVES.dig(member['mastered']['passive'], 0)} is yours in every job now." : "Every level learned.") ] ] : [])
     end %>
  <% if cards.any? %>
    <div class="reward-cards">
      <% cards.each do |kind, who, what, detail| %>
        <article class="reward-card reward-card--<%= kind.parameterize %>">
          <p class="reward-card__kind"><%= kind %>!</p>
          <h3><%= what %></h3>
          <p class="reward-card__who"><%= who %></p>
          <% if detail.present? %><p class="reward-card__detail"><%= detail %></p><% end %>
        </article>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if battle_gm? %>
  <p class="hint">
    Round <%= @battle.round %> · <%= pluralize(@battle.battle_actions.count, "action") %> ·
    replays exactly from seed <%= @battle.seed %>.
  </p>
<% end %>
<% if @battle.campaign && battle_gm? && @battle.status == "defeat" && @battle.campaign.wiped_out? && !@battle.campaign.battle_on? %>
  <%= render "campaigns/recovery", campaign: @battle.campaign %>
<% end %>
<% if @battle.campaign %>
  <div class="actions" data-controller="return-link">
    <a class="button play" data-return-link-target="link" data-action="return-link#go" data-turbo-frame="_top" hidden></a>
    <% if (inside = @battle.campaign.dungeon_in_progress) %>
      <%= link_to "Back to #{inside.name}", location_path(inside), class: "button", data: { turbo_frame: "_top" } %>
      <%= link_to "Back to the table", campaign_table_path(@battle.campaign), class: "button button--quiet", data: { turbo_frame: "_top" } %>
    <% else %>
      <%= link_to "Back to the table", campaign_table_path(@battle.campaign), class: "button", data: { turbo_frame: "_top" } %>
    <% end %>
    <% if battle_gm? %>
      <%= link_to "Another battle", new_campaign_battle_path(@battle.campaign), class: "button button--quiet", data: { turbo_frame: "_top" } %>
    <% end %>
  </div>
<% end %>
