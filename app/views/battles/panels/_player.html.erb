<% state = @battle.state %>
<% command = state["inputs"][unit["id"]] %>
<div data-controller="menu timing-meter" data-action="submit->timing-meter#intercept" data-menu-primary-value="true" data-menu-autofocus-value="true" data-menu-you-value="<%= unit['id'] %>">
<%# Your HP and MP are on the roster above (and in the party strip below on a phone): the head is your name and the clock. %>
<div class="command-panel__head">
  <h2><%= unit["name"] %></h2>
  <%= render "battles/panels/countdown", battle: @battle %>
</div>
<%# Which round, and what the clock is for: without a choice when it runs out, the default goes in. %>
<p class="command-panel__round">
  <strong>Round <%= @battle.round %></strong>
  <% if @battle.input_seconds && !@battle.over? && !command && unit["hp"].positive? %>
    · Choose before the clock runs out, or you <%= timeout_command(state, unit) %>.
  <% end %>
</p>
<%# Everyone's HP at a glance, for a phone whose pinned panel covers the roster: shown once someone is hurt. %>
<ol class="party-strip" aria-label="Party">
  <% @battle.party.reject { |u| u["gone"] }.each do |member| %>
    <li class="party-strip__member <%= 'is-ko' if member['hp'].zero? %> <%= 'is-hurt' if member['hp'].positive? && member['hp'] < member['stats']['max_hp'] %> <%= 'is-you' if member['id'] == unit['id'] %>">
      <span class="party-strip__name"><%= member["name"] %></span>
      <span class="party-strip__hp"><%= member["hp"] %><span class="muted">/<%= member["stats"]["max_hp"] %></span></span>
      <span class="bar"><span class="bar__fill bar__fill--<%= hp_band(member) %>" style="width: <%= hp_percent(member) %>%"></span></span>
    </li>
  <% end %>
</ol>

<% if unit["hp"].zero? %>
  <p>You're KO'd: you watch until someone raises you.</p>
<% elsif !Battle::State.able_to_act(state).include?(unit["id"]) %>
  <p>You can't act this round (<%= unit["statuses"].map { |s| term(s["kind"]) }.to_sentence %>).</p>
<% elsif @choosing %>
  <% item = @choosing["kind"] == "item" %>
  <div data-choosing>
    <p class="command-panel__prompt"><strong><%= @choosing["name"] %></strong>: choose a target.</p>
    <%# One target a row (docs/DESIGN.md, "Choices are tables"): the cost column says when it won't work, or hits a weakness. %>
    <table class="pick-table play">
      <tbody>
      <% (Battle::State.target_options(state, unit, @choosing) || []).each do |target_id| %>
        <% command = item ? { kind: "item", item: @choosing["id"], target: target_id } : { kind: "ability", ability: @choosing["id"], target: target_id } %>
        <% target_unit = state["units"].find { |u| u["id"] == target_id } %>
        <% futile = !item && futile_note(@battle, state, unit, @choosing, target_unit) %>
        <% edge = !item && !futile && edge_note(@battle, state, unit, @choosing, target_unit) %>
        <tr class="pick-row<%= ' is-futile' if futile %><%= ' is-weak' if edge == 'Weak!' %>">
          <td class="pick-row__what">
            <%= button_to unit_name(state, target_id), battle_actions_path(@battle), class: "pick-row__act",
                          data: { unit_id: target_id, help: [ futile, edge, target_help(@battle, state, target_id) ].compact_blank.join(" · ") }, params: { command: command } %>
          </td>
          <td class="pick-row__cost<%= ' pick-row__cost--edge' if edge %>"><%= futile ? "Won't work" : edge %></td>
        </tr>
      <% end %>
      </tbody>
    </table>
    <p class="menu-help" data-menu-target="help" aria-live="polite"></p>
    <%= link_to "Back", battle_panel_path(@battle, (item ? { items: 1 } : {})), class: "link-button", data: { menu_back: true } %>
  </div>
<% elsif @item_menu %>
  <div data-choosing>
    <p class="command-panel__prompt"><strong>Items</strong>: shared by the whole party.</p>
    <table class="pick-table play">
      <tbody>
      <% state.fetch("items", {}).each_value do |it| %>
        <% left = Battle::State.items_left(state, it["id"], except: unit["id"]) %>
        <% help = item_help(it, left) %>
        <tr class="pick-row">
          <td class="pick-row__what">
            <% if left <= 0 %>
              <button type="button" class="pick-row__act" aria-disabled="true" data-help="<%= help %>" data-menu-key="<%= it['name'] %>" data-reach="<%= it['target'] %>"><%= it["name"] %></button>
            <% elsif Battle::State.target_options(state, unit, it) %>
              <%= link_to it["name"], battle_panel_path(@battle, item: it["id"]), class: "pick-row__act", data: { help: help, menu_key: it["name"], reach: it["target"] } %>
            <% else %>
              <%= button_to it["name"], battle_actions_path(@battle), class: "pick-row__act", data: { help: help, menu_key: it["name"], reach: it["target"] },
                            params: { command: { kind: "item", item: it["id"] } } %>
            <% end %>
          </td>
          <td class="pick-row__cost">×<%= left %></td>
        </tr>
      <% end %>
      </tbody>
    </table>
    <p class="menu-help" data-menu-target="help" aria-live="polite"></p>
    <%= link_to "Back", battle_panel_path(@battle), class: "link-button", data: { menu_back: true } %>
  </div>
<% elsif @trying %>
  <%# "Try something": the player's idea, in words, for the GM to rule on. %>
  <div data-choosing>
    <%= form_with url: battle_actions_path(@battle), scope: :command, class: "book-form try-form" do |f| %>
      <%= f.hidden_field :kind, value: "custom" %>
      <div class="field">
        <%= f.label :text, "What do you try?" %>
        <%= f.text_area :text, rows: 3, maxlength: 200, required: true, placeholder: "Kick the brazier over onto the goblins" %>
      </div>
      <div class="field">
        <%= f.label :target, "At" %>
        <%= f.select :target, state["units"].select { |u| u["hp"].positive? && !u["gone"] }.map { |u| [ u["name"], u["id"] ] }, include_blank: "Nobody in particular" %>
      </div>
      <p class="hint">The GM decides what it takes and what happens if it works; you roll for it on your turn.</p>
      <%= f.submit "Try it", class: "button play" %>
    <% end %>
    <%= link_to "Back", battle_panel_path(@battle), class: "link-button", data: { menu_back: true } %>
  </div>
<% elsif command && !params[:change] %>
  <p data-chosen>
    <% if command["kind"] == "custom" %>
      Ready to try: <strong>“<%= command["text"] %>”</strong>.
      <%= command["ruling"] ? "The GM has ruled: #{stat_label(command['ruling']['stat'])}, #{command['ruling']['difficulty']}." : "Waiting for the GM to rule on it." %>
    <% else %>
      Ready: <strong><%= case command["kind"] when "ability" then ability_name(state, command["ability"]) when "item" then item_name(state, command["item"]) else command["kind"].humanize end %></strong><%= " → #{unit_name(state, command['target'])}" if command["target"] %>.
    <% end %>
    Waiting for <%= (@battle.awaiting_input.map { |id| unit_name(state, id) }.to_sentence.presence || "the round to run") %>.
  </p>
  <%= link_to "Change command", battle_panel_path(@battle, change: 1), class: "link-button", data: { menu_back: true } %>
<% else %>
  <%# Your commands, one a row: what it costs in the right column (docs/DESIGN.md, "Choices are tables"). %>
  <table class="pick-table play">
    <tbody>
    <% unit["abilities"].map { |id| state["abilities"][id] }.each do |ability| %>
      <% usable = Battle::State.usable?(unit, ability) %>
      <% cost = Battle::State.ability_cost(ability) %>
      <% help = ability_help(unit, ability) %>
      <tr class="pick-row">
        <td class="pick-row__what">
          <%# data-reach: what the move would reach, lit on the field while the cursor is on it (menu_controller). %>
          <% if !usable %>
            <button type="button" class="pick-row__act" aria-disabled="true" data-help="<%= help %>" data-menu-key="<%= ability['name'] %>" data-reach="<%= ability['target'] %>"><%= ability["name"] %></button>
          <% elsif Battle::State.target_options(state, unit, ability) %>
            <%= link_to ability["name"], battle_panel_path(@battle, ability: ability["id"]), class: "pick-row__act", data: { help: help, menu_key: ability["name"], reach: ability["target"] } %>
          <% else %>
            <%= button_to ability["name"], battle_actions_path(@battle), class: "pick-row__act", data: { help: help, menu_key: ability["name"], reach: ability["target"] },
                          params: { command: { kind: "ability", ability: ability["id"] } } %>
          <% end %>
        </td>
        <td class="pick-row__cost"><%= "#{cost} #{word('mp')}" if cost.positive? %></td>
      </tr>
    <% end %>
    <% if state.fetch("items", {}).any? %>
      <tr class="pick-row">
        <td class="pick-row__what"><%= link_to "Item", battle_panel_path(@battle, items: 1), class: "pick-row__act", data: { help: "Use something from the party's bag.", menu_key: "Item" } %></td>
        <td class="pick-row__cost">×<%= state["items"].values.sum { |i| Battle::State.items_left(state, i["id"], except: unit["id"]) } %></td>
      </tr>
    <% end %>
    <tr class="pick-row">
      <td class="pick-row__what"><%= link_to "Try something", battle_panel_path(@battle, custom: 1), class: "pick-row__act",
                                            data: { help: "Anything that isn't on the menu. Say what you do; the GM rules on it, and you roll.", menu_key: "Try" } %></td>
      <td class="pick-row__cost"></td>
    </tr>
    <tr class="pick-row">
      <td class="pick-row__what"><%= button_to "Defend", battle_actions_path(@battle), class: "pick-row__act", data: { help: "Halve the damage you take this round.", reach: "self" },
                                              params: { command: { kind: "defend" } } %></td>
      <td class="pick-row__cost"></td>
    </tr>
    <% if state["escapable"] %>
      <tr class="pick-row">
        <td class="pick-row__what"><%= button_to "Flee", battle_actions_path(@battle), class: "pick-row__act", data: { help: "Try to get the whole party away. It can fail.", menu_forget: true },
                                                params: { command: { kind: "flee" } } %></td>
        <td class="pick-row__cost"></td>
      </tr>
    <% end %>
    <%# Talk, and let the fight run: the last row is Auto, its state in the cost column. Picking a command yourself takes you off it. %>
    <% on = @battle.auto?(unit["id"]) %>
    <% everyone = on && (@battle.party.select { |u| u["hp"].positive? }.map { |u| u["id"] } - @battle.auto_units).empty? %>
    <tr class="pick-row auto-row<%= ' is-on' if on %>">
      <td class="pick-row__what"><%= button_to "Auto", battle_auto_path(@battle), method: :patch, params: { unit: unit["id"], on: on ? "0" : "1" }, class: "pick-row__act",
                                              aria: { pressed: on }, data: { menu_forget: true, menu_key: "Auto",
                                                                             help: (on ? "Auto is on: every round, your last command (or Attack). Picking a command yourself takes you off it.#{' Everyone is on auto, so each round waits for the timer or the GM: a fight never plays itself out.' if everyone}" : "Go on auto: chat, and let the fight run. Every round, your last command (or Attack), until you pick one yourself.") } %></td>
      <td class="pick-row__cost"><%= on ? "on" : "off" %></td>
    </tr>
    </tbody>
  </table>
  <p class="menu-help" data-menu-target="help" aria-live="polite"></p>
<% end %>
<% if command && !params[:change] && unit["hp"].positive? %>
  <%# Chosen, and waiting: the one thing left to do is go on auto (or come off it) to chat while the fight runs. %>
  <% on = @battle.auto?(unit["id"]) %>
  <%= button_to on ? "Auto is on" : "Go on auto", battle_auto_path(@battle), method: :patch, params: { unit: unit["id"], on: on ? "0" : "1" },
                class: [ "link-button", "auto-toggle", ("is-on" if on) ], form: { class: "auto-toggle-form" }, aria: { pressed: on },
                title: on ? "Every round, your last command (or Attack), until you pick one yourself" : "Chat, and let the fight run: every round, your last command (or Attack)" %>
<% end %>
<%# The keys, once a key has been used (menu_controller marks the panel); never on a phone. %>
<p class="keys">Arrows move · Enter choose · Esc back · 1–9 pick</p>
</div>
