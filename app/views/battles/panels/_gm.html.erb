<% field = @battle.field %>
<% awaiting = field.awaiting_input %>
<div class="command-panel__head">
  <h2>Game Master · Round <%= @battle.round %></h2>
  <%= render "battles/panels/countdown", battle: @battle %>
</div>
<%# What the round is waiting on, by its clock: the GM shouldn't read the table to find out. %>
<% unless @battle.over? %>
  <p class="command-panel__waiting">
    <%= awaiting.any? ? "Waiting on #{awaiting.map { |id| field.unit_name(id) }.to_sentence}." : "Everyone has chosen: the round runs." %>
  </p>
<% end %>

<% ideas = field.ideas_awaiting_ruling %>
<% if ideas.any? %>
  <section class="rulings">
    <h3>Ideas to rule on <span class="muted">(the round, and its clock, wait for you)</span></h3>
    <% ideas.each do |id, idea| %>
      <%= form_with url: battle_actions_path(@battle), scope: :gm, class: "book-form ruling" do |f| %>
        <%= f.hidden_field :op, value: "rule" %>
        <%= f.hidden_field :unit, value: id %>
        <p class="ruling__idea"><strong><%= field.unit_name(id) %></strong> tries: “<%= idea.text %>”<%= " at #{field.unit_name(idea.target)}" if idea.target %></p>
        <%# Three things decide most rulings: what they roll, how hard it is, what happens if it works. The rest
            (how much, a type, a status, on whom, the two lines) waits behind More with its usual answers. %>
        <div class="field-row ruling__three">
          <div class="field"><%= f.label :stat, "Roll", for: "rule_stat_#{id}" %><%= f.select :stat, check_options(@battle.world), {}, id: "rule_stat_#{id}" %></div>
          <div class="field"><%= f.label :difficulty, "How hard", for: "rule_difficulty_#{id}" %><%= f.select :difficulty, Stats::Check::DIFFICULTIES.keys.map { |d| [ d.capitalize, d ] }, { selected: "normal" }, id: "rule_difficulty_#{id}" %></div>
          <div class="field">
            <%= f.label :effect, "If it works", for: "rule_effect_#{id}" %>
            <%= f.select :effect, [ [ "Just the story", "none" ], [ "Damage", "damage" ], [ "A status", "status" ], [ "Healing", "heal" ] ], { selected: "damage" }, id: "rule_effect_#{id}" %>
          </div>
        </div>
        <details class="ruling__more">
          <summary>More</summary>
          <div class="field-row">
            <div class="field"><%= f.label :strength, "How much", for: "rule_strength_#{id}" %><%= f.select :strength, %w[light medium heavy].map { |x| [ x.capitalize, x ] }, { selected: "medium" }, id: "rule_strength_#{id}" %></div>
            <% battle_types = Battle::Types.list(field.types) %>
            <% if battle_types.size > 1 %>
              <div class="field"><%= f.label :type, "Type", for: "rule_type_#{id}" %><%= f.select :type, battle_types.map { |t| [ type_name(t), t ] }, { include_blank: "None" }, id: "rule_type_#{id}" %></div>
            <% end %>
            <div class="field"><%= f.label :status, "Status", for: "rule_status_#{id}" %><%= f.select :status, Battle::STATUSES.map { |st| [ term(st), st ] }, { include_blank: true }, id: "rule_status_#{id}" %></div>
            <div class="field">
              <%= f.label :aim, "On", for: "rule_aim_#{id}" %>
              <%= f.select :aim, [ [ idea.target ? "Their target" : "One enemy", "single_enemy" ], [ "Every enemy", "all_enemies" ], [ "One ally", "single_ally" ], [ "The whole party", "all_allies" ], [ "Themselves", "self" ] ], {}, id: "rule_aim_#{id}" %>
            </div>
          </div>
          <div class="field-row">
            <div class="field"><%= f.label :success, "If it works, the table hears", for: "rule_success_#{id}" %><%= f.text_field :success, id: "rule_success_#{id}", placeholder: "The brazier tips, and coals go everywhere!" %></div>
            <div class="field"><%= f.label :failure, "If it doesn't", for: "rule_failure_#{id}" %><%= f.text_field :failure, id: "rule_failure_#{id}", placeholder: "It's heavier than it looks." %></div>
          </div>
        </details>
        <%= f.submit "Rule", class: "button play" %>
      <% end %>
    <% end %>
  </section>
<% end %>

<%# Who's fighting, one table a side. The party's rows say, in one column, who chooses each one's
    command this round (their player, or auto) and the buttons to change it, so it's said once. %>
<% party_ids = @battle.party.map(&:id) %>
<%# Each side as rows, one a unit (gm-rows): name, HP and MP, conditions, and for the party who chooses, with
    one button only when it matters: Auto while a player holds the round up, Hand back while auto is on,
    Send off for a guest. Auto is one thing: the rest of the battle (BattleRecord#set_auto!), this round too. %>
<section>
  <h3>The party</h3>
  <ul class="gm-rows" aria-label="The party">
    <% field.on_field("party").each do |u| %>
      <li class="gm-row <%= 'is-ko' if u.ko? %> <%= 'is-low' if u.hp_band == 'danger' %>">
        <span class="gm-row__name"><%= u.name %><%= tag.span(" · guest", class: "muted") if u.guest? %></span>
        <span class="gm-row__vitals"><span class="label">HP</span> <strong><%= u.hp %></strong><span class="muted">/<%= u.max_hp %></span> <span class="label">MP</span> <%= u.mp %><span class="muted">/<%= u.max_mp %></span></span>
        <% if (what = unit_conditions(u)).present? %><span class="gm-row__conditions muted"><%= what %></span><% end %>
        <span class="gm-row__who">
          <% if u.guest? %>
            <span class="muted">The GM's guest</span>
            <% if u.standing? && !@battle.over? %>
              <%= button_to "Send off", battle_actions_path(@battle), class: "link-button", params: { gm: { op: "dismiss", unit: u.id } },
                            form: { class: "inline", data: { turbo_confirm: "#{u.name} leaves the fight?" } } %>
            <% end %>
          <% elsif u.ko? %>
            <span class="muted">KO'd</span>
          <% elsif party_ids.include?(u.id) && @battle.auto?(u.id) %>
            <strong>Auto</strong>
            <%= button_to "Hand back", battle_auto_path(@battle), method: :patch, params: { unit: u.id, on: "0" },
                          class: "link-button", form: { class: "inline" }, title: "Their player chooses again" %>
          <% elsif awaiting.include?(u.id) %>
            <strong>Waiting on their player</strong>
            <% if party_ids.include?(u.id) %>
              <%= button_to "Auto", battle_auto_path(@battle), method: :patch, params: { unit: u.id, on: "1" },
                            class: "link-button", form: { class: "inline" }, title: "Their default command, this round and the rest; Hand back when they're here" %>
            <% end %>
          <% else %>
            <span class="muted">Chosen</span>
          <% end %>
        </span>
      </li>
    <% end %>
  </ul>
  <p class="hint">Auto takes a character's default command, their last one or Attack, this round and each after, until Hand back; characters nobody plays start on it, and a player who sits down and chooses takes theirs back.</p>
  <% if awaiting.any? %>
    <%= button_to "Run the round now", battle_actions_path(@battle), class: "button play", params: { gm: { op: "execute_round" } } %>
  <% end %>
</section>

<section>
  <h3>The other side</h3>
  <ul class="gm-rows" aria-label="The other side">
    <% field.on_field("enemy").each do |u| %>
      <li class="gm-row <%= 'is-ko' if u.ko? %> <%= 'is-low' if u.hp_band == 'danger' %>">
        <span class="gm-row__name"><%= u.name %></span>
        <span class="gm-row__vitals"><span class="label">HP</span> <strong><%= u.hp %></strong><span class="muted">/<%= u.max_hp %></span> <span class="label">MP</span> <%= u.mp %><span class="muted">/<%= u.max_mp %></span></span>
        <% if (what = unit_conditions(u)).present? %><span class="gm-row__conditions muted"><%= what %></span><% end %>
        <span class="gm-row__who">
          <% if u.standing? && !@battle.over? %>
            <%= button_to "Make it flee", battle_actions_path(@battle), class: "link-button", params: { gm: { op: "dismiss", unit: u.id } },
                          form: { class: "inline", data: { turbo_confirm: "#{u.name} runs off? It gives no EXP or drops." } } %>
          <% elsif u.ko? %>
            <span class="muted">Down</span>
          <% end %>
        </span>
      </li>
    <% end %>
  </ul>
</section>

<%# What the GM rarely needs mid-fight, folded away: the round and its ending stay in sight. %>
<details class="gm-controls">
  <summary>GM controls <span class="muted">(someone joins, overrides, pacing)</span></summary>
  <details class="gm-override">
    <summary>Someone joins <span class="muted">(reinforcements, or a guest on the party's side)</span></summary>
    <%= form_with url: battle_actions_path(@battle), scope: :gm, class: "book-form" do |f| %>
      <%= f.hidden_field :op, value: "add_unit" %>
      <div class="field-row">
        <div class="field">
          <%= f.label :side, "Side" %>
          <%= f.select :side, [ [ "The enemy", "enemy" ], [ "The party (a guest, on their own script)", "party" ] ] %>
        </div>
        <div class="field">
          <%= f.label :monster, "From the Bestiary" %>
          <%= f.select :monster, monster_options(@battle.world.monsters) %>
        </div>
        <div class="field">
          <%= f.label :name, "Name" %>
          <%= f.text_field :name, placeholder: "Its own", list: "gm_join_names" %>
          <% if @battle.campaign %>
            <datalist id="gm_join_names"><% @battle.campaign.npcs.order(:name).each do |npc| %><option value="<%= npc.name %>"></option><% end %></datalist>
          <% end %>
        </div>
      </div>
      <div class="field"><%= f.label :note, "Note for the table" %><%= f.text_field :note, placeholder: "“More of them!”" %></div>
      <p class="hint">A guest fights with the Bestiary entry's stats and script, under the name you give it (an NPC's, say). Guests take no seat and share no rewards.</p>
      <%= f.submit "Bring them in", class: "button" %>
    <% end %>
  </details>

  <details class="gm-override">
    <summary>Override <span class="muted">(logged for everyone to see)</span></summary>
    <%= form_with url: battle_actions_path(@battle), scope: :gm, class: "book-form" do |f| %>
      <div class="field-row">
        <div class="field">
          <%= f.label :op, "Change" %>
          <%= f.select :op, [ [ "Set HP", "set_hp" ], [ "Set MP", "set_mp" ], [ "Inflict status", "add_status" ], [ "Cure status", "remove_status" ] ] %>
        </div>
        <div class="field">
          <%= f.label :unit %>
          <%= f.select :unit, field.units.map { |u| [ u.name, u.id ] } %>
        </div>
        <div class="field"><%= f.label :value, "HP / MP" %><%= f.number_field :value, min: 0 %></div>
        <div class="field">
          <%= f.label :status %>
          <%= f.select :status, (Battle::STATUSES - Battle::PRIMITIVE_STATUSES).map { |s| [ term(s), s ] }, include_blank: true %>
        </div>
        <div class="field"><%= f.label :turns %><%= f.number_field :turns, min: 1, placeholder: 3 %></div>
      </div>
      <div class="field"><%= f.label :note, "Note for the table" %><%= f.text_field :note, placeholder: "optional" %></div>
      <%= f.submit "Apply override", class: "button" %>
    <% end %>
  </details>

  <section>
    <h3>Pacing</h3>
    <div class="actions actions--tight">
      <% BattleRecord::SPEEDS.each do |speed| %>
        <%= button_to "×#{speed}", battle_playback_path(@battle), method: :patch, params: { speed: speed },
                      class: "button button--quiet", aria: { pressed: @battle.playback_speed == speed } %>
      <% end %>
    </div>
  </section>
</details>

<section>
  <h3>End the battle</h3>
  <div class="actions actions--tight">
    <% { "victory" => "Victory", "defeat" => "Defeat", "fled" => "Party escapes" }.each do |result, label| %>
      <%= button_to label, battle_actions_path(@battle), class: "button button--quiet", params: { gm: { op: "end_battle", result: result } },
                    form: { data: { turbo_confirm: "End the battle: #{label}? Everyone will see this." } } %>
    <% end %>
    <%= button_to "Call it off", battle_call_off_path(@battle), class: "button button--quiet",
                  form: { data: { turbo_frame: "_top", turbo_confirm: "Call off #{@battle.name}? Nothing that happened in it counts: no rewards, and HP and items go back to how they were." } } %>
  </div>
  <p class="hint">Calling it off is for a battle nobody will finish. It stops the table pointing at it.</p>
</section>
