<% state = @battle.state %>
<% awaiting = @battle.awaiting_input %>
<div class="command-panel__head">
  <h2>Game Master · Round <%= @battle.round %></h2>
  <%= render "battles/panels/countdown", battle: @battle %>
</div>

<% ideas = state["inputs"].select { |_, c| c["kind"] == "custom" && !c["ruling"] } %>
<% if ideas.any? %>
  <section class="rulings">
    <h3>Ideas to rule on <span class="muted">(the round, and its clock, wait for you)</span></h3>
    <% ideas.each do |id, idea| %>
      <%= form_with url: battle_actions_path(@battle), scope: :gm, class: "book-form ruling" do |f| %>
        <%= f.hidden_field :op, value: "rule" %>
        <%= f.hidden_field :unit, value: id %>
        <p class="ruling__idea"><strong><%= unit_name(state, id) %></strong> tries: “<%= idea["text"] %>”<%= " at #{unit_name(state, idea['target'])}" if idea["target"] %></p>
        <div class="field-row">
          <div class="field"><%= f.label :stat, "Roll", for: "rule_stat_#{id}" %><%= f.select :stat, check_options(@battle.world), {}, id: "rule_stat_#{id}" %></div>
          <div class="field"><%= f.label :difficulty, "How hard", for: "rule_difficulty_#{id}" %><%= f.select :difficulty, Stats::Check::DIFFICULTIES.keys.map { |d| [ d.capitalize, d ] }, { selected: "normal" }, id: "rule_difficulty_#{id}" %></div>
          <div class="field">
            <%= f.label :effect, "If it works", for: "rule_effect_#{id}" %>
            <%= f.select :effect, [ [ "Just the story", "none" ], [ "Damage", "damage" ], [ "A status", "status" ], [ "Healing", "heal" ] ], { selected: "damage" }, id: "rule_effect_#{id}" %>
          </div>
          <div class="field"><%= f.label :strength, "How much", for: "rule_strength_#{id}" %><%= f.select :strength, %w[light medium heavy].map { |x| [ x.capitalize, x ] }, { selected: "medium" }, id: "rule_strength_#{id}" %></div>
          <% battle_types = Battle::Types.list(@battle.state["types"] || Battle::Types::DEFAULT) %>
          <% if battle_types.size > 1 %>
            <div class="field"><%= f.label :type, "Type", for: "rule_type_#{id}" %><%= f.select :type, battle_types.map { |t| [ type_name(t), t ] }, { include_blank: "None" }, id: "rule_type_#{id}" %></div>
          <% end %>
          <div class="field"><%= f.label :status, "Status", for: "rule_status_#{id}" %><%= f.select :status, Battle::STATUSES.map { |st| [ term(st), st ] }, { include_blank: true }, id: "rule_status_#{id}" %></div>
          <div class="field">
            <%= f.label :aim, "On", for: "rule_aim_#{id}" %>
            <%= f.select :aim, [ [ idea["target"] ? "Their target" : "One enemy", "single_enemy" ], [ "Every enemy", "all_enemies" ], [ "One ally", "single_ally" ], [ "The whole party", "all_allies" ], [ "Themselves", "self" ] ], {}, id: "rule_aim_#{id}" %>
          </div>
        </div>
        <div class="field-row">
          <div class="field"><%= f.label :success, "If it works, the table hears", for: "rule_success_#{id}" %><%= f.text_field :success, id: "rule_success_#{id}", placeholder: "The brazier tips, and coals go everywhere!" %></div>
          <div class="field"><%= f.label :failure, "If it doesn't", for: "rule_failure_#{id}" %><%= f.text_field :failure, id: "rule_failure_#{id}", placeholder: "It's heavier than it looks." %></div>
        </div>
        <%= f.submit "Rule", class: "button play" %>
      <% end %>
    <% end %>
  </section>
<% end %>

<section>
  <h3>Waiting on</h3>
  <% if awaiting.empty? %>
    <p class="muted">Nobody.</p>
  <% else %>
    <div class="menu menu--row">
      <% awaiting.each do |id| %>
        <%= button_to "Auto #{unit_name(state, id)}", battle_actions_path(@battle), class: "menu__item",
                      params: { gm: { op: "auto", unit: id } }, title: "Their default command, this round only" %>
      <% end %>
      <%= button_to "Run the round now", battle_actions_path(@battle), class: "menu__item menu__item--accent",
                    params: { gm: { op: "execute_round" } } %>
    </div>
  <% end %>
</section>

<section>
  <h3>On auto every round</h3>
  <div class="menu menu--row">
    <% @battle.party.each do |u| %>
      <% on = @battle.auto?(u["id"]) %>
      <%= button_to battle_auto_path(@battle), method: :patch, params: { unit: u["id"], on: on ? "0" : "1" },
                    class: [ "menu__item", ("is-current" if on) ], aria: { pressed: on } do %>
        <%= unit_name(state, u["id"]) %> <span class="menu__cost"><%= on ? "auto" : "off" %></span>
      <% end %>
    <% end %>
  </div>
  <p class="hint">For characters nobody is playing: they take their default command as each round opens. Unclaimed characters start on auto; a player who sits down and chooses takes theirs back.</p>
</section>

<section>
  <h3>Units</h3>
  <table class="book-table book-table--plain gm-units">
    <thead><tr><th>Unit</th><th class="num">HP</th><th class="num">MP</th><th>Status</th><th><span class="visually-hidden">Leave</span></th></tr></thead>
    <tbody>
      <% state["units"].reject { |u| u["gone"] }.each do |u| %>
        <tr class="<%= 'is-ko' if u['hp'].zero? %> <%= 'is-low' if hp_band(u) == 'danger' %>">
          <td><%= u["name"] %></td>
          <td class="num"><%= u["hp"] %>/<%= u["stats"]["max_hp"] %></td>
          <td class="num"><%= u["mp"] %>/<%= u["stats"]["max_mp"] %></td>
          <td><%= (u["statuses"].map { |s| "#{term(s['kind'])} (#{s['turns']})" } + u["buffs"].map { |b| "#{stat_label(b['stat'])} #{signed(b['amount'])}%" }).join(", ") %></td>
          <td>
            <% if (u["side"] == "enemy" || u["guest"]) && u["hp"].positive? && !@battle.over? %>
              <%= button_to u["guest"] ? "Send off" : "Make it flee", battle_actions_path(@battle), class: "link-button",
                            params: { gm: { op: "dismiss", unit: u["id"] } },
                            form: { data: { turbo_confirm: u["guest"] ? "#{u['name']} leaves the fight?" : "#{u['name']} runs off? It gives no EXP or drops." } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<details class="gm-override">
  <summary>Someone joins <span class="muted">(reinforcements, or a guest on the party's side)</span></summary>
  <%= form_with url: battle_actions_path(@battle), scope: :gm, class: "book-form" do |f| %>
    <%= f.hidden_field :op, value: "add_unit" %>
    <div class="field-row">
      <div class="field">
        <%= f.label :side, "Side" %>
        <%= f.select :side, [ [ "The enemy", "enemy" ], [ "The party (a guest, on their own script)", "party" ] ] %>
      </div>
      <div class="field">
        <%= f.label :monster, "From the Bestiary" %>
        <%= f.select :monster, @battle.world.monsters.order(:level, :name).map { |m| [ "#{m.name} (Lv #{m.level})", m.slug ] } %>
      </div>
      <div class="field">
        <%= f.label :name, "Name" %>
        <%= f.text_field :name, placeholder: "Its own", list: "gm_join_names" %>
        <% if @battle.campaign %>
          <datalist id="gm_join_names"><% @battle.campaign.npcs.order(:name).each do |npc| %><option value="<%= npc.name %>"></option><% end %></datalist>
        <% end %>
      </div>
    </div>
    <div class="field"><%= f.label :note, "Note for the table" %><%= f.text_field :note, placeholder: "“More of them!”" %></div>
    <p class="hint">A guest fights with the Bestiary entry's stats and script, under the name you give it (an NPC's, say). Guests take no seat and share no rewards.</p>
    <%= f.submit "Bring them in", class: "button" %>
  <% end %>
</details>

<details class="gm-override">
  <summary>Override <span class="muted">(logged for everyone to see)</span></summary>
  <%= form_with url: battle_actions_path(@battle), scope: :gm, class: "book-form" do |f| %>
    <div class="field-row">
      <div class="field">
        <%= f.label :op, "Change" %>
        <%= f.select :op, [ [ "Set HP", "set_hp" ], [ "Set MP", "set_mp" ], [ "Inflict status", "add_status" ], [ "Cure status", "remove_status" ] ] %>
      </div>
      <div class="field">
        <%= f.label :unit %>
        <%= f.select :unit, state["units"].map { |u| [ u["name"], u["id"] ] } %>
      </div>
      <div class="field"><%= f.label :value, "HP / MP" %><%= f.number_field :value, min: 0 %></div>
      <div class="field">
        <%= f.label :status %>
        <%= f.select :status, (Battle::STATUSES - Battle::PRIMITIVE_STATUSES).map { |s| [ term(s), s ] }, include_blank: true %>
      </div>
      <div class="field"><%= f.label :turns %><%= f.number_field :turns, min: 1, placeholder: 3 %></div>
    </div>
    <div class="field"><%= f.label :note, "Note for the table" %><%= f.text_field :note, placeholder: "optional" %></div>
    <%= f.submit "Apply override", class: "button" %>
  <% end %>
</details>

<section>
  <h3>Pacing</h3>
  <div class="menu menu--row">
    <% BattleRecord::SPEEDS.each do |speed| %>
      <%= button_to "×#{speed}", battle_playback_path(@battle), method: :patch, params: { speed: speed },
                    class: [ "menu__item", ("is-current" if @battle.playback_speed == speed) ] %>
    <% end %>
  </div>
</section>

<section>
  <h3>End the battle</h3>
  <div class="menu menu--row">
    <% { "victory" => "Victory", "defeat" => "Defeat", "fled" => "Party escapes" }.each do |result, label| %>
      <%= button_to label, battle_actions_path(@battle), class: "menu__item", params: { gm: { op: "end_battle", result: result } },
                    form: { data: { turbo_confirm: "End the battle: #{label}? Everyone will see this." } } %>
    <% end %>
    <%= button_to "Call it off", battle_call_off_path(@battle), class: "menu__item",
                  form: { data: { turbo_frame: "_top", turbo_confirm: "Call off #{@battle.name}? Nothing that happened in it counts: no rewards, and HP and items go back to how they were." } } %>
  </div>
  <p class="hint">Calling it off is for a battle nobody will finish. It stops the table pointing at it.</p>
</section>
