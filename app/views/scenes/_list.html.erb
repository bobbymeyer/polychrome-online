<%# The GM's prepared scenes, unplayed first. On the table, each can be put on the stage; the one on it
    is stepped from the Now line. %>
<% scenes = campaign.scenes.in_order.includes(:map_node, :beats).to_a %>
<% if scenes.empty? %>
  <p class="empty">No scenes yet. Write one before the session: its beats play in order at the press of a button, and it can end in a battle or a new place on the map.</p>
<% else %>
  <ol class="scene-list">
    <% scenes.each do |scene| %>
      <li class="scene-list__item<%= ' is-played' if scene.played? %><%= ' is-staged' if scene.staged? %>" data-filter-target="item">
        <div>
          <strong><%= "✅ " if scene.played? %><%= scene.name %></strong>
          <span class="muted"><%= scene.summary %><%= " · played #{time_ago_in_words(scene.played_at)} ago" if scene.played? %><%= " · on the stage, beat #{scene.cursor + 1}" if scene.staged? %></span>
        </div>
        <div class="scene-list__actions">
          <% if local_assigns[:play] %>
            <% if scene.staged? %>
              <%= button_to "Take it down", scene_play_path(scene), method: :delete, class: "button button--quiet", form: { class: "inline" } %>
            <% else %>
              <%= button_to scene.played? ? "Play again" : "Play", scene_play_path(scene), class: ["button", ("play" unless scene.played?), ("button--quiet" if scene.played?)],
                            form: { class: "inline", data: ({ turbo_confirm: "Play #{scene.name} again?" } if scene.played?) }, disabled: scene.beats.empty? %>
            <% end %>
          <% end %>
          <%= link_to "Edit", edit_scene_path(scene), class: "button button--quiet", data: { turbo_frame: "_top" } %>
        </div>
      </li>
    <% end %>
  </ol>
<% end %>
