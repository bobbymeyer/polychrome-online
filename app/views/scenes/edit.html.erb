<% content_for :title, @scene.name %>
<%= turbo_stream_from @scene, :art %>
<div class="crumbs"><%= link_to @campaign.name, campaign_path(@campaign) %> / <%= link_to "Prep", campaign_prep_path(@campaign, anchor: "scenes") %> / <%= @scene.name %></div>
<div class="book-header">
  <div>
    <p class="eyebrow"><%= @scene.summary %><%= " · on the stage now" if @scene.staged? %></p>
    <h1><%= @scene.name %></h1>
  </div>
  <div class="actions">
    <%= button_to(@scene.staged? ? "Take it off the stage" : "Put it on the stage", scene_play_path(@scene),
                  method: (@scene.staged? ? :delete : :post), class: [ "button", ("play" unless @scene.staged?) ], form: { class: "inline" },
                  disabled: @scene.beats.empty?) %>
    <%= link_to "Open the table", campaign_table_path(@campaign), class: "button button--quiet" %>
  </div>
</div>
<%= render "form", scene: @scene %>

<div class="scene-builder">
  <%= render "scenes/sequencer", scene: @scene, chosen: @beat %>
  <%= turbo_frame_tag "scene_preview", class: "scene-builder__side" do %>
    <%= render "scenes/preview", beat: @beat %>
    <% if @beat %>
      <%= turbo_frame_tag "art_panel", data: { src: world_art_panel_path(@world, entry_type: "beat", beat_id: @beat.id) } do %>
        <%= render "art_batches/beat_panel", beat: @beat %>
      <% end %>
    <% end %>
  <% end %>
</div>

<%= button_to "Delete this scene", scene_path(@scene), method: :delete, class: "button button--quiet",
              form: { data: { turbo_confirm: "Delete #{@scene.name}?" } } %>
