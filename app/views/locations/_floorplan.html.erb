<%# A dungeon's floorplan (§7): rooms and paths, drawn from generator output.
    shown: room keys drawn in full; known: keys drawn as unexplored exits ("?"); both nil = show all.
    current: the party's room. resolved: room keys whose decision has been dealt with.
    unlocked: lock ids the party has opened. %>
<% shown = local_assigns[:shown] %>
<% known = local_assigns[:known] || [] %>
<% current = local_assigns[:current] %>
<% resolved = local_assigns[:resolved] || [] %>
<% unlocked = local_assigns[:unlocked] || [] %>
<% full = ->(key) { shown.nil? || shown.include?(key) } %>
<% drawn = ->(key) { full.(key) || known.include?(key) } %>
<% rooms = view.fetch("rooms", []).select { |r| drawn.(r["key"]) }.index_by { |r| r["key"] } %>
<svg class="floorplan" viewBox="0 0 <%= Generators::Dungeon::WIDTH %> <%= Generators::Dungeon::HEIGHT %>" role="img"
     aria-label="Floorplan of <%= view['name'] %><%= ", the party is in #{rooms[current]['name']}" if current && rooms[current] %>">
  <rect class="floorplan__rock" x="0" y="0" width="<%= Generators::Dungeon::WIDTH %>" height="<%= Generators::Dungeon::HEIGHT %>" />
  <% view.fetch("paths", []).each do |path| %>
    <% a = rooms[path["from"]] %>
    <% b = rooms[path["to"]] %>
    <% next unless a && b && (full.(a["key"]) || full.(b["key"])) %>
    <g class="floorplan__path <%= 'floorplan__path--costly' if path['cost'] %>">
      <title><%= if path["lock"] then "#{path['lock']['name']}: needs #{path['lock']['key_name']}" elsif path["cost"] then "Cost: #{path['cost']}" else [ a, b ].map { |r| full.(r["key"]) ? r["name"] : "an unexplored way" }.join(" – ") end %></title>
      <line x1="<%= a['x'] %>" y1="<%= a['y'] %>" x2="<%= b['x'] %>" y2="<%= b['y'] %>" />
      <% if path["lock"] %>
        <%# A padlock on the path, a little off its middle so a cost marker still shows; hollow once opened. %>
        <g class="floorplan__lock <%= 'is-open' if unlocked.include?(path['lock']['id']) %>"
           transform="translate(<%= (a['x'] + b['x'] * 2) / 3 %> <%= (a['y'] + b['y'] * 2) / 3 %>)">
          <path class="floorplan__lock-shackle" d="M-5,-2 V-7 A5,5 0 0 1 5,-7 V-2" />
          <rect class="floorplan__lock-body" x="-8" y="-2" width="16" height="12" />
        </g>
      <% end %>
      <% if path["cost"] %>
        <rect class="floorplan__cost" x="-6" y="-6" width="12" height="12" transform="translate(<%= (a['x'] + b['x']) / 2 %> <%= (a['y'] + b['y']) / 2 %>) rotate(45)" />
      <% end %>
    </g>
  <% end %>
  <% rooms.each_value do |room| %>
    <% open = full.(room["key"]) %>
    <g class="floorplan__room <%= 'is-unknown' unless open %> <%= 'is-current' if room['key'] == current %> <%= 'is-resolved' if resolved.include?(room['key']) %> <%= "is-#{room['decision']['kind']}" if open %>"
       transform="translate(<%= room['x'] %> <%= room['y'] %>)">
      <title><%= open ? "#{room['name']}: #{room['decision']['kind']}" : "Unexplored" %></title>
      <rect x="-58" y="-24" width="116" height="48" />
      <% if open %>
        <g transform="translate(-44 0)"><%= render "locations/marker", kind: room["decision"]["kind"] %></g>
        <% lines = room_name_lines(room["name"]) %>
        <text class="floorplan__name<%= " floorplan__name--#{lines.size}" if lines.size > 1 %>" x="-30" y="<%= { 1 => 5, 2 => -3, 3 => -10 }[lines.size] %>">
          <% lines.each_with_index do |line, i| %><tspan x="-30" dy="<%= i.zero? ? 0 : (lines.size > 2 ? 14 : 16) %>"><%= line %></tspan><% end %>
        </text>
      <% else %>
        <text class="floorplan__name" x="0" y="7" text-anchor="middle">?</text>
      <% end %>
      <% if room["key"] == current %>
        <g transform="translate(0 -26)"><%= render "campaigns/maps/party_marker" %></g>
      <% end %>
    </g>
  <% end %>
</svg>
