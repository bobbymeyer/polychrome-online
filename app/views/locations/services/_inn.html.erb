<%# An inn's panel (locations/_town): a room for the night, per character. %>
<p>A room for the night: full <%= word("hp") %> and <%= word("mp") %>, and the fallen back on their feet by morning.</p>
<%= render layout: "locations/services/customers", locals: { location: location, kind: "inn", action: "Rest", shopping: shopping } do |character| %>
  <%= "Rested" if @campaign.rested?(character) %>
<% end %>
<% tired = @campaign.characters.reject { |c| @campaign.rested?(c) }.presence || @campaign.characters.to_a %>
<% if shopping && tired.any? %>
  <% total = tired.sum { |c| @campaign.service_price("inn", c) } %>
  <% if total > @campaign.gil %>
    <p class="muted">Rooms for everyone cost <%= money(total) %>: more than the party has.</p>
  <% else %>
    <%= button_to "Rooms for everyone (#{total.zero? ? "on the house" : money(total)})", location_services_path(location), params: { kind: "inn", everyone: 1 }, class: "button" %>
  <% end %>
<% end %>
