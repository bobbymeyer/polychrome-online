<%# One row per character the viewer pays for, with what this service costs them (inn, temple, guild). %>
<% customers = @campaign.characters.order(:created_at).select { |c| can_manage?(c) } %>
<% if customers.empty? %>
  <p class="hint">Only the party's own players (and the GM) pay here.</p>
<% else %>
  <table class="book-table book-table--plain shop-table">
    <tbody>
      <% customers.each do |character| %>
        <% price = @campaign.service_price(kind, character) %>
        <% why_not = yield(character).to_s.strip.presence %>
        <tr>
          <td>
            <%= character.name %>
            <span class="muted"><%= word("hp") %> <%= character.current_hp %>/<%= character.stats["max_hp"] %> · <%= word("mp") %> <%= character.current_mp %>/<%= character.stats["max_mp"] %></span>
          </td>
          <td class="num"><%= price.zero? ? "On the house" : money(price) %></td>
          <td class="shop-table__buy">
            <% if why_not %>
              <span class="muted"><%= why_not %></span>
            <% elsif shopping && price > @campaign.gil %>
              <span class="muted">Can't afford</span>
            <% elsif shopping %>
              <%= button_to action, location_services_path(location), params: { kind: kind, character_id: character.id }, class: "button play" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
