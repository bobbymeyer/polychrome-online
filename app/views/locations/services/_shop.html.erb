<%# A shop's panel (locations/_town): its stock, and selling from the bag and off the party. %>
<div id="shop">
  <% items = location.stock_items %>
  <% if items.empty? %>
    <p class="empty">The shelves are bare.</p>
  <% else %>
    <table class="book-table book-table--plain shop-table">
      <tbody>
        <% items.each do |item| %>
          <tr>
            <td><%= link_to item.name, world_armory_item_path(@world, item) %></td>
            <td class="muted"><%= term(item.category) %></td>
            <td class="num"><%= money(item.price) %></td>
            <% if shopping %>
              <td class="shop-table__buy">
                <%= form_with url: buy_location_shop_path(location), class: "inline-form shop-form" do |f| %>
                  <%= hidden_field_tag :item, item.slug, id: nil %>
                  <%= number_field_tag :quantity, 1, min: 1, max: 99, id: "buy_#{item.slug}", "aria-label": "How many #{item.name}" %>
                  <%= f.submit "Buy", class: "button play", disabled: item.price > @campaign.gil %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if shopping && (bag = @campaign.bag).any? %>
    <h3>Sell</h3>
    <table class="book-table book-table--plain shop-table">
      <tbody>
        <% bag.each do |row| %>
          <tr>
            <td><%= row.item.name %> <span class="muted">×<%= row.quantity %></span></td>
            <td class="num"><%= money(row.item.resale_price) %></td>
            <td class="shop-table__buy">
              <%= form_with url: sell_location_shop_path(location), class: "inline-form shop-form" do |f| %>
                <%= hidden_field_tag :item, row.item.slug, id: nil %>
                <%= number_field_tag :quantity, 1, min: 1, max: row.quantity, id: "sell_#{row.item.slug}", "aria-label": "How many #{row.item.name} to sell" %>
                <%= f.submit "Sell", class: "button play" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% worn = shopping ? @campaign.characters.order(:created_at).select { |c| can_manage?(c) }.flat_map { |c| c.equipment_slots.includes(:item).map { |slot| [ c, slot ] } } : [] %>
  <% if worn.any? %>
    <h3>Sell what the party is wearing</h3>
    <table class="book-table book-table--plain shop-table">
      <tbody>
        <% worn.each do |character, slot| %>
          <tr>
            <td><%= slot.item.name %> <span class="muted"><%= character.name %>, <%= term(slot.slot).downcase %></span></td>
            <td class="num"><%= money(slot.item.resale_price) %></td>
            <td class="shop-table__buy">
              <%= button_to "Sell", sell_worn_location_shop_path(location), params: { character_id: character.id, slot: slot.slot },
                            class: "button play", form: { data: { turbo_confirm: "Take #{slot.item.name} off #{character.name} and sell it for #{money(slot.item.resale_price)}?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
  <% if shopping %><p class="hint">Shops pay half the price.</p><% end %>
</div>
<% if gm %>
  <details>
    <summary>GM: set the stock</summary>
    <%= form_with url: stock_location_path(location), method: :patch, scope: :stock, class: "book-form" do |f| %>
      <%= hidden_field_tag "stock[items][]", "", id: nil %>
      <div class="checks checks--columns">
        <% chosen = view["stock"] %>
        <% @world.items.order(:category, :name).each do |item| %>
          <label><%= check_box_tag "stock[items][]", item.slug, chosen.include?(item.slug), id: "stock_#{item.slug}" %> <%= item.name %></label>
        <% end %>
      </div>
      <div class="actions">
        <%= f.submit "Set stock", class: "button" %>
      </div>
    <% end %>
    <% if location.overrides.key?("stock") %>
      <%= button_to "Back to the rolled stock", stock_location_path(location), method: :patch, params: { reset: 1 }, class: "link-button" %>
    <% end %>
  </details>
<% end %>
