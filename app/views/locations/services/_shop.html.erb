<%# The shop (locations/_town, under the services): its stock, and selling from the chest, your bag and off the party. %>
<div id="shop" data-controller="help">
  <h3>Buy and sell</h3>
  <% items = location.stock_items %>
  <% stories = view.fetch("stock_stories", {}) %>
  <% party = @campaign.characters.includes(:job).order(:created_at).to_a %>
  <% if items.empty? %>
    <p class="empty">The shelves are bare.</p>
  <% else %>
    <table class="book-table book-table--plain shop-table">
      <tbody>
        <% items.each do |item| %>
          <tr>
            <td>
              <%= link_to item.name, world_armory_item_path(@world, item) %>
              <% if (story = stories[item.slug]) %>
                <span class="shop-table__story muted"><%= [ ("Made by #{story['maker']}" if story["maker"]), story["owner"] ].compact.join(". ") %>.</span>
              <% end %>
              <% if item.equipment? && party.any? %>
                <% fits = party.select { |c| c.job.equips?(item) } %>
                <span class="shop-table__fits <%= 'is-none' if fits.empty? %>"><%= fits.any? ? "#{fits.map(&:name).to_sentence} can use it" : "Nobody in the party can use it" %></span>
              <% end %>
            </td>
            <td class="muted"><%= term(item.category) %></td>
            <td class="num"><%= money(location.price_of(item)) %></td>
            <% if shopping %>
              <td class="shop-table__buy">
                <% if location.price_of(item) > @campaign.gil %>
                  <span class="muted">Can't afford</span>
                <% else %>
                  <%= form_with url: location_purchases_path(location), class: "inline-form shop-form" do |f| %>
                    <%= hidden_field_tag :item, item.slug, id: nil %>
                    <%= number_field_tag :quantity, 1, min: 1, max: 99, id: "buy_#{item.slug}", "aria-label": "How many #{item.name}" %>
                    <%= f.submit "Buy", class: "button play" %>
                  <% end %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <%# What's for sale from the party: the chest, and the bags of the characters you play (the GM's, all of them). %>
  <% sellers = shopping ? ([ @campaign ] + party.select { |c| can_manage?(c) }).flat_map { |h| h.bag.map { |row| [ h, row ] } } : [] %>
  <% if sellers.any? %>
    <h3>Sell</h3>
    <table class="book-table book-table--plain shop-table">
      <tbody>
        <% sellers.each do |holder, row| %>
          <tr>
            <td><%= row.item.name %> <span class="muted">×<%= row.quantity %>, <%= holder.bag_name %></span></td>
            <td class="num"><%= money(location.resale_price_of(row.item)) %></td>
            <td class="shop-table__buy">
              <%= form_with url: location_sales_path(location), class: "inline-form shop-form" do |f| %>
                <%= hidden_field_tag :item, row.item.slug, id: nil %>
                <%= hidden_field_tag :character_id, holder.id, id: nil if holder.is_a?(Character) %>
                <%= number_field_tag :quantity, 1, min: 1, max: row.quantity, id: "sell_#{holder.is_a?(Character) ? "#{holder.id}_" : ''}#{row.item.slug}", "aria-label": "How many #{row.item.name} to sell" %>
                <%= f.submit "Sell", class: "button play" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% worn = shopping ? @campaign.characters.order(:created_at).select { |c| can_manage?(c) }.flat_map { |c| c.equipment_slots.includes(:item).map { |slot| [ c, slot ] } } : [] %>
  <% if worn.any? %>
    <h3>Sell what the party is wearing</h3>
    <table class="book-table book-table--plain shop-table">
      <tbody>
        <% worn.each do |character, slot| %>
          <tr>
            <td><%= slot.item.name %> <span class="muted"><%= character.name %>, <%= term(slot.slot).downcase %></span></td>
            <td class="num"><%= money(location.resale_price_of(slot.item)) %></td>
            <td class="shop-table__buy">
              <%= button_to "Sell", location_sales_path(location), params: { character_id: character.id, slot: slot.slot },
                            class: "button play", form: { data: { turbo_confirm: "Take #{slot.item.name} off #{character.name} and sell it for #{money(location.resale_price_of(slot.item))}?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
  <%= help_line([ (location.prices.nonzero? && (location.prices.positive? ? "Everything is dear here: #{location.prices}% over the usual." : "Everything is cheap here: #{-location.prices}% under the usual.")),
                  ("Shops pay half the price." if shopping) ].select(&:present?).join(" ").presence) %>
</div>
<% if gm %>
  <details>
    <summary>GM: set the stock</summary>
    <%= form_with url: location_stock_path(location), method: :patch, scope: :stock, class: "book-form" do |f| %>
      <%= hidden_field_tag "stock[items][]", "", id: nil %>
      <div class="checks checks--columns">
        <% chosen = view["stock"] %>
        <% @world.items.order(:category, :name).each do |item| %>
          <label><%= check_box_tag "stock[items][]", item.slug, chosen.include?(item.slug), id: "stock_#{item.slug}" %> <%= item.name %></label>
        <% end %>
      </div>
      <div class="actions">
        <%= f.submit "Set stock", class: "button" %>
      </div>
    <% end %>
    <% if location.overrides.key?("stock") %>
      <%= button_to "Back to the rolled stock", location_stock_path(location), method: :delete, class: "link-button" %>
    <% end %>
  </details>
<% end %>
