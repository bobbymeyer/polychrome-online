<%# A pin toggle for a generated element (GM only). %>
<% if location.pinned?(key) %>
  <%= button_to "Pinned", location_pin_path(location, key), method: :delete, class: "pin is-pinned", title: "Unpin: a reroll will replace it", data: { help: "Unpin: a reroll will replace it." } %>
<% else %>
  <%= button_to "Pin", location_pins_path(location), params: { key: key }, class: "pin", title: local_assigns[:hint] || "Keep this through rerolls", data: { help: local_assigns[:hint] || "Keep this through rerolls." } %>
<% end %>
