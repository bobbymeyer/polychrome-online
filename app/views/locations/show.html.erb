<% content_for :title, @location.name %>
<% content_for :head, music_meta(@location.campaign, @location.dungeon? ? "dungeon" : "town") %>
<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>
<%= turbo_stream_from @location %>
<%= turbo_stream_from @location, :art if @gm %>
<%= render "shared/stage_stream", campaign: @campaign %>
<% view = @location.view %>

<div class="crumbs">
  <%= link_to @campaign.name, campaign_path(@campaign) %> /
  <%= link_to "Map", campaign_map_path(@campaign) %> / <%= view["name"] %>
</div>
<div class="book-header">
  <div>
    <p class="eyebrow"><%= @location.kind.humanize %><% if @gm %> · <%= link_to @location.location_template.name, world_gazetteer_location_template_path(@world, @location.location_template) %> · seed <%= @location.seed %><% end %></p>
    <h1><%= view["name"] %></h1>
  </div>
  <div class="actions">
    <%= link_to "Open the table", campaign_table_path(@campaign), class: "button button--quiet" %>
    <% if @gm %>
      <%= button_to "Reroll", location_reroll_path(@location), class: "button button--quiet",
                    form: { data: { turbo_confirm: "Reroll #{view['name']}? Pinned things stay; everything else changes#{', and exploration starts over' if @location.dungeon?}." } } %>
    <% end %>
  </div>
</div>

<% if (picture = @location.picture) %>
  <figure class="location-picture<%= " is-mode" if @location.current_mode %>">
    <%= image_tag url_for(picture), alt: [ view["name"], @location.current_mode&.name ].compact.join(": ") %>
  </figure>
<% end %>

<% if (in_mode = @location.current_mode) %>
  <section class="window location-mode" aria-label="What's happening here">
    <p class="location-mode__name"><%= in_mode["name"] %></p>
    <% if in_mode["description"] %><p><%= in_mode["description"] %></p><% end %>
    <% if in_mode["closed"].present? %>
      <p class="muted">Shut: <%= in_mode["closed"].map { |k| term(k) }.to_sentence %>.</p>
    <% end %>
  </section>
<% end %>

<% if @gm %>
  <%= render "locations/modes", location: @location, view: view %>
  <%= render "art_batches/mode_art", location: @location if @location.modes.any? %>
  <details class="window gm-tools">
    <summary>GM: rename</summary>
    <%= form_with model: @location, url: location_path(@location), class: "book-form inline-form" do |f| %>
      <div class="field"><%= f.label :name %><%= f.text_field :name, value: view["name"] %></div>
      <%= f.submit "Rename", class: "button" %>
    <% end %>
    <p class="hint">Rolled from <strong><%= @location.generated["name"] %></strong>. Leave blank to go back to that.</p>
  </details>
<% end %>

<%= render(@location.town? ? "locations/town" : "locations/dungeon", location: @location, view: view, gm: @gm) %>

<% if (past = Past.new(view["past"], lore: @location.campaign.world.lore)).lines.any? %>
  <section class="window past" aria-label="Its past">
    <h2>Its past</h2>
    <% past.lines.each do |line| %><p><%= line %></p><% end %>
    <% if @gm %>
      <p class="hint">
        <% if (place = @location.map_node&.world_place) && Past.new(place.past).present? %>
          From <%= place.name %> in the <%= link_to "atlas", edit_world_world_place_path(@world, place) %>, where you can change it.
        <% else %>
          Rolled with the place, from its seed. Written from the world's <%= link_to "history", world_history_path(@world) %> when it's in the atlas.
        <% end %>
      </p>
    <% end %>
  </section>
<% end %>
