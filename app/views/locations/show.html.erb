<% content_for :title, @location.name %>
<% content_for :head, music_meta(@location.campaign, @location.dungeon? ? "dungeon" : "town") %>
<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>
<%= turbo_stream_from @location %>
<%= render "shared/stage_stream", campaign: @campaign %>
<% view = @location.view %>

<div class="crumbs">
  <%= link_to @campaign.name, campaign_path(@campaign) %> /
  <%= link_to "Table", campaign_table_path(@campaign) %> / <%= view["name"] %>
</div>
<div class="book-header">
  <div>
    <p class="eyebrow"><%= @location.kind.humanize %><% if @gm %> · <%= link_to @location.location_template.name, world_gazetteer_location_template_path(@world, @location.location_template) %> · seed <%= @location.seed %><% end %></p>
    <h1><%= view["name"] %></h1>
  </div>
  <div class="actions">
    <%# One button up here: the GM's moves on the place gather at the bottom, under one tag. %>
    <%= link_to "Open the table", campaign_table_path(@campaign), class: "button button--quiet" %>
  </div>
</div>

<% modes_on = @location.modes_on %>
<% if (picture = @location.picture) %>
  <figure class="location-picture<%= " is-mode" if modes_on.any? %>">
    <%= image_tag url_for(picture), alt: [ view["name"], *modes_on.map(&:name) ].join(": ") %>
  </figure>
<% end %>

<% modes_on.each do |in_mode| %>
  <section class="window location-mode" aria-label="What's happening here">
    <p class="location-mode__name"><%= in_mode["name"] %></p>
    <% if in_mode["description"] %><p><%= in_mode["description"] %></p><% end %>
    <% if in_mode["closed"].present? %>
      <p class="muted">Shut: <%= in_mode["closed"].map { |k| term(k) }.to_sentence %>.</p>
    <% end %>
  </section>
<% end %>

<%= render(@location.town? ? "locations/town" : "locations/dungeon", location: @location, view: view, gm: @gm) %>

<% if (past = Past.new(view["past"], lore: @location.campaign.world.lore)).lines.any? %>
  <section class="window past" aria-label="Its past">
    <h2>Its past</h2>
    <% past.lines.each do |line| %><p><%= line %></p><% end %>
    <% if @gm %>
      <p class="hint">
        <% if (place = @location.map_node&.world_place) && Past.new(place.past).present? %>
          From <%= place.name %> in the <%= link_to "atlas", edit_world_world_place_path(@world, place) %>, where you can change it.
        <% else %>
          Rolled with the place, from its seed. Written from the world's <%= link_to "history", world_history_path(@world) %> when it's in the atlas.
        <% end %>
      </p>
    <% end %>
  </section>
<% end %>

<%# The GM's controls for the place come after it, under one tag: the place is what the page is for. %>
<% if @gm %>
  <section class="location-gm" aria-label="GM controls" data-controller="help">
    <p class="gm-only">GM · only you see these</p>
    <div class="actions actions--tight">
      <%= button_to "Reroll", location_reroll_path(@location), class: "button button--quiet",
                    data: { help: "Pinned things stay; everything else changes#{', and exploration starts over' if @location.dungeon?}." },
                    form: { data: { turbo_confirm: "Reroll #{view['name']}? Pinned things stay; everything else changes#{', and exploration starts over' if @location.dungeon?}." } } %>
      <% if @location.overrides.key?("tables") %>
        <%= button_to "Take the world's tables again", location_memory_path(@location), method: :delete, class: "button button--quiet",
                      data: { help: "Rolled from the tables as they were when the party came. The seed stays; names and rooms follow the world's tables now." },
                      form: { data: { turbo_confirm: "Roll #{view['name']} from the world's tables as they are now? Its people may change their names." } } %>
      <% end %>
    </div>
    <%= help_line %>
    <%= render "map_nodes/modes", node: @location.map_node if @location.map_node %>
    <%# The elaboration scale (Generators::Elaboration), beside Reroll because
        it is the same kind of control: a setting for the whole place, not a
        room-by-room edit. Not a reroll, though -- the core rooms keep their
        names, their decisions and their order at every level, which is what
        makes it safe to turn once the story is pinned on. %>
    <% if @location.dungeon? %>
      <details class="window gm-tools" <%= "open" if @location.elaboration.positive? %>>
        <summary>Elaboration<%= " · #{@location.elaboration} of #{Generators::Elaboration::MAX_LEVEL}" if @location.elaboration.positive? %></summary>
        <%= form_with url: location_elaboration_path(@location), method: :patch, class: "book-form inline-form",
                      data: { controller: "autosubmit" } do %>
          <div class="field">
            <%= label_tag :level, "Extra rooms around the ones you pinned" %>
            <%= select_tag :level, options_for_select((0..Generators::Elaboration::MAX_LEVEL).map { |n| [ n.zero? ? "As rolled" : "#{n} · up to #{n * Generators::Elaboration::PER_LEVEL} more rooms", n ] }, @location.elaboration),
                           data: { action: "autosubmit#submit" } %>
          </div>
        <% end %>
        <p class="hint">
          Alcoves, side passages and loops, drawn in outline on the plan. It never moves the rooms you pinned or changes the order the party walks them.
          <% if @location.elaboration.positive? %>
            <%= view["rooms"].count { |r| r["elaborated"] } %> of these <%= view["rooms"].size %> rooms are its doing; "As rolled" takes them all back.
          <% end %>
        </p>
      </details>
    <% end %>
    <details class="window gm-tools">
      <summary>Rename</summary>
      <%= form_with model: @location, url: location_path(@location), class: "book-form inline-form" do |f| %>
        <div class="field"><%= f.label :name %><%= f.text_field :name, value: view["name"] %></div>
        <%= f.submit "Rename", class: "button" %>
      <% end %>
      <p class="hint">Rolled from <strong><%= @location.generated["name"] %></strong>. Leave blank to go back to that.</p>
    </details>
  </section>
<% end %>

<%# Pictures come last: the place itself is what the GM needs first. %>
<%= render "locations/mode_pictures", location: @location if @gm && @location.map_node&.modes&.any? %>
