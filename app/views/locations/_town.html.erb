<div data-controller="panels">
<section class="window skyline-window">
  <%= render "locations/skyline", view: view %>
</section>

<div class="two-up">
  <section class="window" data-controller="help">
    <h2>Services</h2>
    <% if view["services"].empty? %>
      <p class="empty">Nothing here for travellers.</p>
    <% else %>
      <% shopping = may_shop?(location) %>
      <% keepers = location.roster.filter_map { |slot| (g = slot["generated"]) && g["service"] && [ g["service"], g["name"] ] }.to_h %>
      <% here = @campaign.current_node&.location_id == location.id %>
      <% pastimes = here ? @campaign.current_node.pastimes.index_by(&:service) : {} %>
      <% if location.reputation.nonzero? %>
        <p class="standing standing--<%= location.reputation.positive? ? 'good' : 'bad' %>">
          <%= location.name %> sees the party as <strong><%= location.standing.downcase %></strong><%= location.shuns_party? ? ": nobody here will trade with them." : "." %>
        </p>
      <% end %>
      <% if shopping %>
        <p class="shop-purse">The party has <strong><%= money(@campaign.gil) %></strong>.</p>
      <% end %>
      <%# One service a row (docs/DESIGN.md, "Choices are tables"): what it's for under its name, what it offers and costs in
          the cost column. The inn, the temple and the guild are done at the table (Things to do here); only the shop opens,
          below. The GM pins one through rerolls in the last column. %>
      <% shop = nil %>
      <table class="pick-table services">
        <tbody>
        <% view["services"].each do |service| %>
          <% kind = service["kind"] %>
          <% shut = location.shut_by(kind) %>
          <% pastime = pastimes[kind] %>
          <% outcome = { "inn" => Outcome.of("rest", 100), "temple" => Outcome.of("raise"), "guild" => Outcome.of("rumour") }[kind] %>
          <% offer = shut ? "Shut" : { "inn" => "Rest the night", "temple" => "Raise the fallen", "guild" => "Hear what's being said", "shop" => "Buy and sell" }.fetch(kind, "The GM plays what happens") %>
          <% price = !shut && pastime&.price %>
          <% shop = service if kind == "shop" && !shut %>
          <tr class="pick-row service service--<%= kind %>" id="service-<%= kind %>"
              <%= tag.attributes(data: { help: (shut ? "Shut while #{shut.name.downcase} lasts." : kind == "shop" ? "Buy from its shelves and sell from the bag, below." : outcome ? "Done at the table, under Things to do here, when the GM calls it." : "The GM plays what happens here.") }) %>>
            <td class="pick-row__what">
              <% if kind == "shop" && !shut %>
                <a href="#shop" class="pick-row__act"><%= service["name"] %></a>
              <% elsif outcome && !shut %>
                <%= link_to service["name"], campaign_table_path(@campaign), class: "pick-row__act", data: { turbo_frame: "_top" } %>
              <% else %>
                <span class="pick-row__act"><%= service["name"] %></span>
              <% end %>
              <span class="pick-row__note"><%= [ term(kind), keepers[kind], (shut ? "shut: #{shut.name.downcase}" : nil), (outcome.describe(@world) if outcome && !shut),
                                                   ("the GM plays what happens here" if !outcome && kind != "shop" && !shut) ].compact.join(" · ") %></span>
            </td>
            <td class="pick-row__cost service__offer"><%= offer %><%= " · #{price.zero? ? 'free' : money(price)}" if price %><%= " · more than the party has" if price && price > @campaign.gil %></td>
            <% if gm %><td class="pick-row__who service__pin"><%= render "locations/pin", location: location, key: service["key"] %></td><% end %>
          </tr>
        <% end %>
        </tbody>
      </table>
      <%= help_line(here ? nil : "The party has to be here to use them.") %>
      <% if shop %>
        <%= render "locations/services/shop", location: location, service: shop, view: view, gm: gm, shopping: shopping %>
      <% end %>
    <% end %>
  </section>

  <section class="window" data-controller="help">
    <h2>People</h2>
    <ul class="location-list location-list--people">
      <% location.roster.each do |slot| %>
        <% npc = slot["npc"] %>
        <% generated = slot["generated"] %>
        <li>
          <%= speaker_portrait(npc, "neutral", size: :medium) if npc %>
          <% unless npc %><span class="speaker-portrait speaker-portrait--medium speaker-portrait--plate speaker-portrait--generated" style="<%= plate_style(generated["name"]) %>"><%= generated["name"].first %></span><% end %>
          <div>
            <strong><%= npc&.name || generated["name"] %></strong>
            <span class="muted"><%= npc&.title || generated["title"] %></span>
            <% hook = npc ? npc.description : location.fill_in(generated["hook"]) %>
            <% if hook.present? && gm %><p class="hook"><%= hook %></p><% end %>
            <% if generated && (generated["memory"] || generated["wish"]) %>
              <p class="couplet">
                <% if generated["memory"] %><span><%= location.fill_in(generated["memory"]) %></span><% end %>
                <% if generated["wish"] %><span class="<%= 'couplet--met' if location.met?(generated['key']) %>"><%= location.fill_in(generated["wish"]) %></span><% end %>
              </p>
            <% end %>
          </div>
          <% if gm %>
            <div class="location-list__tools">
              <% if generated %>
                <%= render "locations/pin", location: location, key: generated["key"], hint: "Make them a real NPC you can speak as at the table" %>
              <% end %>
              <% if npc %><%= link_to "Edit", edit_npc_path(npc), class: "link-button" %><% end %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if gm %>
      <%= help_line %>
      <details>
        <summary>GM: write someone in</summary>
        <%= form_with url: location_npcs_path(location), scope: :npc, class: "book-form" do |f| %>
          <div class="field-row">
            <div class="field"><%= f.label :name %><%= f.text_field :name, required: true %></div>
            <div class="field"><%= f.label :title %><%= f.text_field :title %></div>
          </div>
          <div class="field"><%= f.label :description, "Hook" %><%= f.text_field :description %></div>
          <%= f.submit "Add", class: "button" %>
        <% end %>
      </details>
    <% end %>
  </section>
</div>
</div>
