<%# What the floorplan's shapes mean. %>
<dl class="map-legend">
  <% [ %w[encounter Encounter], %w[boss Boss], %w[treasure Treasure], %w[event Event], %w[fork Fork], %w[key Key] ].each do |kind, label| %>
    <dt><svg viewBox="-16 -16 32 32" aria-hidden="true"><%= render "locations/marker", kind: kind %></svg></dt><dd><%= label %></dd>
  <% end %>
  <dt class="map-legend__path map-legend__path--dangerous"></dt><dd>A costly way</dd>
  <dt><svg viewBox="-16 -16 32 32" aria-hidden="true"><g class="floorplan__lock"><path class="floorplan__lock-shackle" d="M-5,-2 V-7 A5,5 0 0 1 5,-7 V-2" /><rect class="floorplan__lock-body" x="-8" y="-2" width="16" height="12" /></g></svg></dt><dd>A lock (hollow once opened)</dd>
  <dt><svg viewBox="-16 -16 32 32" aria-hidden="true"><%= render "campaigns/maps/party_marker" %></svg></dt><dd>The party (their room is filled blue)</dd>
</dl>
