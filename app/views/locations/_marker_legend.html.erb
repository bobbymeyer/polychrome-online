<%# What the floorplan's shapes mean. %>
<dl class="map-legend">
  <% [ %w[encounter Encounter], %w[boss Boss], %w[treasure Treasure], %w[event Event], %w[fork Fork] ].each do |kind, label| %>
    <dt><svg viewBox="-16 -16 32 32" aria-hidden="true"><%= render "locations/marker", kind: kind %></svg></dt><dd><%= label %></dd>
  <% end %>
  <dt class="map-legend__path map-legend__path--dangerous"></dt><dd>A costly way</dd>
  <dt><svg viewBox="-16 -16 32 32" aria-hidden="true"><%= render "maps/party_marker" %></svg></dt><dd>The party (their room is filled blue)</dd>
</dl>
