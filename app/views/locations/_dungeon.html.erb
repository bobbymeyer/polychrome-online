<% current = location.progress["current"] %>
<% here = location.current_room %>
<% glyph_names = { "encounter" => "Encounter", "boss" => "Boss", "treasure" => "Treasure", "event" => "Event", "fork" => "Fork", "key" => "Key" } %>
<% describe = lambda do |room|
     d = room["decision"]
     case d["kind"]
     when "encounter", "boss" then "#{glyph_names[d['kind']]}: #{@campaign.describe_encounter(d['monsters'])}"
     when "treasure"
       "Treasure: #{location.describe_treasure(d)}#{' (taken)' if location.resolved?(room['key'])}"
     when "key"
       lock = view["paths"].find { |p| p.dig("lock", "id") == d["lock"] }&.dig("lock")
       "Key: #{d['name']}#{" (opens #{lock['name']})" if lock}#{' (found)' if location.resolved?(room['key'])}"
     else "#{glyph_names[d['kind']]}: #{d['text']}"
     end
   end %>

<div class="map-layout">
  <section class="window map-window">
    <% if gm %>
      <%= render "locations/floorplan", view: view, current: current, resolved: location.progress.fetch("resolved", []), unlocked: location.progress.fetch("unlocked", []) %>
    <% else %>
      <% seen = view["rooms"].map { |r| r["key"] }.select { |k| location.seen_by_players?(k) } %>
      <%= render "locations/floorplan", view: view, current: current, shown: location.visited, known: seen - location.visited, unlocked: location.progress.fetch("unlocked", []) %>
      <% if location.visited.empty? %><p class="hint">Nobody has gone in yet.</p><% end %>
    <% end %>
  </section>

  <aside class="window map-panel">
    <% if here %>
      <h2><%= here["name"] %></h2>
      <p><%= describe.(here) if gm || location.resolved?(here["key"]) || here["decision"]["kind"] == "treasure" %></p>
    <% else %>
      <h2><%= location.visited.any? ? "Outside" : "The way in" %></h2>
    <% end %>
    <% if (keys = location.keys_in_hand).any? %>
      <p class="keys-in-hand"><span class="label">Keys</span> <%= keys.map { |lock| lock["key_name"] }.to_sentence %></p>
    <% end %>

    <% if gm %>
      <% if (encounter = @campaign.pending_encounter) %>
        <%= render "encounters/call", encounter: encounter, return_to: location_path(location) %>
      <% end %>

      <% if !location.party_here? %>
        <% at = @campaign.current_node %>
        <p class="hint">The party is <%= at ? "at #{at.name}" : "not on the map" %>. Take them to <%= location.name %> on the <%= link_to "map", campaign_map_path(@campaign) %> to go in.</p>
      <% elsif here.nil? %>
        <%= button_to "Lead the party in", enter_location_path(location), class: "button play" %>
      <% else %>
        <% if here["decision"]["kind"] == "treasure" && !location.resolved?(here["key"]) %>
          <%= button_to "Hand over the treasure", take_treasure_location_path(location), params: { room: here["key"] }, class: "button play" %>
        <% end %>
        <h3>Ways on</h3>
        <div class="menu play">
          <% location.neighbours(here["key"]).each do |key| %>
            <% room = location.room(key) %>
            <% path = location.path_between(here["key"], key) %>
            <% cost = path&.dig("cost") %>
            <% if location.locked?(path) && !location.has_key?(path["lock"]) %>
              <button type="button" class="menu__item" aria-disabled="true" title="It needs <%= path['lock']['key_name'] %>">
                <%= room["name"] %> <span class="menu__cost">locked: <%= path["lock"]["name"] %></span>
              </button>
            <% else %>
              <%= button_to move_location_path(location), params: { room: key }, class: "menu__item", title: cost do %>
                <%= room["name"] %>
                <% if location.locked?(path) %><span class="menu__cost">open with <%= path["lock"]["key_name"] %></span>
                <% elsif cost %><span class="menu__cost">costly</span>
                <% elsif location.visited.include?(key) %><span class="menu__cost">visited</span><% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
        <p class="hint">Moving reveals the room to the players and plays its decision at the table.</p>
      <% end %>

      <details>
        <summary>GM: every room</summary>
        <ul class="location-list location-list--rooms">
          <% view["rooms"].each do |room| %>
            <li class="<%= 'is-resolved' if location.resolved?(room['key']) %>">
              <span><strong><%= room["name"] %></strong><%= " (added)" if room["added"] %><br><span class="muted"><%= describe.(room) %></span></span>
              <% unless room["added"] %><%= render "locations/pin", location: location, key: room["key"] %><% end %>
            </li>
          <% end %>
        </ul>
      </details>

      <details>
        <summary>GM: place the boss</summary>
        <%= form_with url: boss_location_path(location), method: :patch, scope: :boss, class: "book-form" do |f| %>
          <% boss = location.overrides["boss"]&.first %>
          <div class="field-row">
            <div class="field"><%= f.label :monster %><%= f.select :monster, @world.monsters.order(:level, :name).map { |m| [ m.name, m.slug ] }, include_blank: "As rolled", selected: boss&.first %></div>
            <div class="field"><%= f.label :count %><%= f.number_field :count, value: boss&.last || 1, min: 1, max: 8 %></div>
          </div>
          <%= f.submit "Place boss", class: "button" %>
        <% end %>
      </details>

      <details>
        <summary>GM: add a room</summary>
        <%= form_with url: add_room_location_path(location), scope: :room, class: "book-form" do |f| %>
          <div class="field-row">
            <div class="field"><%= f.label :name %><%= f.text_field :name, placeholder: "Hidden Room" %></div>
            <div class="field"><%= f.label :connect, "Off" %><%= f.select :connect, view["rooms"].map { |r| [ r["name"], r["key"] ] } %></div>
          </div>
          <div class="field-row">
            <div class="field"><%= f.label :kind, "Decision" %><%= f.select :kind, [ [ "Event", "event" ], [ "Encounter", "encounter" ], [ "Treasure", "treasure" ] ] %></div>
            <div class="field"><%= f.label :monster %><%= f.select :monster, @world.monsters.order(:level, :name).map { |m| [ m.name, m.slug ] }, include_blank: true %></div>
            <div class="field"><%= f.label :count %><%= f.number_field :count, value: 1, min: 1, max: 8 %></div>
            <div class="field"><%= f.label :item %><%= f.select :item, @world.items.order(:name).map { |i| [ i.name, i.slug ] }, include_blank: true %></div>
            <div class="field"><%= f.label :gil, "Or #{word('currency')}" %><%= f.number_field :gil, min: 1 %></div>
          </div>
          <div class="field"><%= f.label :text, "Event text" %><%= f.text_field :text %></div>
          <%= f.submit "Add room", class: "button" %>
        <% end %>
      </details>
    <% end %>
    <%= render "locations/marker_legend" %>
  </aside>
</div>
