<%# The GM's modes for a place on the map (MapNode::Modes): prepared, set off, put back. On a town or
    dungeon's page, and in the map's panel for anywhere else. services: what a mode can shut there. %>
<% modes = node.modes %>
<% on = node.modes_on %>
<% almanac = node.campaign.world.almanac %>
<% top = { turbo_frame: "_top" } %>
<details class="window gm-tools" <%= "open" if node.current_mode %>>
  <summary>GM: modes<%= " · #{on.map(&:name).join(' · ')} now" if on.any? %></summary>
  <p class="hint">
    Another state for this place, prepared ahead: set off at the table (the city burns, the mine floods, the festival starts), or on by
    itself when the calendar says (by night, in winter, on market day). A place can be in several at once.
    While one lasts, services and things to do can be shut, it can have things to do of its own, the music changes, and arriving can mean trouble.
    The rest of the world stays as it is.
  </p>
  <% if modes.any? %>
    <ul class="modes">
      <% modes.each do |t| %>
        <li class="<%= 'is-current' if on.include?(t) %>">
          <strong><%= t["name"] %></strong><%= " (on now)" if t.timed? && on.include?(t) %>
          <span class="muted">
            <%= [ ("by itself: #{t.times.join(', ')}" if t.timed?),
                  ("things to do: #{Pastime.list(t.activities, almanac).map(&:name).to_sentence}" if t.activities),
                  ("shuts #{t['closed'].map { |k| term(k) }.to_sentence.downcase}" if t["closed"].present?), ("#{t['music']} music" if t["music"]),
                  ("trouble from #{t.encounter_table.name}" if t.encounter_table) ].compact.join(" · ") %>
          </span>
          <% if t.timed? %>
            <%# It follows the calendar: nothing to set off. %>
          <% elsif node.mode == t["key"] %>
            <%= form_with url: map_node_current_mode_path(node), method: :delete, class: "inline-form", data: top do |f| %>
              <%= f.text_field :line, placeholder: "The fires are out. (optional)", "aria-label": "What the table hears" %>
              <%= f.submit "Put it back", class: "button" %>
            <% end %>
          <% else %>
            <%= button_to "Set it off", map_node_current_mode_path(node), method: :patch, params: { key: t["key"] }, class: "button play",
                          form: { class: "inline", data: { turbo_frame: "_top", turbo_confirm: "#{node.name}: #{t['name']}? The table hears: “#{t['line'] || "#{node.name}: #{t['name']}."}”" } } %>
          <% end %>
          <%= button_to "Remove", map_node_mode_path(node, t["key"]), method: :delete, class: "link-button", form: { class: "inline", data: top } %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with url: map_node_modes_path(node), scope: :mode, class: "book-form", data: top do |f| %>
    <div class="field-row">
      <div class="field"><%= f.label :name %><%= f.text_field :name, placeholder: "Burning", required: true %></div>
      <div class="field">
        <%= f.label :music %>
        <%= f.select :music, Campaign::MUSIC_CHOICES.map { |c| [ c.capitalize, c ] }, include_blank: "As it was" %>
      </div>
      <div class="field">
        <%= f.label :encounters, "Trouble on arrival" %>
        <%= f.select :encounters, node.campaign.world.encounter_tables.order(:name).map { |t| [ t.name, t.slug ] }, include_blank: "None" %>
      </div>
    </div>
    <div class="field"><%= f.label :line, "What the table hears" %><%= f.text_field :line, placeholder: "Smoke over the rooftops: the city is burning." %></div>
    <div class="field"><%= f.label :description, "What players read here meanwhile" %><%= f.text_field :description, placeholder: "Half the market is ash. The guard is everywhere." %></div>
    <div class="field"><%= f.label :art, "How it looks (for its picture)" %><%= f.text_field :art, placeholder: "on fire, thick smoke, ash falling" %></div>
    <div class="field">
      <%= f.label :activities, "Things to do meanwhile" %>
      <%= f.text_area :activities, rows: 2, class: "script-field", placeholder: "Wade the platforms (2): Knee-deep, and the lights still on." %>
    </div>
    <% services = node.location&.town? ? node.location.view.fetch("services", []).map { |s| s["kind"] }.uniq : [] %>
    <fieldset class="field">
      <legend>Shut meanwhile</legend>
      <%= hidden_field_tag "mode[closed][]", "", id: nil %>
      <div class="checks">
        <% services.each do |kind| %>
          <label><%= check_box_tag "mode[closed][]", kind, false, id: "mode_closed_#{kind}" %> <%= term(kind) %></label>
        <% end %>
        <label><%= check_box_tag "mode[closed][]", "pastimes", false, id: "mode_closed_pastimes" %> The usual things to do</label>
      </div>
    </fieldset>
    <fieldset class="field">
      <legend>Comes on by itself</legend>
      <%= hidden_field_tag "mode[times][]", "", id: nil %>
      <% almanac.words.each do |kind, names| %>
        <% next if names.empty? %>
        <div class="checks" role="group" aria-label="<%= Pointcrawl::Calendar::KINDS[kind] %>">
          <% names.each do |name| %>
            <label><%= check_box_tag "mode[times][]", name, false, id: "mode_times_#{name.parameterize(separator: '_')}" %> <%= name %></label>
          <% end %>
        </div>
      <% end %>
      <p class="hint">For a place that's different by night, in winter or on market day: it's in this mode then, and not otherwise, on top of any you set off. Ticked in one row, any of them (dusk or night); in different rows, all at once (winter nights). Leave them all off for a mode you set off yourself.</p>
    </fieldset>
    <%= f.submit "Prepare the mode", class: "button" %>
  <% end %>
  <%= render "drafts/panel", owner: node.campaign, kind: "mode", target: node, title: "Suggest modes", placeholder: "plague, or a festival" %>
</details>
