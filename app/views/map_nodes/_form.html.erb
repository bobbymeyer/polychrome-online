<%= form_with model: node, url: node.persisted? ? map_node_path(node) : campaign_map_nodes_path(@campaign), class: "book-form" do |f| %>
  <%= render "book_entries/errors", entry: node %>
  <%= f.hidden_field :x %>
  <%= f.hidden_field :y %>
  <div class="field"><%= f.label :name %><%= f.text_field :name, required: true, autofocus: node.new_record? %></div>
  <div class="field-row">
    <div class="field"><%= f.label :kind %><%= f.select :kind, MapNode::KINDS.map { |k| [ k.humanize, k ] } %></div>
    <div class="field field--check">
      <%= f.check_box :visible %>
      <%= f.label :visible, "Revealed to players" %>
    </div>
  </div>
  <div class="field"><%= f.label :description, "What players read here" %><%= f.text_area :description, rows: 2 %></div>
  <div class="field"><%= f.label :notes, "GM notes" %><%= f.text_area :notes, rows: 2 %></div>
  <div class="field">
    <%= f.label :activities, "Things to do here" %>
    <%= f.text_area :activities, rows: 3, class: "script-field", placeholder: "Work a shift (day, 2): Aprons, and the till that sticks." %>
    <% if node.world_place&.activities.present? %><p class="hint">The setting's, too: <%= Pastime.list(node.world_place.activities).map(&:name).to_sentence %>. One of yours with the same name takes its place.</p><% end %>
    <p class="hint">Things to do here, one per line: a name, then in brackets when (dawn, day, dusk, night; any if none) and how many parts of the day it takes (1 if none), then what the table hears. The party picks one from Where next?, and the time goes by.</p>
  </div>
  <%= f.submit node.persisted? ? "Save" : "Add to map", class: "button" %>
<% end %>
