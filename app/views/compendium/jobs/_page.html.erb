<header class="book-page__header">
  <%= entry_portrait(entry) %>
  <div>
    <p class="eyebrow">Archetype Compendium</p>
    <h1><%= entry.name %></h1>
    <dl class="facts">
      <% if types_matter? %><dt>Type</dt><dd><%= type_tag(entry.base_type) %></dd><% end %>
      <dt>ABP to master</dt><dd><%= Stats::Growth.abp_for_job_level(Stats::Growth::MAX_JOB_LEVEL) %></dd>
      <dt>Ability slots</dt><dd><%= entry.ability_slots %></dd>
      <% if entry.skills.any? %>
        <dt><%= gloss(:skill, "Good at") %></dt><dd><%= entry.skill_names.to_sentence %> <span class="muted">(+<%= Job::SKILL_BONUS %>)</span></dd>
      <% end %>
      <% if (own = entry.signature_ability) %>
        <dt><%= gloss(:signature, "Signature") %></dt><dd><%= link_to own.name, world_grimoire_ability_path(entry.world, own) %></dd>
      <% end %>
      <% if (field = entry.field_ability_entry) %>
        <dt><%= gloss(:field_ability, "Field") %></dt><dd><%= link_to field.name, world_grimoire_ability_path(entry.world, field) %></dd>
      <% end %>
      <% if entry.passive %>
        <dt><%= gloss(:passive, "Passive") %></dt><dd><%= passive_term(entry.passive) %></dd>
      <% end %>
      <% if entry.payoff.present? %>
        <dt><%= gloss(:payoff, "Payoff") %></dt><dd><%= payoff_summary(entry) %></dd>
      <% end %>
      <% if (move = entry.desperation_ability) %>
        <dt>Desperation</dt><dd><%= link_to move.name, world_grimoire_ability_path(entry.world, move) %></dd>
      <% end %>
    </dl>
  </div>
</header>

<% if entry.description.present? %>
  <div class="prose"><%= simple_format(entry.description) %></div>
<% end %>

<% if types_matter? %>
<section class="window">
  <h2>Type</h2>
  <% profile = type_profile([ entry.base_type ], {}, character: true) %>
  <dl class="facts facts--wide type-facts">
    <dt>Type</dt><dd><%= type_tag(entry.base_type) %> <%= link_to "the chart", world_types_path(@world), class: "muted" %></dd>
    <% { "weak" => "Weak to", "resist" => "Resists" }.each do |band, label| %>
      <% if profile[band].any? %><dt><%= label %></dt><dd><%= safe_join(profile[band].map { |t| type_tag(t) }, " ") %></dd><% end %>
    <% end %>
  </dl>
  <p class="hint">
    <% if entry.base_type == type_chart.plain %>
      Attack and the signature command are plain blows.
    <% elsif !entry.typed_attack? %>
      Attack and the signature command are plain blows. Being <%= type_name(entry.base_type).downcase %> only changes what hurts them.
    <% else %>
      Attack and the signature command strike as <%= type_name(entry.base_type).downcase %>.
    <% end %>
    A character is never immune through an archetype's type: what the chart calls no effect, they resist.
  </p>
</section>
<% end %>

<section class="window">
  <h2>Stat modifiers</h2>
  <dl class="stat-block">
    <% Stats::NAMES.each do |stat| %>
      <% pct = entry.stat_multipliers.fetch(stat, 100) %>
      <div class="<%= 'is-up' if pct > 100 %> <%= 'is-down' if pct < 100 %>">
        <dt><%= stat_term(stat) %></dt><dd>×<%= format("%.2f", pct / 100.0) %></dd>
      </div>
    <% end %>
  </dl>
  <% if entry.innates.any? %>
    <h3>Innate</h3>
    <ul class="refs">
      <% entry.innates.each do |passive| %>
        <li>
          <%= stat_label(passive["stat"]) %>
          <%= [(signed(passive["add"]) if passive["add"]), ("#{signed(passive['percent'])}%" if passive["percent"])].compact.join(", ") %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section class="window">
  <h2>Learn table</h2>
  <% if entry.job_levels.empty? %>
    <p class="empty"><%= entry.name %> teaches nothing. It has no limits either.</p>
  <% else %>
    <table class="book-table book-table--plain">
      <thead><tr><th class="num">Archetype level</th><th class="num">ABP</th><th class="num">Mastered at</th><th>Ability</th><th>Kind</th></tr></thead>
      <tbody>
        <% entry.job_levels.includes(:ability).each do |level| %>
          <tr>
            <td class="num"><%= level.level %></td>
            <td class="num"><%= Stats::Growth.abp_for_job_level(level.level) %></td>
            <td class="num"><%= level.mastered_at %></td>
            <td><%= link_to level.ability.name, world_grimoire_ability_path(@world, level.ability) %></td>
            <td><%= term(level.ability.kind) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>

<section class="window">
  <h2>Equipment</h2>
  <% if entry.equip_categories.empty? %>
    <p class="empty">Can't equip anything.</p>
  <% else %>
    <ul class="refs refs--inline">
      <% entry.equip_categories.each do |category| %>
        <li><%= term(category) %></li>
      <% end %>
    </ul>
    <% gear = @world.items.where(category: entry.equip_categories).order(:category, :name) %>
    <% if gear.any? %>
      <h3>In the Armory</h3>
      <ul class="refs refs--inline">
        <% gear.each do |item| %>
          <li><%= link_to item.name, world_armory_item_path(@world, item) %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</section>
