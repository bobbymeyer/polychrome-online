<% content_for :title, "#{@monster.name} · Trial" %>
<nav class="crumbs"><%= link_to "Bestiary", world_bestiary_monsters_path(@world) %> / <%= link_to @monster.name, world_bestiary_monster_path(@world, @monster) %> / Trial</nav>
<div class="book-header">
  <div>
    <p class="eyebrow">Bestiary · Trial</p>
    <h1><%= @trial.count %> × <%= @monster.name %></h1>
  </div>
</div>
<p>
  Against a level-<%= @trial.level %> party of <%= @trial.party.map { |u| u[:name] }.to_sentence %> in starting gear, everyone on their default command
  (Attack, so this is a floor: a table that uses its arts does better).
  <strong><%= { "victory" => "The party won", "defeat" => "The party fell", "input" => "Still going" }.fetch(@trial.outcome, @trial.outcome) %></strong>
  <%= @trial.outcome == "input" ? "after" : "in" %> <%= pluralize(@trial.rounds, "round") %>.
</p>
<table class="book-table book-table--plain">
  <thead><tr><th>Who</th><th class="num"><%= word("hp") %></th><th class="num"><%= word("mp") %></th></tr></thead>
  <tbody>
    <% (@trial.standing + @trial.enemies).each do |u| %>
      <tr class="<%= 'is-ko' if u.ko? %>"><td><%= u.name %><%= tag.span(" (called)", class: "muted") if u.summoned? %></td><td class="num"><%= u.hp %>/<%= u.max_hp %></td><td class="num"><%= u.mp %>/<%= u.max_mp %></td></tr>
    <% end %>
  </tbody>
</table>
<%# The moments: what it did, who fell and when, what it put on them. The designer watches the moments. %>
<h2>What it did</h2>
<% if @trial.moves.any? %>
  <p><%= @trial.moves.map { |name, n| "#{name} ×#{n}" }.to_sentence %>.</p>
<% else %>
  <p class="muted">Nothing: it never got a turn.</p>
<% end %>
<% if (adds = @trial.moves(adds: true)).any? %>
  <p>What it called did: <%= adds.map { |name, n| "#{name} ×#{n}" }.to_sentence %>.</p>
<% end %>
<% if @trial.said.any? %>
  <p>Said: <%= safe_sentence(@trial.said.map { |line, n| tag.q(line) + (n > 1 ? " ×#{n}" : "") }) %>.</p>
<% end %>
<% if @trial.became.any? %>
  <p>Became <%= @trial.became.map { |name, round| "#{name} in round #{round}" }.to_sentence %>.</p>
<% end %>
<% if @trial.fallen.any? %>
  <p>Fell: <%= @trial.fallen.map { |name, round| "#{name} in round #{round}" }.to_sentence %>.</p>
<% end %>
<% if @trial.inflicted.any? %>
  <p>Put on the party: <%= @trial.inflicted.map { |name, n| "#{name} ×#{n}" }.to_sentence %>.</p>
<% end %>
<%= render "forecast" %>
<p class="hint">
  Seed <%= @trial.state["seed"] %>. <%= link_to "Edit #{@monster.name}", edit_world_bestiary_monster_path(@world, @monster) %>, or try
  <% [ 1, 2, 3, 4 ].each do |n| %><%= link_to "#{n} of them", world_bestiary_monster_trial_path(@world, @monster, count: n, level: @trial.level) %><%= ", " unless n == 4 %><% end %>,
  or <%= link_to "another roll", world_bestiary_monster_trial_path(@world, @monster, count: @trial.count, seed: @trial.state["seed"].to_i + 1, level: @trial.level) %>.
  A first boss should take a party like this six rounds or more and cost it someone; a towpath creature, two or three.
  The party is level <%= Monster::Trial::REFERENCE_LEVEL %>, or the creature's own level if that is higher<%= " (here, level #{@trial.level})" unless @trial.level == Monster::Trial::REFERENCE_LEVEL %>; in starting gear at any level.
  Try it against a party of level
  <% levels = ([ Monster::Trial::REFERENCE_LEVEL, 10, 20, 40 ] + [ Monster::Trial.level_for(@monster) ]).uniq.sort %>
  <% levels.each_with_index do |n, i| %><%= n == @trial.level ? tag.strong(n) : link_to(n, world_bestiary_monster_trial_path(@world, @monster, count: @trial.count, level: n)) %><%= i == levels.size - 1 ? "." : ", " %><% end %>
  <% if (counters = @trial.untried_counters).any? %>
    Its answers to blows of <%= counters.map { |t| term(t) }.to_sentence %> never come here: this party only attacks.
  <% end %>
</p>
