<header class="book-page__header">
  <%= entry_portrait(entry) %>
  <div>
    <p class="eyebrow">Bestiary · Level <%= entry.level %><%= " · Boss" if entry.boss? %><%= " · Undead" if entry.undead? %><%= " · Giant" if entry.giant? %></p>
    <h1><%= entry.name %></h1>
    <dl class="facts">
      <dt>EXP</dt><dd><%= entry.exp %></dd>
      <dt><%= word("currency").upcase_first %></dt><dd><%= entry.gil %></dd>
      <dt>ABP</dt><dd><%= entry.abp %></dd>
    </dl>
  </div>
</header>

<% if entry.description.present? %>
  <div class="prose"><%= simple_format(entry.description) %></div>
<% end %>
<% if entry.boss_line.present? %>
  <blockquote class="boss-line"><%= entry.boss_line %></blockquote>
<% end %>

<section class="window">
  <h2>Stat block</h2>
  <dl class="stat-block">
    <% Stats::NAMES.each do |stat| %>
      <div><dt><%= stat_term(stat) %></dt><dd><%= number_with_delimiter(entry.stats[stat]) %></dd></div>
    <% end %>
  </dl>
  <% profile = type_profile([ entry.base_type ], entry.affinities) %>
  <dl class="facts facts--wide type-facts">
    <% if types_matter? %><dt>Type</dt><dd><%= type_tag(entry.base_type) %> <%= link_to "the chart", world_types_path(@world), class: "muted" %></dd><% end %>
    <% { "weak" => "Weak to", "resist" => "Resists", "immune" => "Immune to", "absorb" => "Absorbs" }.each do |band, label| %>
      <% if profile[band].any? %><dt><%= label %></dt><dd><%= safe_join(profile[band].map { |t| type_tag(t) }, " ") %></dd><% end %>
    <% end %>
    <% if entry.status_immune.any? %>
      <dt>Shrugs off</dt><dd><%= entry.status_immune.map { |s| term(s) }.join(", ") %></dd>
    <% end %>
  </dl>
  <% if entry.affinities.any? %>
    <p class="hint">Breaks the chart: <%= entry.affinities.map { |type, a| "#{term(a).downcase} #{type_name(type).downcase}" }.to_sentence %>.</p>
  <% end %>
</section>

<section class="window">
  <h2>Behavior</h2>
  <p class="hint"><%= link_to "Try it against a level-5 party", world_bestiary_monster_trial_path(@world, entry) %>: how a fight with <%= entry.boss? ? "it" : "two of them" %> goes on default commands.</p>
  <% abilities = entry.abilities.index_by(&:slug) %>
  <ol class="ai-script">
    <% entry.ai_script.each do |rule| %>
      <li>
        <% conditions = rule.fetch("if", {}) %>
        <%= conditions.empty? ? "Otherwise" : "If " + conditions.map { |name, value| describe_condition(name, value) }.join(" and ") %>:
        <% ability = abilities[rule["use"]] %>
        <%= ability ? link_to(ability.name, world_grimoire_ability_path(@world, ability)) : "Attack" %>
        <% if rule["target"] %><span class="muted">→ <%= term(rule["target"]) %></span><% end %>
      </li>
    <% end %>
  </ol>
  <% unless entry.ai_script.last&.then { |rule| rule["if"].blank? } %>
    <p class="hint">When no rule matches: Attack.</p>
  <% end %>
</section>

<section class="window">
  <h2>Drops</h2>
  <% if entry.drops.empty? %>
    <p class="empty">Nothing.</p>
  <% else %>
    <% items = entry.drop_items %>
    <ul class="refs">
      <% entry.drops.each do |drop| %>
        <% item = items[drop["item"]] %>
        <li><%= item ? link_to(item.name, world_armory_item_path(@world, item)) : drop["item"] %> (<%= drop["chance"] %>%)</li>
      <% end %>
    </ul>
  <% end %>
</section>

<% tables = @world.encounter_tables.select { |table| table.entries.any? { |group| group["monsters"].key?(entry.slug) } } %>
<% if tables.any? %>
  <section class="window">
    <h2>Found in</h2>
    <ul class="refs refs--inline">
      <% tables.each do |table| %>
        <li><%= link_to table.name, world_encounters_encounter_table_path(@world, table) %></li>
      <% end %>
    </ul>
  </section>
<% end %>
