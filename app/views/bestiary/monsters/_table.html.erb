<table class="book-table">
  <thead><tr><th class="num">Lv</th><th>Name</th><th class="num">HP</th><% if types_matter? %><th>Type</th><th>Weak to</th><% end %><th class="num">EXP</th><th class="num"><%= word("currency").upcase_first %></th></tr></thead>
  <tbody>
    <% entries.each do |monster| %>
      <tr>
        <td class="num"><%= monster.level %></td>
        <td><%= link_to monster.name, entry_path(monster) %></td>
        <td class="num"><%= number_with_delimiter(monster.stats["max_hp"]) %></td>
        <% if types_matter? %>
          <td><%= type_tag(monster.base_type) %></td>
          <td><%= type_profile([ monster.base_type ], monster.affinities)["weak"].map { |t| type_name(t) }.join(", ").presence || "—" %></td>
        <% end %>
        <td class="num"><%= monster.exp %></td>
        <td class="num"><%= monster.gil %></td>
      </tr>
    <% end %>
  </tbody>
</table>
