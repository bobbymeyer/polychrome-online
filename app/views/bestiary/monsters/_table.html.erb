<table class="book-table">
  <thead><tr><th class="num">Lv</th><th>Name</th><th class="num">HP</th><th>Type</th><th>Weak to</th><th class="num">EXP</th><th class="num">Gil</th></tr></thead>
  <tbody>
    <% entries.each do |monster| %>
      <tr>
        <td class="num"><%= monster.level %></td>
        <td><%= link_to monster.name, entry_path(monster) %></td>
        <td class="num"><%= number_with_delimiter(monster.stats["max_hp"]) %></td>
        <td><%= type_tag(monster.base_type) %></td>
        <td><%= type_profile([ monster.base_type ], monster.affinities)["weak"].map { |t| term(t) }.join(", ").presence || "—" %></td>
        <td class="num"><%= monster.exp %></td>
        <td class="num"><%= monster.gil %></td>
      </tr>
    <% end %>
  </tbody>
</table>
