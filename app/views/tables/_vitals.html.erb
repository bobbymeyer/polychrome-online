<%# A character's HP and MP at a glance (the local co-op controller). %>
<p class="vitals">
  <span class="label">HP</span> <strong><%= character.current_hp %></strong><span class="muted">/<%= character.stats["max_hp"] %></span>
  <span class="bar"><span class="bar__fill bar__fill--<%= hp_band("hp" => character.current_hp, "stats" => character.stats) %>" style="width: <%= (100.0 * character.current_hp / character.stats["max_hp"]).round %>%"></span></span>
  <span class="label">MP</span> <strong><%= character.current_mp %></strong><span class="muted">/<%= character.stats["max_mp"] %></span>
</p>
