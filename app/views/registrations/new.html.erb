<% content_for :title, "Make an account" %>
<div class="auth">
  <h1>Make an account</h1>
  <% unless User.exists? %>
    <p class="prose">Nobody is here yet. The first account runs the place: it builds the world, makes the art, and can GM any campaign.</p>
  <% end %>
  <%= form_with model: @user, url: registration_path, class: "book-form" do |form| %>
    <%= render "book_entries/errors", entry: @user %>
    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "nickname", maxlength: 60 %>
    </div>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username" %>
    </div>
    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 10, maxlength: 72 %>
      <p class="hint">At least 10 characters.</p>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Password again" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <div class="actions"><%= form.submit "Make the account", class: "button" %></div>
  <% end %>
  <p><%= link_to "I have an account", new_session_path %></p>
</div>
