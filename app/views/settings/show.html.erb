<% content_for :title, "Settings" %>
<h1>Settings</h1>
<p class="prose">
  Where this app finds ComfyUI (for images), a background remover and a language model (for drafts and prompts). Leave a field blank to use the server's
  environment (<code>COMFY_URL</code>, <code>CUTOUT_URL</code>, <code>LLM_URL</code> and so on). Only addresses and names go here: if ComfyUI or the model needs a
  token, a header or a password, set it in the environment, where it never reaches the database.
</p>

<%= form_with model: @setting, url: settings_path, method: :patch, class: "book-form" do |f| %>
  <%= render "book_entries/errors", entry: @setting %>
  <% env = Rails.configuration.x.comfy %>
  <fieldset class="panel">
    <legend>ComfyUI</legend>
    <div class="field">
      <%= f.label :comfy_url, "Address" %>
      <%= f.url_field :comfy_url, placeholder: env[:url] %>
      <p class="hint">
        Blank uses <code><%= env[:url].to_s.sub(%r{//[^@/]*@}, "//") %></code>.
        From inside a container, ComfyUI on the same machine is usually <code>http://host.docker.internal:8188</code>.
      </p>
    </div>
    <% caps = Comfy.capabilities %>
    <div class="field">
      <%= f.label :comfy_model, "Default model" %>
      <% if caps.reachable? %>
        <%= grouped_picker "site_setting[comfy_model]", @setting.comfy_model, model_groups(caps), blank: "From the environment: #{env[:model]}", id: "site_setting_comfy_model" %>
      <% else %>
        <%= f.text_field :comfy_model, placeholder: env[:model] %>
      <% end %>
      <p class="hint">Used when no world, content type or entry names a model.</p>
    </div>
  </fieldset>

  <% cutout = Rails.configuration.x.cutout %>
  <fieldset class="panel">
    <legend>Background removal</legend>
    <p class="hint">
      A service of its own, called on each image after ComfyUI renders it, for the content types marked to lose their background.
      It's hardwired: the app runs rembg on this machine's port 7071 by itself (<code>bin/cutout</code>, started the first time a picture needs it),
      so nothing here needs filling in. Set an address only for a remover somewhere else (from a container, the host's:
      <code>http://host.docker.internal:7071</code>), or anything that takes the image as a multipart <code>file</code> and answers with a PNG.
    </p>
    <div class="field-row">
      <div class="field">
        <%= f.label :cutout_url, "Address" %>
        <%= f.url_field :cutout_url, placeholder: cutout[:url].presence || "http://127.0.0.1:7071" %>
      </div>
      <div class="field">
        <%= f.label :cutout_model, "Model" %>
        <%= f.text_field :cutout_model, placeholder: cutout[:model] %>
        <p class="hint">rembg: <code>isnet-anime</code> for flat illustrated art (quick, light), <code>isnet-general-use</code>, <code>birefnet-general</code> (the finest edges; wants a GPU), <code>bria-rmbg</code>…</p>
      </div>
    </div>
    <p class="hint">
      <code>bin/cutout</code> installs and runs rembg's server, and fetches the model first; <code>bin/cutout check</code> sends a picture through. Pictures to be cut out are rendered on a
      <%= Cutout.ground ? "#{Cutout.ground} ground (CUTOUT_GROUND)" : "white ground (CUTOUT_GROUND is blank)" %> and mended afterwards, so the white in a design is kept.
    </p>
  </fieldset>

  <% draft = env.fetch(:draft, {}).to_h.symbolize_keys %>
  <fieldset class="panel">
    <legend>Drafts</legend>
    <p class="hint">
      Drafts are rough previews; “Make this one properly” renders the one you like at full size, starting from the draft.
      Smaller and fewer steps is faster; blank uses <code>config/comfy.yml</code>.
    </p>
    <div class="field-row">
      <div class="field">
        <%= f.label :draft_size, "Size (pixels a side)" %>
        <%= f.number_field :draft_size, min: 256, max: 1024, step: 64, placeholder: Math.sqrt(draft.fetch(:pixels, 262_144)).round %>
        <p class="hint">The same number of pixels as a square this wide, in the content type's shape.</p>
      </div>
      <div class="field">
        <%= f.label :draft_steps, "Steps" %>
        <%= f.number_field :draft_steps, min: 1, max: 60, placeholder: draft.fetch(:steps, 16) %>
        <p class="hint">A model that already takes fewer keeps its own.</p>
      </div>
      <div class="field">
        <%= f.label :draft_denoise, "How much “properly” changes it" %>
        <%= f.number_field :draft_denoise, min: 0.1, max: 1, step: 0.05, placeholder: draft.fetch(:denoise, 0.6) %>
        <p class="hint">Lower keeps closer to the draft; higher adds more detail and drifts more.</p>
      </div>
      <div class="field">
        <%= f.label :candidates, "Candidates per batch" %>
        <%= f.number_field :candidates, min: 1, max: 8, placeholder: env[:candidates] %>
        <p class="hint">The starting number on each generate form.</p>
      </div>
    </div>
  </fieldset>

  <% llm_env = Rails.configuration.x.llm %>
  <fieldset class="panel">
    <legend>Language model</legend>
    <div class="field">
      <%= f.label :llm_url, "Address" %>
      <%= f.url_field :llm_url, placeholder: llm_env[:url].presence || "http://host.docker.internal:8090/v1" %>
      <p class="hint">An OpenAI-compatible API, up to and including <code>/v1</code>: llama.cpp, llama-swap, Ollama, LM Studio, vLLM or a hosted one. Blank everywhere turns the language model off.</p>
    </div>
    <div class="field">
      <%= f.label :llm_model, "Model" %>
      <%= f.text_field :llm_model, placeholder: llm_env[:model].presence || "as the server names it" %>
    </div>
  </fieldset>

  <div class="actions"><%= f.submit "Save and check", class: "button" %></div>
<% end %>

<%= render "settings/connection" %>
