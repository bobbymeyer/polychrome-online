<%# Each step of reaching ComfyUI and the language model (Comfy::Doctor), on demand. %>
<section class="window" id="connection">
  <h2>Connection</h2>
  <% if params[:check] %>
    <p class="hint">In a container: <%= Comfy::Doctor.in_container? ? "yes" : "no" %>.</p>
    <% [ Comfy::Doctor.comfy, Comfy::Doctor.llm ].compact.each do |doctor| %>
      <dl class="facts connection-steps">
        <% doctor.steps.each do |step| %>
          <dt><%= step.ok ? "✓" : "✗" %> <%= step.label %></dt><dd class="<%= 'error' unless step.ok %>"><%= step.detail %></dd>
        <% end %>
      </dl>
    <% end %>
    <p><%= link_to "Check again", settings_path(check: 1, anchor: "connection"), class: "button button--quiet" %></p>
  <% else %>
    <p class="hint">Each step of reaching ComfyUI and the language model, checked in turn, with what a failure usually means.</p>
    <p><%= link_to "Check the connection", settings_path(check: 1, anchor: "connection"), class: "button button--quiet" %></p>
  <% end %>
</section>
