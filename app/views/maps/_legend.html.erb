<dl class="map-legend">
  <% [ %w[town Town], %w[dungeon Dungeon], %w[field Field], %w[event Event] ].each do |kind, label| %>
    <dt><svg class="map-node--<%= kind %>" viewBox="-16 -16 32 32" aria-hidden="true"><%= render "map_nodes/shape", kind: kind %></svg></dt><dd><%= label %></dd>
  <% end %>
  <% if local_assigns[:gm] %>
    <dt><svg viewBox="-16 -16 32 32" aria-hidden="true"><%= render "map_nodes/shape", kind: "town", extra: "is-outline" %></svg></dt><dd>Hidden from the players</dd>
  <% end %>
  <dt><svg viewBox="-16 -16 32 32" aria-hidden="true"><%= render "maps/party_marker" %></svg></dt><dd>The party</dd>
  <dt class="map-legend__path map-legend__path--open"></dt><dd>Open path</dd>
  <dt class="map-legend__path map-legend__path--dangerous"></dt><dd>Dangerous path</dd>
  <dt class="map-legend__path map-legend__path--blocked"></dt><dd>Blocked</dd>
</dl>
