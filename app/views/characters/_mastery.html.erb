<section class="window" id="mastery">
  <h2><%= gloss(:mastery) %></h2>
  <p class="hint">
    Each ability grows stronger for <%= Stats::Mastery::SPAN %> archetype levels after it's learned, up to +<%= Stats::Mastery::MASTERY_BONUS %>%.
    Used in the archetype that teaches it, it gets another +<%= Stats::Mastery::ACTIVE_BONUS %>%. A mastered ability used in another archetype keeps its own archetype's STR and MAG.
  </p>
  <table class="book-table book-table--plain mastery-table">
    <thead><tr><th>Ability</th><th>Archetype</th><th>Mastery</th><th class="num">Power now</th></tr></thead>
    <tbody>
      <% masteries.sort_by { |ability, m| [ @character.active?(ability) ? 0 : 1, -m[:percent], ability.name ] }.each do |ability, m| %>
        <% active = @character.active?(ability) %>
        <tr class="<%= 'is-current' if active %>">
          <td><%= link_to ability.name, world_grimoire_ability_path(@world, ability) %></td>
          <td><%= m[:job].name %></td>
          <td>
            <span class="bar mastery-bar"><span class="bar__fill bar__fill--<%= m[:percent] == Stats::Mastery::FULL ? 'mastered' : 'ok' %>" style="width: <%= m[:percent] %>%"></span></span>
            <%= m[:percent] == Stats::Mastery::FULL ? tag.strong("Mastered") : "#{m[:percent]}%" %>
          </td>
          <td class="num">
            <%= Stats::Mastery.power(m[:percent], active: active) %>%
            <% if m[:percent] == Stats::Mastery::FULL && !active && m[:job] != @character.job %>
              <br><span class="muted">with <%= m[:job].name %>'s <%= @character.home_stats(m[:job]).select { |stat, value| value > @character.stats[stat] }.keys.map { |stat| stat_label(stat) }.to_sentence.presence || "stats" %></span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
