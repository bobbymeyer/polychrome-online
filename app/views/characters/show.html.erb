<% content_for :title, @character.name %>
<% content_for :head, music_meta(@character.campaign, @character.campaign&.scene) %>
<%= render "shared/stage_stream", campaign: @character.campaign %>
<div class="crumbs"><%= link_to @campaign.name, campaign_path(@campaign) %> / <%= @character.name %></div>

<article class="book-page">
  <%= render "characters/header", cj: @character.character_job %>

  <%= render "characters/stats", stages: @character.stat_stages %>

  <%= render "characters/items" if can_manage?(@character) %>

  <%= render "characters/equipment" %>

  <%= render "characters/abilities" %>

  <%= render "characters/skills" %>

  <% masteries = @character.masteries %>
  <%= render "characters/mastery", masteries: masteries if masteries.any? %>

  <%= render "characters/jobs" %>

  <%= render "characters/gm" if can_gm?(@campaign) %>
</article>

<% if can_manage?(@character) %>
<div class="actions">
  <%= link_to "Edit", edit_character_path(@character), class: "button" %>
  <%= button_to "Remove from party", character_path(@character), method: :delete, class: "button button--danger",
                form: { data: { turbo_confirm: "Remove #{@character.name}? Their gear goes back to the bag." } } %>
</div>
<% end %>
