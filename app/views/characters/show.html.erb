<% content_for :title, @character.name %>
<% content_for :head, music_meta(@character.campaign, @character.campaign&.scene) %>
<%= render "shared/stage_stream", campaign: @character.campaign %>
<div class="crumbs"><%= link_to @campaign.name, campaign_path(@campaign) %> / <%= @character.name %></div>

<article class="book-page character-sheet" data-controller="sheet-tabs" data-sheet-tabs-key-value="sheet-<%= @character.id %>">
  <% masteries = @character.masteries %>
  <%# Six tabs at most: what they are, what they carry and wear, what they do, what they're good at (mastery with it),
      their archetypes, and their look. %>
  <% tabs = { "stats" => "Stats", "gear" => "Gear", "abilities" => "Abilities", "skills" => "Skills", "jobs" => "Archetypes",
              "look" => ("Look" if can_portray?(@character)) }.compact %>
  <%# The sections, one at a time: the links along the top are tabs (sheet_tabs_controller); first on the page,
      so they're at the top on every screen. %>
  <nav class="sheet-nav" aria-label="On this sheet">
    <% tabs.each do |key, label| %>
      <%= link_to label, "##{key}", data: { sheet_tabs_target: "tab", key: key, action: "sheet-tabs#pick" } %>
    <% end %>
  </nav>

  <%# On a wide screen, who they are stays in a column on the left while the section shown sits beside it. %>
  <div class="character-sheet__columns">
    <aside class="character-sheet__who">
      <%= render "characters/header", cj: @character.character_job %>
    </aside>
    <div class="character-sheet__body">
      <% panel = ->(key, &block) { tag.div(class: "sheet-panel", data: { sheet_tabs_target: "panel", key: key }, &block) } %>
      <%= panel.("stats") { render "characters/stats", stages: @character.stat_stages } %>
      <%= panel.("gear") { safe_join([ render("characters/equipment"), render("characters/chest"), (render("characters/items") if can_manage?(@character)) ].compact) } %>
      <%= panel.("abilities") { render "characters/abilities" } %>
      <%= panel.("skills") { safe_join([ render("characters/skills"), (render("characters/mastery", masteries: masteries) if masteries.any?) ].compact) } %>
      <%= panel.("jobs") { render "characters/jobs" } %>
      <%= panel.("look") { render "characters/look" } if can_portray?(@character) %>
    </div>
  </div>
</article>

<%# Leaving the party is on the Edit page, out of the way of play; the GM's EXP and ABP grant is in GM tools at the table. %>
<% if can_manage?(@character) %>
<div class="actions">
  <%= link_to "Edit", edit_character_path(@character), class: "button" %>
</div>
<% end %>
