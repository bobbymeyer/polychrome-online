<%# Where a character is from (World#origins), their home on the map, and who they're tied to. f: the form; character. %>
<% world = character.campaign.world %>
<% origins = Array(world.origins) %>
<div class="field-row">
  <% if origins.any? %>
    <div class="field">
      <%= f.label :origin, "Where they're from" %>
      <%= f.select :origin, origins.map { |o| [ o["name"], o["slug"] ] }, include_blank: "Nowhere in particular" %>
      <p class="hint"><%= safe_join(origins.map { |o| tag.span("#{o['name']}: #{o['description']}#{" (+#{World::ORIGIN_BONUS} #{world.skill(o['skill'])&.dig('name')})" if o['skill'].present?}") }, tag.br) %></p>
    </div>
  <% end %>
  <% homes = character.campaign.map_nodes.where(visible: true).order(:name) %>
  <% if homes.any? %>
    <div class="field"><%= f.label :home_node_id, "Home" %><%= f.select :home_node_id, homes.map { |n| [ n.name, n.id ] }, include_blank: "None on the map" %></div>
  <% end %>
</div>
<fieldset class="field">
  <legend>Ties</legend>
  <p class="hint">Who they owe, love, fear or ran from. The GM sees these too.</p>
  <% npcs = character.campaign.npcs.order(:name).map { |n| [ [ n.name, n.title.presence ].compact.join(", "), n.id ] } %>
  <% (Array(character.ties) + Array.new(2) { {} }).first(6).each_with_index do |tie, i| %>
    <div class="field-row">
      <% if npcs.any? %>
        <div class="field"><%= select_tag "character[ties][#{i}][npc_id]", options_for_select(npcs, tie["npc_id"]), include_blank: "Someone", "aria-label": "Tie #{i + 1}: who" %></div>
      <% end %>
      <div class="field"><%= text_field_tag "character[ties][#{i}][text]", tie["text"], placeholder: "owes her money", "aria-label": "Tie #{i + 1}" %></div>
    </div>
  <% end %>
</fieldset>
