<section class="window" id="items" data-controller="help">
  <h2>Items</h2>
  <% usable = @campaign.field_items %>
  <% if @campaign.battle_on? %>
    <% open_battle = @campaign.battles.where(status: "input").order(:id).last %>
    <p class="hint">A battle is on (<%= link_to open_battle.name, battle_path(open_battle) %>): use items from its Item menu. The GM can end it from the battle if it's been abandoned.</p>
  <% elsif usable.empty? %>
    <p class="empty">Nothing in the bag that works outside battle: only things that heal or raise the fallen do.</p>
  <% else %>
    <% party = @campaign.characters.order(:created_at) %>
    <table class="book-table book-table--plain shop-table">
      <tbody>
        <% usable.each do |row| %>
          <% revive = Battle::State.revives?(row.item.to_engine(1)) %>
          <%# Only whoever it would help: the fallen for a revive, the hurt for a heal (Battle::Field). %>
          <% helps = ->(c) { revive ? !c.conscious? : c.conscious? && c.current_hp < c.stats["max_hp"] } %>
          <% targets = row.item.target == "self" ? [ @character ].select(&helps) : party.select(&helps) %>
          <tr data-help="<%= @character.name %> uses it. Items that cure statuses only work in battle, where statuses are.">
            <td><%= row.item.name %> <span class="muted">×<%= row.quantity %></span><br><span class="hint"><%= row.item.effects.map { |e| describe_effect(e) }.join(" · ") %></span></td>
            <td class="shop-table__buy">
              <% if targets.empty? %>
                <span class="muted"><%= revive ? "Nobody is KO'd" : (row.item.target == "self" ? "#{@character.name} is unhurt" : "Nobody is hurt") %></span>
              <% else %>
                <%= form_with url: character_item_use_path(@character), class: "inline-form shop-form" do |f| %>
                  <%= hidden_field_tag :item, row.item.slug, id: nil %>
                  <% if row.item.target == "self" %>
                    <span class="muted"><%= @character.name %></span>
                  <% else %>
                    <%= select_tag :target_id, options_for_select(targets.map { |c| [ "#{c.name} (HP #{c.current_hp}/#{c.stats['max_hp']})", c.id ] },
                                                                 targets.min_by { |c| c.current_hp.fdiv(c.stats["max_hp"]) }&.id),
                                   id: "use_#{row.item.slug}_target", "aria-label": "Use #{row.item.name} on" %>
                  <% end %>
                  <%= f.submit "Use", class: "button play" %>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= help_line %>
  <% end %>
</section>
