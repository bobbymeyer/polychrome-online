<% content_for :title, "Edit #{@character.name}" %>
<%= turbo_stream_from @character, :art if can_gm?(@campaign) %>
<div class="crumbs"><%= link_to @campaign.name, campaign_path(@campaign) %> / <%= link_to @character.name_in_database, character_path(@character) %> / Edit</div>
<h1>Edit <%= @character.name_in_database %></h1>
<%= form_with model: @character, url: character_path(@character), class: "book-form", multipart: true do |f| %>
  <%= render "book_entries/errors", entry: @character %>
  <div class="field-row">
    <div class="field"><%= f.label :name %><%= f.text_field :name, required: true %></div>
    <div class="field"><%= f.label :player_name, "Player without an account" %><%= f.text_field :player_name, placeholder: "Optional" %></div>
    <div class="field"><%= f.label :colour, "Colour (until they have a portrait)" %><%= f.select :colour, colour_options(f.object.colour) %></div>
    <% if can_gm?(@campaign) %>
      <div class="field">
        <%= f.label :user_id, "Player's account" %>
        <%= f.select :user_id, User.alphabetical.map { |u| [ u.name, u.id ] }, include_blank: "Nobody yet" %>
      </div>
    <% end %>
  </div>
  <div class="field">
    <%= f.label :motive, "Why they're here" %>
    <%= f.text_field :motive, maxlength: Character::MOTIVE_LENGTH, placeholder: "“I owe the Crystal a life. Mine.”" %>
    <p class="hint">One line, in their own words. It's on their card, and it's what they shout when their back is to the wall.</p>
  </div>
  <%= render "portraits/fields", owner: @character %>
  <div class="actions">
    <%= f.submit class: "button" %>
    <%= link_to "Cancel", character_path(@character), class: "button button--quiet" %>
  </div>
<% end %>
<%= render "art_batches/portraits", owner: @character if can_gm?(@campaign) %>
