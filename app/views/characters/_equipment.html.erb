<section class="window" id="equipment">
  <h2>Equipment</h2>
  <% equipped = @character.equipped %>
  <%# Worn from their own bag (characters/_chest has the bag and the party's chest). %>
  <% bag = @character.bag.map(&:item) %>
  <% unless can_manage?(@character) %>
    <dl class="facts">
      <% Character::SLOTS.each do |slot| %><dt><%= term(slot) %></dt><dd><%= equipped[slot]&.item&.name || "—" %></dd><% end %>
    </dl>
  <% else %>
  <%= form_with url: character_equipment_path(@character), method: :patch, scope: :equipment, class: "book-form" do |f| %>
    <div class="stat-inputs equipment-inputs">
      <% Character::SLOTS.each do |slot| %>
        <% current = equipped[slot]&.item %>
        <% fits, misfits = bag.select { |item| item.slot == slot }.partition { |item| @character.job.equips?(item) } %>
        <% options = ([ current ].compact + fits).uniq.map { |item| [ item.name, item.id ] } +
                     misfits.reject { |item| item == current }.map { |item| [ "#{item.name}: #{term(item.category).downcase}, not for a #{@character.job.name}", item.id, { disabled: true } ] } %>
        <div class="field">
          <%= f.label slot, term(slot) %>
          <%= f.select slot, options, { include_blank: "—", selected: current&.id } %>
        </div>
      <% end %>
    </div>
    <%= help_line %>
    <%= f.submit "Update equipment", class: "button" %>
  <% end %>
  <% end %>
</section>
