<%# One batch's candidates (§8). The page refreshes itself as they land. %>
<% world = batch.world %>
<div class="art-batch" id="<%= dom_id(batch) %>">
  <h3><%= batch.draft? ? "Drafts" : (batch.recipe["refines"] ? "Made properly" : "Candidates") %><%= " for #{batch.entry.expression.humanize}" if batch.entry.is_a?(Portrait) %><%= " for the sprite" if batch.entry.is_a?(Sprite) %><%= " for #{batch.entry.mode['name']}" if batch.entry.is_a?(ModeArt) %><%= " for step #{batch.entry.position + 1}" if batch.entry.is_a?(Beat) %></h3>
  <% case batch.status %>
  <% when "queued", "running" %>
    <p class="art-batch__status" role="status">Generating: <%= batch.candidates.count(&:finished?) %> of <%= batch.candidates.size %> in.</p>
  <% when "waiting" %>
    <p class="art-batch__status" role="status">Waiting: <%= batch.error.to_s.start_with?("The background remover") ? "the background remover" : "ComfyUI" %> can't be reached right now, so this will carry on by itself when it's back. <span class="muted">(<%= batch.error %>)</span></p>
  <% when "failed" %>
    <p class="form-errors" role="alert"><%= batch.error %></p>
  <% end %>
  <ol class="candidate-strip">
    <% batch.candidates.each do |candidate| %>
      <li class="candidate is-<%= candidate.status %>" id="<%= dom_id(candidate) %>">
        <figure>
          <% if candidate.image.attached? %>
            <%= image_tag url_for(candidate.image), alt: "Candidate #{candidate.position + 1}, seed #{candidate.seed}" %>
          <% else %>
            <span class="candidate__empty"><%= candidate.status == "failed" ? "Failed" : "…" %></span>
          <% end %>
          <figcaption>Seed <%= candidate.seed %><%= tag.span(" · #{candidate.run_seconds < 60 ? "#{candidate.run_seconds.round}s" : "#{(candidate.run_seconds / 60).floor}m #{(candidate.run_seconds % 60).round}s"}", class: "muted", title: "Time ComfyUI spent on it") if candidate.run_seconds %><%= tag.span(" · background kept", class: "muted", title: candidate.error || "The background remover gave back an image with no transparency") if candidate.transparent == false || (candidate.error && candidate.status == "done") %><%= tag.span(" · #{candidate.error}", class: "muted") if candidate.error && candidate.status == "failed" && batch.status != "failed" %></figcaption>
        </figure>
        <% if candidate.image.attached? %>
          <%# The whole page, since the new image shows outside this frame too. %>
          <% if batch.draft? %>
            <%= button_to "Make this one properly", world_art_candidate_refinements_path(world, candidate), class: "button",
                          form: { data: { turbo_frame: "_top", turbo_action: "advance" } } %>
            <%= button_to "Use the draft", world_art_candidate_pick_path(world, candidate), class: "link-button",
                          form: { data: { turbo_frame: "_top", turbo_action: "advance" } } %>
          <% else %>
            <%= button_to "Use this", world_art_candidate_pick_path(world, candidate), class: "button",
                          form: { data: { turbo_frame: "_top", turbo_action: "advance" } } %>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ol>
  <%= button_to "Discard these", world_art_batch_path(world, batch), method: :delete, class: "link-button" %>
</div>
