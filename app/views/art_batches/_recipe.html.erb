<%# One image recipe (§8), as ComfyUI will get it (apart from the seed). preview: also build the workflow against
    what ComfyUI has installed now, to show its nodes or what's missing. %>
<% model = recipe["model"] || recipe["checkpoint"] %>
<% family = Comfy::Family.find(recipe["family"], model) %>
<dl class="facts">
  <dt>Prompt</dt><dd><%= recipe["positive"] %></dd>
  <% if recipe.dig("parts", "written") %>
    <dt>Subject</dt><dd>written by the language model from “<%= recipe.dig("parts", "subject") %>”</dd>
  <% elsif recipe["writer_error"] %>
    <dt>Subject</dt><dd>as written: the language model couldn't help (<%= recipe["writer_error"] %>)</dd>
  <% end %>
  <dt>Negative</dt><dd><%= recipe["negative"].presence || (family && !family.negative? ? "none: this model doesn't use one" : "—") %></dd>
  <dt>LoRAs</dt><dd><%= lora_stack(Array(recipe["loras"])) %></dd>
  <dt>Model</dt><dd><code><%= model %></code><%= " · #{family.summary}" if family %></dd>
  <dt>Size</dt><dd><%= recipe["width"] %> × <%= recipe["height"] %><% if recipe["transparent"] %><%= recipe["cutout"] ? ", background removed with #{recipe['cutout']}" : ", background kept (no background remover set up)" %><% end %></dd>
  <% if recipe["workflow"] %>
    <dt>Workflow</dt><dd><%= recipe["workflow"] %></dd>
  <% elsif local_assigns[:preview] && Comfy.capabilities.reachable? %>
    <% begin %>
      <% outline = Comfy::Workflow.outline(Comfy::Workflow.build(recipe, seed: 0, prefix: "preview", capabilities: Comfy.capabilities)) %>
      <dt>Workflow</dt><dd><%= outline %></dd>
    <% rescue Comfy::Error => e %>
      <dt>Workflow</dt><dd class="error">Can't be built on this ComfyUI: <%= e.message %></dd>
    <% end %>
  <% end %>
</dl>
