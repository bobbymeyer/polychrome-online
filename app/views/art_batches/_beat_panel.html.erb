<%# The panel for one beat (§8): the place it stands in as the subject, this beat's words as the layer after
    it, like a mode's picture. beat. Reloaded in the "art_panel" frame as candidates land. %>
<% world = beat.campaign.world %>
<% batch = beat.art_batch %>
<details class="window art-studio art-studio--beat" id="art" <%= "open" if batch || beat.backdrop == "panel" %>>
  <summary>Panel for step <%= beat.position + 1 %><%= tag.span(" · ComfyUI isn't answering", class: "art-studio__status") unless Comfy.capabilities.reachable? %></summary>
  <% if beat.image.attached? %>
    <%= image_tag url_for(beat.image), alt: "Step #{beat.position + 1}'s panel", class: "art-studio__panel" %>
  <% end %>
  <% unless beat.kind == "backdrop" && beat.backdrop == "panel" %>
    <p class="hint">This step isn't a panel backdrop: <%= beat.describe %>. Add a Backdrop step set to a panel, and make the panel there.</p>
  <% end %>
  <p class="hint">
    <% if (template = beat.panel_template) %>
      <%= template.name %>'s own picture with this step's words added<%= ", starting from its seed so it stays recognisable" if template.image_seed %>.
    <% else %>
      Set a place behind an earlier beat (or this one) and the panel is drawn as that place; without one, the words stand alone.
    <% end %>
  </p>
  <h3>The prompt, in layers</h3>
  <%= render "art_batches/layers", art: beat %>

  <%= form_with url: world_art_batches_path(world), class: "book-form" do |f| %>
    <%= hidden_field_tag :entry_type, "beat" %>
    <%= hidden_field_tag :beat_id, beat.id %>
    <div class="field">
      <%= label_tag :beat_words, "What the panel shows" %>
      <%= text_field_tag :beat_words, beat.art_notes, placeholder: "the airship listing over the bay at dusk" %>
      <p class="hint">Blank uses the line before this step. The words are kept with the step.</p>
    </div>
    <%= render "art_batches/background_field", art: beat %>
    <div class="inline-form">
      <div class="field"><%= label_tag :count, "Candidates" %><%= number_field_tag :count, Comfy.config[:candidates], min: 1, max: 8 %></div>
      <%= submit_tag "Generate", class: "button", disabled: !Comfy.capabilities.reachable?, title: ("ComfyUI isn't answering" unless Comfy.capabilities.reachable?) %>
    </div>
  <% end %>
  <% unless Comfy.capabilities.reachable? %>
    <p class="hint">ComfyUI at <code><%= Comfy.client.base %></code> isn't answering, so nothing can be generated. Start it and reload.</p>
  <% end %>

  <%= render "art_batches/strip", batch: batch if batch %>
  <%= render "art_batches/strip", batch: batch.drafts if batch&.drafts %>
</details>
