<%# A map's picture, generated (§8): the world's style, the map framing (a painted land from above, 16:9),
    the map's own words. map: a WorldMap or a Map. %>
<% world = map.art_world %>
<% batch = map.art_batch %>
<% kind = map.is_a?(WorldMap) ? "world" : "campaign" %>
<%= turbo_frame_tag "art_panel", data: { src: world_art_panel_path(world, entry_type: "map", map_type: kind, map_id: map.id) } do %>
<details class="window art-studio" id="art" <%= "open" if batch %>>
  <summary>Generate the picture<%= tag.span(" · ComfyUI isn't answering", class: "art-studio__status") unless Comfy.capabilities.reachable? %></summary>
  <% if map.image.attached? && map.image_seed %>
    <p>Generated, seed <strong><%= map.image_seed %></strong>.</p>
  <% elsif map.image.attached? %>
    <p class="muted">Uploaded by hand.</p>
  <% else %>
    <p class="muted">No picture yet: upload one in the form above, or generate one here.</p>
  <% end %>
  <h3>The prompt, in layers</h3>
  <%= render "art_batches/layers", art: map %>
  <%= form_with url: world_art_batches_path(world), class: "book-form" do |f| %>
    <%= hidden_field_tag :entry_type, "map", id: nil %>
    <%= hidden_field_tag :map_type, kind, id: nil %>
    <%= hidden_field_tag :map_id, map.id, id: nil %>
    <%= render "art_batches/subject_fields", subject: map %>
    <%= render "art_batches/background_field", art: map %>
    <div class="inline-form">
      <div class="field"><%= label_tag :count, "Candidates" %><%= number_field_tag :count, Comfy.config[:candidates], min: 1, max: 8 %></div>
      <%= submit_tag "Generate", class: "button", disabled: !Comfy.capabilities.reachable?, title: ("ComfyUI isn't answering" unless Comfy.capabilities.reachable?) %>
    </div>
  <% end %>
  <%= render "art_batches/strips", batches: batch %>
</details>
<% end %>
