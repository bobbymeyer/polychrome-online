<%# The asset pipeline on a book entry's page (§8): upload on the edit form, or generate here. %>
<% batch = entry.art_batch %>
<%= turbo_frame_tag "art_panel", data: { src: world_art_panel_path(entry.world, entry_type: entry.art_kind, entry_slug: entry.slug) } do %>
<section class="window art-studio" id="art" aria-label="Art">
  <h2>Art</h2>

  <% if entry.image.attached? && entry.image_seed %>
    <p>Generated, seed <strong><%= entry.image_seed %></strong>.</p>
    <% if entry.image_recipe.present? %>
      <details><summary>How it was made</summary><%= render "art_batches/recipe", recipe: entry.image_recipe %></details>
    <% end %>
  <% elsif entry.image.attached? %>
    <p class="muted">Uploaded by hand.</p>
  <% else %>
    <p class="muted">No image yet: upload one on the edit page, or generate one here.</p>
  <% end %>

  <h3>The prompt, in layers</h3>
  <%= render "art_batches/layers", art: entry %>

  <%= form_with url: world_art_batches_path(entry.world), class: "book-form" do |f| %>
    <%= hidden_field_tag :entry_type, entry.art_kind %>
    <%= hidden_field_tag :entry_slug, entry.slug %>
    <%= render "art_batches/subject_fields", subject: entry %>
    <%= render "art_batches/background_field", art: entry %>
    <div class="inline-form">
      <div class="field"><%= label_tag :count, "Candidates" %><%= number_field_tag :count, Comfy.config[:candidates], min: 1, max: 8 %></div>
      <%= submit_tag "Generate", class: "button", disabled: !Comfy.capabilities.reachable?, title: ("ComfyUI isn't answering" unless Comfy.capabilities.reachable?) %>
    </div>
  <% end %>

  <details><summary>The composed prompt</summary><%= render "art_batches/recipe", recipe: entry.art_recipe, preview: true %></details>

  <%= render "art_batches/strip", batch: batch if batch %>
</section>
<% end %>
