<%# A speaker's look, made in a chain (§8), below their uploads (a character's under Look on the sheet, an
    NPC's in the edit form): the sprite
    first, full body; the Neutral portrait redrawn from the sprite's head (Headshot), so it's the same
    face; then every other expression redrawn from the Neutral portrait. Each link can also be made
    from the prompt alone. owner: an Npc or Character; the GM's, and a player's for their own character
    (specifics only: the model and LoRAs are the GM's). %>
<% world = owner.art_world %>
<% gm = can_gm?(owner.campaign) %>
<% reachable = Comfy.capabilities.reachable? %>
<% batches = ArtBatch.where(entry: owner.portraits).or(ArtBatch.where(entry: owner.sprite)).includes(:candidates).order(id: :desc).to_a %>
<% figure = owner.sprite || Sprite.new(owner: owner) %>
<% sprite_done = figure.image.attached? %>
<% neutral = owner.portraits.find_by(expression: "neutral") %>
<% neutral_done = neutral&.image&.attached? %>
<% latest_portrait = batches.find { |b| b.entry.is_a?(Portrait) } %>
<% chosen = latest_portrait ? latest_portrait.entry.expression : "neutral" %>
<% sample = owner.portraits.find_by(expression: chosen) || Portrait.new(owner: owner, expression: chosen) %>
<% disabled = { disabled: !reachable, title: ("ComfyUI isn't answering" unless reachable) } %>
<%= turbo_frame_tag "art_panel", data: { src: world_art_panel_path(world, entry_type: "portrait", owner_type: owner.model_name.singular, owner_id: owner.id) } do %>
<details class="window art-studio art-chain" id="art" <%= "open" if batches.any? %>>
  <summary>Make their look<%= tag.span(" · ComfyUI isn't answering", class: "art-studio__status") unless reachable %></summary>
  <p class="hint">
    In three links, each from the one before so it's the same face: the <strong>sprite</strong> (full body, for the stage), the <strong>Neutral portrait</strong> redrawn from the sprite's head, then <strong>every other expression</strong> redrawn from the Neutral portrait. Any of them can be uploaded in the form above instead, or made from the prompt alone.
  </p>

  <ol class="art-chain__links">
    <li class="art-chain__link <%= 'is-done' if sprite_done %>">
      <h3>1. The sprite: full body, for the stage</h3>
      <div class="art-chain__current">
        <% if sprite_done %>
          <%= image_tag url_for(figure.image), alt: "", class: "sprite-field__image" %>
          <span class="hint">Made<%= " (seed #{figure.image_seed})" if figure.image_seed %>.</span>
        <% else %>
          <span class="hint">Nothing yet.</span>
        <% end %>
      </div>
      <%= render "art_batches/layers", art: figure %>
      <%= form_with url: world_art_batches_path(world), class: "book-form" do |f| %>
        <%= hidden_field_tag :entry_type, "sprite", id: nil %>
        <%= hidden_field_tag :owner_type, owner.model_name.singular, id: nil %>
        <%= hidden_field_tag :owner_id, owner.id, id: nil %>
        <%= render "art_batches/subject_fields", subject: owner, full: gm %>
        <%= render "art_batches/background_field", art: figure %>
        <div class="inline-form">
          <div class="field"><%= label_tag :sprite_count, "Candidates" %><%= number_field_tag :count, Comfy.config[:candidates], min: 1, max: 8, id: "sprite_count" %></div>
          <%= submit_tag "Generate the sprite", class: "button", **disabled %>
        </div>
      <% end %>
    </li>

    <li class="art-chain__link <%= 'is-done' if neutral_done %>">
      <h3>2. The Neutral portrait, from the sprite</h3>
      <div class="art-chain__current">
        <% if neutral_done %>
          <%= image_tag url_for(neutral.image), alt: "", class: "speaker-portrait speaker-portrait--small" %>
          <span class="hint">Made<%= " (seed #{neutral.image_seed})" if neutral.image_seed %>.</span>
        <% else %>
          <span class="hint">Nothing yet.</span>
        <% end %>
      </div>
      <%= form_with url: world_art_batches_path(world), class: "book-form" do |f| %>
        <%= hidden_field_tag :entry_type, "portrait", id: nil %>
        <%= hidden_field_tag :owner_type, owner.model_name.singular, id: nil %>
        <%= hidden_field_tag :owner_id, owner.id, id: nil %>
        <%= hidden_field_tag :expression, "neutral", id: nil %>
        <%= hidden_field_tag :from, "sprite", id: nil %>
        <%= hidden_field_tag :draft, "0", id: nil %>
        <div class="inline-form">
          <div class="field"><%= label_tag :neutral_count, "Candidates" %><%= number_field_tag :count, Comfy.config[:candidates], min: 1, max: 8, id: "neutral_count" %></div>
          <%= submit_tag "Draw the portrait from the sprite", class: "button", disabled: !reachable || !sprite_done,
                         title: (!reachable ? "ComfyUI isn't answering" : (sprite_done ? nil : "Make the sprite first")) %>
        </div>
        <p class="hint">The head of the sprite, cut square and redrawn as a portrait with the sprite's seed, so it's the same face a little closer up.</p>
      <% end %>
    </li>

    <li class="art-chain__link">
      <h3>3. Every other expression, from the Neutral portrait</h3>
      <div class="art-chain__current portrait-fields">
        <% existing = owner.portraits.includes(image_attachment: :blob).index_by(&:expression) %>
        <% (Portrait::EXPRESSIONS - [ "neutral" ]).each do |expression| %>
          <% portrait = existing[expression] %>
          <span class="portrait-field" title="<%= expression.humanize %>">
            <% if portrait&.image&.attached? %>
              <%= image_tag url_for(portrait.image), alt: expression.humanize, class: "speaker-portrait speaker-portrait--small" %>
            <% else %>
              <span class="speaker-portrait speaker-portrait--small speaker-portrait--plate speaker-portrait--empty">?</span>
            <% end %>
            <small><%= expression.humanize %></small>
          </span>
        <% end %>
      </div>
      <%= form_with url: world_art_batches_path(world), class: "book-form" do |f| %>
        <%= hidden_field_tag :entry_type, "portrait", id: nil %>
        <%= hidden_field_tag :owner_type, owner.model_name.singular, id: nil %>
        <%= hidden_field_tag :owner_id, owner.id, id: nil %>
        <%= hidden_field_tag :from, "neutral", id: nil %>
        <%= hidden_field_tag :draft, "0", id: nil %>
        <div class="inline-form">
          <div class="field">
            <%= label_tag :chain_expression, "Expression" %>
            <%= select_tag :expression, options_for_select((Portrait::EXPRESSIONS - [ "neutral" ]).map { |e| [ e.humanize, e ] }, chosen == "neutral" ? "happy" : chosen), id: "chain_expression" %>
          </div>
          <div class="field"><%= label_tag :expression_count, "Candidates" %><%= number_field_tag :count, 2, min: 1, max: 8, id: "expression_count" %></div>
          <%= submit_tag "Draw this expression", class: "button", disabled: !reachable || !neutral_done,
                         title: (!reachable ? "ComfyUI isn't answering" : (neutral_done ? nil : "Make the Neutral portrait first")) %>
          <%= submit_tag "Draw every expression", class: "button button--quiet", name: "every", value: "1", disabled: !reachable || !neutral_done,
                         title: (!reachable ? "ComfyUI isn't answering" : (neutral_done ? nil : "Make the Neutral portrait first")) %>
        </div>
        <p class="hint">Each is the Neutral portrait redrawn with the expression's words and its seed, so the face holds. "Every expression" queues all six at once; pick each from its strip below.</p>
      <% end %>
    </li>
  </ol>

  <details class="art-chain__plain">
    <summary>From the prompt alone</summary>
    <p class="hint">Any portrait, with nothing to start from: the layers below, and the expression's words after them.</p>
    <%= render "art_batches/layers", art: sample %>
    <%= form_with url: world_art_batches_path(world), class: "book-form" do |f| %>
      <%= hidden_field_tag :entry_type, "portrait", id: nil %>
      <%= hidden_field_tag :owner_type, owner.model_name.singular, id: nil %>
      <%= hidden_field_tag :owner_id, owner.id, id: nil %>
      <%= render "art_batches/background_field", art: sample %>
      <div class="inline-form">
        <div class="field">
          <%= label_tag :plain_expression, "Expression" %>
          <%= select_tag :expression, options_for_select(Portrait::EXPRESSIONS.map { |e| [ e.humanize, e ] }, chosen), id: "plain_expression" %>
        </div>
        <div class="field"><%= label_tag :count, "Candidates" %><%= number_field_tag :count, Comfy.config[:candidates], min: 1, max: 8 %></div>
        <%= submit_tag "Generate", class: "button", **disabled %>
      </div>
    <% end %>
  </details>

  <% batches.each do |batch| %>
    <%= render "art_batches/strip", batch: batch %>
    <%= render "art_batches/strip", batch: batch.drafts if batch.drafts %>
  <% end %>
</details>
<% end %>
