<%# Generating a speaker's portraits (§8), below their edit form (uploads live in the form).
    owner: an Npc or Character. Each expression is one more layer after the speaker. %>
<% world = owner.art_world %>
<% batch = ArtBatch.where(entry: owner.portraits).or(ArtBatch.where(entry: owner.sprite)).order(:id).last %>
<% chosen = batch&.entry.is_a?(Portrait) ? batch.entry.expression : "neutral" %>
<% sample = owner.portraits.find_by(expression: chosen) || Portrait.new(owner: owner, expression: chosen) %>
<% figure = owner.sprite || Sprite.new(owner: owner) %>
<% neutral_seed = owner.portraits.find_by(expression: "neutral")&.image_seed %>
<%= turbo_frame_tag "art_panel", data: { src: world_art_panel_path(world, entry_type: "portrait", owner_type: owner.model_name.singular, owner_id: owner.id) } do %>
<%# Closed until there's something to look at (a batch running, or candidates to pick from). %>
<details class="window art-studio" id="art" <%= "open" if batch %>>
  <summary>Generate portraits<%= tag.span(" · ComfyUI isn't answering", class: "art-studio__status") unless Comfy.capabilities.reachable? %></summary>
  <p class="hint">Each expression is its own image: upload it in the form above, or generate it here.</p>

  <h3>The prompt, in layers</h3>
  <%= render "art_batches/layers", art: sample %>

  <%= form_with url: world_art_batches_path(world), class: "book-form" do |f| %>
    <%= hidden_field_tag :entry_type, "portrait" %>
    <%= hidden_field_tag :owner_type, owner.model_name.singular %>
    <%= hidden_field_tag :owner_id, owner.id %>
    <%= render "art_batches/subject_fields", subject: owner %>
    <%= render "art_batches/background_field", art: sample %>
    <div class="inline-form">
      <div class="field">
        <%= label_tag :expression %>
        <%= select_tag :expression, options_for_select(Portrait::EXPRESSIONS.map { |e| [ e.humanize, e ] }, chosen) %>
      </div>
      <div class="field"><%= label_tag :count, "Candidates" %><%= number_field_tag :count, Comfy.config[:candidates], min: 1, max: 8 %></div>
      <%= submit_tag "Generate", class: "button", disabled: !Comfy.capabilities.reachable?, title: ("ComfyUI isn't answering" unless Comfy.capabilities.reachable?) %>
    </div>
    <p class="hint">
      <% if neutral_seed %>
        For other expressions the first candidate reuses the Neutral portrait's seed (<%= neutral_seed %>), so the face stays closer.
      <% else %>
        Generate Neutral first: other expressions start from its seed, so the face stays closer.
      <% end %>
    </p>
  <% end %>

  <h3>The sprite: full body, for the stage</h3>
  <p class="hint">
    The same speaker, standing, with the background taken off, to stand in a scene's beat.
    <% if neutral_seed %>The first candidate starts from the Neutral portrait's seed (<%= neutral_seed %>), so it's the same face.<% else %>Generate Neutral first: the sprite starts from its seed, so it's the same face.<% end %>
  </p>
  <%= render "art_batches/layers", art: figure %>
  <%= form_with url: world_art_batches_path(world), class: "book-form" do |f| %>
    <%= hidden_field_tag :entry_type, "sprite", id: nil %>
    <%= hidden_field_tag :owner_type, owner.model_name.singular, id: nil %>
    <%= hidden_field_tag :owner_id, owner.id, id: nil %>
    <%= hidden_field_tag :draft, "0", id: nil %>
    <%= hidden_field_tag :transparent, "1", id: nil %>
    <div class="inline-form">
      <div class="field"><%= label_tag :sprite_count, "Candidates" %><%= number_field_tag :count, Comfy.config[:candidates], min: 1, max: 8, id: "sprite_count" %></div>
      <%= submit_tag "Generate the sprite", class: "button", disabled: !Comfy.capabilities.reachable?, title: ("ComfyUI isn't answering" unless Comfy.capabilities.reachable?) %>
    </div>
  <% end %>

  <%= render "art_batches/strip", batch: batch if batch %>
  <%= render "art_batches/strip", batch: batch.drafts if batch&.drafts %>
</details>
<% end %>
