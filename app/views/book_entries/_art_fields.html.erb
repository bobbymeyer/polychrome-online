<%# Image slot and variant recipe (§3.3). Generation (§8) happens on the entry's page. %>
<fieldset class="panel">
  <legend>Art</legend>
  <div class="art-fields">
    <%= entry_portrait(f.object, size: :small) %>
    <div>
      <div class="field">
        <%= f.label :image %>
        <%= f.file_field :image, accept: "image/*" %>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="<%= f.object_name %>_variant_hue">Hue shift (°)</label>
          <%= number_field_tag json_field_name(f, :variant, :hue), f.object.variant["hue"], id: "#{f.object_name}_variant_hue", min: -180, max: 180 %>
        </div>
        <div class="field">
          <label for="<%= f.object_name %>_variant_scale">Scale (%)</label>
          <%= number_field_tag json_field_name(f, :variant, :scale), f.object.variant["scale"], id: "#{f.object_name}_variant_scale", min: 25, max: 400, placeholder: 100 %>
        </div>
        <div class="field field--check">
          <%= hidden_field_tag json_field_name(f, :variant, :flip), "0", id: nil %>
          <%= check_box_tag json_field_name(f, :variant, :flip), "1", f.object.variant["flip"], id: "#{f.object_name}_variant_flip" %>
          <label for="<%= f.object_name %>_variant_flip">Flip</label>
        </div>
      </div>
    </div>
  </div>
  <% if f.object.respond_to?(:art_recipe) && f.object.persisted? %>
    <p class="hint">Uploading an image replaces a generated one. To generate one with ComfyUI, use the Art section on this entry's page.</p>
  <% end %>
</fieldset>
