<%# Image slot and variant recipe (§3.3), plus the generation columns (§8). %>
<fieldset class="panel">
  <legend>Art</legend>
  <div class="art-fields">
    <%= entry_portrait(f.object, size: :small) %>
    <div>
      <div class="field">
        <%= f.label :image %>
        <%= f.file_field :image, accept: "image/*" %>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="<%= f.object_name %>_variant_hue">Hue shift (°)</label>
          <%= number_field_tag jsonb_field_name(f, :variant, :hue), f.object.variant["hue"], id: "#{f.object_name}_variant_hue", min: -180, max: 180 %>
        </div>
        <div class="field">
          <label for="<%= f.object_name %>_variant_scale">Scale (%)</label>
          <%= number_field_tag jsonb_field_name(f, :variant, :scale), f.object.variant["scale"], id: "#{f.object_name}_variant_scale", min: 25, max: 400, placeholder: 100 %>
        </div>
        <div class="field field--check">
          <%= hidden_field_tag jsonb_field_name(f, :variant, :flip), "0", id: nil %>
          <%= check_box_tag jsonb_field_name(f, :variant, :flip), "1", f.object.variant["flip"], id: "#{f.object_name}_variant_flip" %>
          <label for="<%= f.object_name %>_variant_flip">Flip</label>
        </div>
      </div>
    </div>
  </div>
  <details>
    <summary>Generation record</summary>
    <div class="field-row">
      <div class="field">
        <%= f.label :image_seed %>
        <%= f.number_field :image_seed %>
      </div>
      <div class="field field--wide">
        <%= f.label :image_prompt %>
        <%= f.text_area :image_prompt, rows: 2 %>
      </div>
    </div>
  </details>
</fieldset>
