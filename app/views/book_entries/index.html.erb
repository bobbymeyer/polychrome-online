<% content_for :title, book_title %>
<div class="book-header">
  <h1><%= book_title %></h1>
  <%= link_to "New #{entry_class.model_name.human.downcase}", polymorphic_path([:new, @world, book_key, entry_class.model_name.singular.to_sym]), class: "button" if can_edit_world? %>
  <%= link_to "New family", new_world_grimoire_family_path(@world), class: "button button--quiet" if book_key == :grimoire && can_edit_world? %>
  <%= link_to "What rows can ask about", world_generation_facts_path(@world), class: "button button--quiet" if book_key == :generation %>
  <%= link_to "Type chart", world_types_path(@world), class: "button button--quiet" if %i[bestiary grimoire].include?(book_key) && types_matter? %>
</div>
<% if @entries.empty? %>
  <% book = World::Books::LIST.find { |candidate| candidate.key == book_key } %>
  <section class="window empty-book">
    <p class="empty">The <%= book_title %> is empty.</p>
    <p><%= book.blurb %></p>
    <% if can_edit_world? %>
      <%= link_to "Add the first #{entry_class.model_name.human.downcase}", polymorphic_path([:new, @world, book_key, entry_class.model_name.singular.to_sym]), class: "button" %>
      <p class="hint">Or <%= link_to "copy another world", new_world_path, class: "muted" %> to start from its books.</p>
    <% end %>
  </section>
<% else %>
  <%= render "table", entries: @entries %>
<% end %>
