<% content_for :title, "Edit #{@entry.name} · #{book_title}" %>
<div class="crumbs"><%= link_to book_title, entries_path %> / <%= link_to @entry.name_in_database || @entry.name, entry_path(@entry) %> / Edit</div>
<h1>Edit <%= @entry.name_in_database || @entry.name %></h1>
<%= render "book_entries/live_warning", world: @world %>
<%= render layout: "book_entries/draft", locals: { key: "edit:#{@world.slug}:#{book_key}:#{@entry.slug}" } do %><%= render "form", entry: @entry %><% end %>
