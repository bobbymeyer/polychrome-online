<%= form_with model: entry, url: entry.persisted? ? entry_path(entry) : entries_path, class: "book-form" do |f| %>
  <%= render "book_entries/errors", entry: entry %>
  <%= render "book_entries/identity_fields", f: f %>
  <div class="field-row">
    <div class="field">
      <%= f.label :category %>
      <%= f.select :category, Item::CATEGORIES.map { |category, slot| [slot ? "#{term(category)} (#{term(slot)})" : term(category), category] } %>
    </div>
    <div class="field">
      <%= f.label :price %>
      <%= f.number_field :price, min: 0 %>
    </div>
  </div>

  <fieldset class="panel">
    <legend>Equipment bonuses</legend>
    <p class="hint">Flat additions for equipment. Leave blank for consumables.</p>
    <div class="stat-inputs">
      <% Stats::NAMES.each do |stat| %>
        <div class="field">
          <label for="item_stats_<%= stat %>"><%= stat_label(stat) %></label>
          <%= number_field_tag json_field_name(f, :stats, stat), entry.stats[stat], id: "item_stats_#{stat}" %>
        </div>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="panel">
    <legend>A mask (category Mask)</legend>
    <p class="hint">Rare treasure: whoever wears one can put it on in battle and transform for a few turns, stronger, striking with its type, with its moves on their menu; then they're spent for a while. It won't have a coward.</p>
    <div class="field-row">
      <div class="field">
        <label for="item_mask_type">Type</label>
        <%= select_tag json_field_name(f, :mask, :type), options_for_select(type_options, entry.mask["type"]), include_blank: "(none)", id: "item_mask_type" %>
      </div>
      <div class="field">
        <label for="item_mask_duration">Turns</label>
        <%= number_field_tag json_field_name(f, :mask, :duration), entry.mask["duration"], min: 1, max: Battle::Masks::MAX_DURATION,
                             placeholder: Battle::Masks::DEFAULT_DURATION, id: "item_mask_duration" %>
      </div>
      <div class="field">
        <label for="item_mask_abilities">Its moves</label>
        <%= hidden_field_tag "#{json_field_name(f, :mask, :abilities)}[]", "", id: nil %>
        <%= select_tag "#{json_field_name(f, :mask, :abilities)}[]", options_for_select(@world.abilities.in_battle.order(:name).map { |a| [ a.name, a.slug ] }, entry.mask["abilities"]),
                       multiple: true, size: 5, id: "item_mask_abilities" %>
      </div>
    </div>
  </fieldset>

  <fieldset class="panel">
    <legend>When used (consumables)</legend>
    <div class="field">
      <%= f.label :target %>
      <%= f.select :target, Battle::TARGETINGS.map { |t| [term(t), t] }, include_blank: "—" %>
    </div>
  </fieldset>
  <%= render "book_entries/effect_rows", f: f %>
  <%= render "book_entries/art_fields", f: f %>
  <div class="actions">
    <%= f.submit class: "button" %>
    <%= link_to "Cancel", entry.persisted? ? entry_path(entry) : entries_path, class: "button button--quiet" %>
  </div>
<% end %>
